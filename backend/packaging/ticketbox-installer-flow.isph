function ServiceExists(ServiceName: String): Boolean;
begin
  Result := TicketboxServiceExistsNative(ServiceName);
end;

procedure LoadExistingConfig();
begin
  ExistingDataRoot := '';
  ExistingPgPort := '';
  ExistingBackendPort := '';

  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'DataRoot', ExistingDataRoot);
  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'PgPort', ExistingPgPort);
  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'BackendPort', ExistingBackendPort);

  ExistingInstall :=
    (ExistingDataRoot <> '') or
    ServiceExists('{#PgServiceName}') or
    ServiceExists('{#BackendServiceName}');
end;

function IsPortListening(Port: String): Boolean;
var
  ResultCode: Integer;
  Params: String;
begin
  Params := '-NoProfile -ExecutionPolicy Bypass -Command ' +
    Quote('try { if (Get-NetTCPConnection -State Listen -LocalPort ' + Port +
      ' -ErrorAction Stop) { exit 1 }; exit 0 } catch { ' +
      'if ($_.FullyQualifiedErrorId -eq ''CmdletizationQuery_NotFound,Get-NetTCPConnection'') ' +
      '{ exit 0 }; exit 2 }');
  if not Exec(PowerShellExecutable(), Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    PortProbeFailed := True;
    Result := True;
    exit;
  end;
  if ResultCode = 0 then
  begin
    Result := False;
  end
  else if ResultCode = 1 then
  begin
    Result := True;
  end
  else
  begin
    PortProbeFailed := True;
    Result := True;
  end;
end;

function IsValidPort(Port: String): Boolean;
var
  PortNumber: Integer;
begin
  PortNumber := StrToIntDef(Trim(Port), -1);
  Result := (PortNumber >= 1) and (PortNumber <= 65535);
end;

function SelectInitialDataRoot(): String;
var
  ParamValue: String;
begin
  ParamValue := ExpandConstant('{param:TicketboxDataRoot|}');
  if ExistingDataRoot <> '' then
  begin
    Result := ExistingDataRoot;
  end
  else if ParamValue <> '' then
  begin
    Result := ParamValue;
  end
  else
  begin
    Result := ExpandConstant('{commonappdata}\Ticketbox');
  end;
end;

function PortParameter(ParamName: String): String;
begin
  Result := Trim(ExpandConstant('{param:' + ParamName + '|}'));
end;

function AdvancedSettingsRequested(): Boolean;
begin
  Result :=
    (CompareText(Trim(ExpandConstant('{param:TicketboxAdvancedPorts|0}')), '1') = 0) or
    (Trim(ExpandConstant('{param:TicketboxDataRoot|}')) <> '') or
    (PortParameter('TicketboxPgPort') <> '') or
    (PortParameter('TicketboxBackendPort') <> '');
end;

function TryAvailablePort(Candidate: String; ExcludedPort: String; var SelectedPort: String): Boolean;
begin
  Result := False;
  if (not IsValidPort(Candidate)) or (Candidate = ExcludedPort) then
  begin
    exit;
  end;
  if IsPortListening(Candidate) then
  begin
    exit;
  end;
  SelectedPort := Candidate;
  Result := True;
end;

function FindAutomaticPort(
  DefaultValue: String;
  FallbackValue: String;
  ExcludedPort: String;
  var SelectedPort: String
): Boolean;
var
  Offset: Integer;
  CandidateNumber: Integer;
begin
  Result := TryAvailablePort(DefaultValue, ExcludedPort, SelectedPort);
  if Result or PortProbeFailed then
  begin
    exit;
  end;
  Result := TryAvailablePort(FallbackValue, ExcludedPort, SelectedPort);
  if Result or PortProbeFailed then
  begin
    exit;
  end;
  CandidateNumber := StrToIntDef(FallbackValue, -1);
  for Offset := 1 to 32 do
  begin
    if CandidateNumber + Offset <= 65535 then
    begin
      Result := TryAvailablePort(
        IntToStr(CandidateNumber + Offset),
        ExcludedPort,
        SelectedPort);
      if Result or PortProbeFailed then
      begin
        exit;
      end;
    end;
  end;
end;

procedure ResolveInstallationPorts();
var
  PgParameter: String;
  BackendParameter: String;
begin
  AutomaticPortSelectionError := '';
  PortProbeFailed := False;
  PgParameter := PortParameter('TicketboxPgPort');
  BackendParameter := PortParameter('TicketboxBackendPort');

  if ExistingInstall then
  begin
    ResolvedPgPort := ExistingPgPort;
    ResolvedBackendPort := ExistingBackendPort;
    if ResolvedPgPort = '' then
    begin
      ResolvedPgPort := '{#DefaultPgPort}';
    end;
    if ResolvedBackendPort = '' then
    begin
      ResolvedBackendPort := '{#DefaultBackendPort}';
    end;
    exit;
  end;

  if PgParameter <> '' then
  begin
    ResolvedPgPort := PgParameter;
  end
  else if not FindAutomaticPort(
    '{#DefaultPgPort}', '{#FallbackPgPort}', '', ResolvedPgPort) then
  begin
    AutomaticPortSelectionError := '无法自动选择可用的 PostgreSQL 服务端口。';
    exit;
  end;

  if BackendParameter <> '' then
  begin
    ResolvedBackendPort := BackendParameter;
  end
  else if not FindAutomaticPort(
    '{#DefaultBackendPort}', '{#FallbackBackendPort}', ResolvedPgPort, ResolvedBackendPort) then
  begin
    AutomaticPortSelectionError := '无法自动选择可用的后端服务端口。';
    exit;
  end;

  if PortProbeFailed then
  begin
    AutomaticPortSelectionError := '无法可靠检查本机服务端口。安装器尚未复制任何程序文件。';
  end;
end;

function AdvancedInstallSettingsEnabled(): Boolean;
begin
  Result :=
    (not ExistingInstall) and
    (AdvancedPortSettings <> nil) and
    AdvancedPortSettings.Checked;
end;

function SelectedDataRoot(): String;
begin
  if ExistingInstall and (ExistingDataRoot <> '') then
  begin
    Result := ExistingDataRoot;
  end
  else if (DataRootPage <> nil) and AdvancedInstallSettingsEnabled() then
  begin
    Result := Trim(DataRootPage.Values[0]);
  end
  else
  begin
    Result := SelectInitialDataRoot();
  end;
end;

function ExistingDataRootParameterError(): String;
var
  ParameterValue: String;
begin
  Result := '';
  ParameterValue := Trim(ExpandConstant('{param:TicketboxDataRoot|}'));
  if ExistingInstall and (ExistingDataRoot <> '') and
     (ParameterValue <> '') and
     (CanonicalVersionGateInstallPath(ParameterValue) <>
      CanonicalVersionGateInstallPath(ExistingDataRoot)) then
  begin
    Result :=
      '升级安装不支持通过命令行迁移数据目录。' +
      '请移除 /TicketboxDataRoot 参数并保持已安装数据目录：' + ExistingDataRoot;
  end;
end;

function SelectedPgPort(): String;
begin
  if (PortPage <> nil) and AdvancedInstallSettingsEnabled() then
  begin
    Result := Trim(PortPage.Values[0]);
  end
  else
  begin
    Result := ResolvedPgPort;
  end;
end;

function SelectedBackendPort(): String;
begin
  if (PortPage <> nil) and AdvancedInstallSettingsEnabled() then
  begin
    Result := Trim(PortPage.Values[1]);
  end
  else
  begin
    Result := ResolvedBackendPort;
  end;
end;

function GetDataRoot(Param: String): String;
begin
  Result := SelectedDataRoot();
end;

function GetPgPort(Param: String): String;
begin
  Result := SelectedPgPort();
end;

function GetBackendPort(Param: String): String;
begin
  Result := SelectedBackendPort();
end;

function FreshInstall(): Boolean;
begin
  Result := (not ExistingInstall) and (not DirExists(SelectedDataRoot() + '\pgdata'));
end;

function PortConflictMessage(): String;
var
  PgPort: String;
  BackendPort: String;
  BusyPorts: String;
begin
  Result := '';
  PortProbeFailed := False;
  PgPort := SelectedPgPort();
  BackendPort := SelectedBackendPort();
  BusyPorts := '';

  if IsPortListening(PgPort) then
  begin
    BusyPorts := 'PostgreSQL 服务端口 ' + PgPort;
  end;
  if IsPortListening(BackendPort) then
  begin
    if BusyPorts <> '' then
    begin
      BusyPorts := BusyPorts + '、';
    end;
    BusyPorts := BusyPorts + '后端 API 端口 ' + BackendPort;
  end;

  if PortProbeFailed then
  begin
    Result := '无法可靠检查所选端口。安装器已停止，未复制任何程序文件。请检查 PowerShell 后重试。';
  end
  else if BusyPorts <> '' then
  begin
    Result :=
      '所选端口已被占用：' + BusyPorts + '。' + #13#10 + #13#10 +
      '请关闭占用这些端口的程序后重试；需要固定端口时，可返回并打开高级设置。';
  end;
end;

function FreshInstallPortError(): String;
begin
  Result := '';
  if FreshInstall() then
  begin
    if not AdvancedInstallSettingsEnabled() then
    begin
      ResolveInstallationPorts();
      if PortPage <> nil then
      begin
        PortPage.Values[0] := ResolvedPgPort;
        PortPage.Values[1] := ResolvedBackendPort;
      end;
    end;
    if AutomaticPortSelectionError <> '' then
    begin
      Result := AutomaticPortSelectionError;
      exit;
    end;
    Result := PortConflictMessage();
  end;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (not AdvancedInstallSettingsEnabled()) and
    (((DataRootPage <> nil) and (PageID = DataRootPage.ID)) or
     ((PortPage <> nil) and (PageID = PortPage.ID)));
end;

procedure SetInstallerStage(MessageText: String; DetailText: String);
begin
  WizardForm.StatusLabel.Caption := MessageText;
  WizardForm.FilenameLabel.Caption := DetailText;
end;

procedure RecordInstallationFailure(MessageText: String);
begin
  LifecycleInstallFailed := True;
  if Trim(MessageText) = '' then
  begin
    LifecycleFailureMessage :=
      '小票夹安装交付未完成，未取得可验证的失败摘要。';
  end
  else
  begin
    LifecycleFailureMessage := MessageText;
  end;
  Log('Ticketbox installation outcome marked as failed: ' +
    LifecycleFailureMessage);
  SetInstallerStage(
    '安装未完成',
    '正在保留恢复事实；请在结束页仅按当前故障的安全指引处理。');
end;

procedure InitializeWizard();
begin
  LoadExistingConfig();
  ResolveInstallationPorts();

  DataRootPage := CreateInputDirPage(
    wpWelcome,
    '高级设置：小票夹数据目录',
    '数据库、上传图片、日志和备份会保存到这里。',
    '仅在需要使用其他本地磁盘时更改；普通安装不会显示本页。',
    False,
    ''
  );
  DataRootPage.Add('数据目录');
  DataRootPage.Values[0] := SelectInitialDataRoot();

  AdvancedPortSettings := TNewCheckBox.Create(WizardForm.WelcomePage);
  AdvancedPortSettings.Parent := WizardForm.WelcomePage;
  AdvancedPortSettings.Left := ScaleX(24);
  AdvancedPortSettings.Top := WizardForm.WelcomePage.ClientHeight - ScaleY(52);
  AdvancedPortSettings.Width := WizardForm.WelcomePage.ClientWidth - ScaleX(48);
  AdvancedPortSettings.Caption := '高级设置：自定义数据目录和服务端口';
  AdvancedPortSettings.Checked := AdvancedSettingsRequested();
  AdvancedPortSettings.Enabled := not ExistingInstall;

  PortPage := CreateInputQueryPage(
    DataRootPage.ID,
    '配置本机服务端口',
    '小票夹会安装 PostgreSQL 服务和后端 API 服务。',
    '安装器已自动选择可用端口。只有需要固定端口的高级用户才应修改。'
  );
  PortPage.Add('PostgreSQL 服务端口', False);
  PortPage.Add('后端 API 端口', False);
  PortPage.Values[0] := ResolvedPgPort;
  PortPage.Values[1] := ResolvedBackendPort;

  OwnerHandoffMemo := TNewMemo.Create(WizardForm.FinishedPage);
  OwnerHandoffMemo.Parent := WizardForm.FinishedPage;
  OwnerHandoffMemo.Left := 0;
  OwnerHandoffMemo.Top := WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(12);
  OwnerHandoffMemo.Width := WizardForm.FinishedPage.ClientWidth;
  OwnerHandoffMemo.ReadOnly := True;
  OwnerHandoffMemo.ScrollBars := ssVertical;
  OwnerHandoffMemo.Visible := False;

  InstallationFailureMemo := TNewMemo.Create(WizardForm.FinishedPage);
  InstallationFailureMemo.Parent := WizardForm.FinishedPage;
  InstallationFailureMemo.Left := 0;
  InstallationFailureMemo.Top :=
    WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(12);
  InstallationFailureMemo.Width := WizardForm.FinishedPage.ClientWidth;
  InstallationFailureMemo.Height :=
    WizardForm.FinishedPage.ClientHeight - InstallationFailureMemo.Top - ScaleY(12);
  InstallationFailureMemo.ReadOnly := True;
  InstallationFailureMemo.ScrollBars := ssVertical;
  InstallationFailureMemo.Visible := False;

  LaunchManagerAfterFinish := TNewCheckBox.Create(WizardForm.FinishedPage);
  LaunchManagerAfterFinish.Parent := WizardForm.FinishedPage;
  LaunchManagerAfterFinish.Left := 0;
  LaunchManagerAfterFinish.Width := WizardForm.FinishedPage.ClientWidth;
  LaunchManagerAfterFinish.Height := ScaleY(24);
  LaunchManagerAfterFinish.Top :=
    WizardForm.FinishedPage.ClientHeight - LaunchManagerAfterFinish.Height;
  LaunchManagerAfterFinish.Caption := '完成后打开小票夹管理器（推荐）';
  LaunchManagerAfterFinish.Checked := True;
  LaunchManagerAfterFinish.Visible := False;
  OwnerHandoffMemo.Height :=
    LaunchManagerAfterFinish.Top - OwnerHandoffMemo.Top - ScaleY(8);
  ManagerLaunchAttempted := False;
end;

function LoadUtf8TextFile(FileName: String; MaximumLength: Integer; var Text: String): Boolean;
var
  Lines: TArrayOfString;
  Index: Integer;
begin
  Result := False;
  Text := '';
  if not LoadStringsFromFile(FileName, Lines) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(Lines) - 1 do
  begin
    if Index > 0 then
    begin
      Text := Text + #13#10;
    end;
    Text := Text + Lines[Index];
    if Length(Text) > MaximumLength then
    begin
      Text := '';
      exit;
    end;
  end;
  Result := Length(Text) > 0;
end;

function IsEightDigitPairingCode(const Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 8;
  if not Result then
  begin
    exit;
  end;
  for Index := 1 to Length(Value) do
  begin
    if (Value[Index] < '0') or (Value[Index] > '9') then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function LoadCurrentOwnerHandoffDisplay(var DisplayText: String): Boolean;
var
  HandoffPath: String;
  Lines: TArrayOfString;
  ClaimGeneration: Integer;
  PairingDerivationIndex: Integer;
  PairingCode: String;
  PairingExpiresAt: String;
begin
  Result := False;
  DisplayText := '';
  HandoffPath := LifecycleInstallerStatePath(
    'installation-owner-handoff-v2.txt');
  if not FileExists(HandoffPath) then
  begin
    exit;
  end;
  if not LoadStringsFromFile(HandoffPath, Lines) then
  begin
    exit;
  end;
  if (GetArrayLength(Lines) <> 11) or
     (Lines[0] <> 'SCHEMA=ticketbox-installation-owner-handoff-v2') or
     (Lines[1] <> 'STATE=pending') or
     (Lines[2] <> 'CONTRACT=ticketbox-installation-owner-pairing-v1') or
     (Pos('OPERATION_ID=', Lines[3]) <> 1) or
     (Length(Lines[3]) <= Length('OPERATION_ID=')) or
     (Pos('INSTALLATION_ID=', Lines[4]) <> 1) or
     (Length(Lines[4]) <= Length('INSTALLATION_ID=')) or
     (Pos('CLAIM_GENERATION=', Lines[5]) <> 1) or
     (Pos('PAIRING_DERIVATION_INDEX=', Lines[6]) <> 1) or
     (Pos('PAIRING_CODE=', Lines[7]) <> 1) or
     (Pos('PAIRING_EXPIRES_AT=', Lines[8]) <> 1) or
     (Lines[9] <>
       'INSTALLER_OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId)) or
     (Pos('INSTALLER_OWNER_STARTED_UTC=', Lines[10]) <> 1) or
     (Length(Lines[10]) <= Length('INSTALLER_OWNER_STARTED_UTC=')) then
  begin
    exit;
  end;
  ClaimGeneration := StrToIntDef(
    Copy(Lines[5], Length('CLAIM_GENERATION=') + 1, MaxInt), 0);
  PairingDerivationIndex := StrToIntDef(
    Copy(Lines[6], Length('PAIRING_DERIVATION_INDEX=') + 1, MaxInt), -1);
  PairingCode := Copy(
    Lines[7], Length('PAIRING_CODE=') + 1, MaxInt);
  PairingExpiresAt := Copy(
    Lines[8], Length('PAIRING_EXPIRES_AT=') + 1, MaxInt);
  if (ClaimGeneration < 1) or
     (PairingDerivationIndex < 0) or
     (PairingDerivationIndex > 63) or
     (not IsEightDigitPairingCode(PairingCode)) or
     (PairingExpiresAt = '') or
     (Length(PairingExpiresAt) > 64) then
  begin
    exit;
  end;
  DisplayText :=
    '小票夹首次连接' + #13#10 +
    '绑定此电脑码：' + PairingCode + #13#10 +
    '有效期至：' + PairingExpiresAt + #13#10 +
    '完成安装后，在小票夹管理器中输入这枚 8 位短期码。' + #13#10 +
    '若代码过期或窗口已关闭，请从开始菜单打开“小票夹连接与恢复”生成新码。';
  Result := True;
end;

function HasCurrentOwnerHandoffPendingArtifact(): Boolean;
var
  HandoffPath: String;
  DisplayText: String;
begin
  HandoffPath := LifecycleInstallerStatePath(
    'installation-owner-handoff-v2.txt');
  if not FileExists(HandoffPath) then
  begin
    Result := False;
    exit;
  end;
  if not LoadCurrentOwnerHandoffDisplay(DisplayText) then
  begin
    RaiseException(
      'installation owner pairing handoff 记录存在但格式或 owner 绑定无效。');
  end;
  Result := True;
end;

procedure ShowInstallationFailurePage();
begin
  WizardForm.FinishedHeadingLabel.Caption := '小票夹安装未完成';
  WizardForm.FinishedLabel.Caption :=
    '本次安装交付未完整通过验证，因此不会打开管理器。数据不会被自动删除。';
  InstallationFailureMemo.Text :=
    LifecycleFailureMessage + #13#10#13#10 +
    '请仅按上述故障说明操作；无法确认状态时，请保持服务停止并联系支持。';
  InstallationFailureMemo.Visible := True;
  WizardForm.NextButton.Caption := '关闭';
  WizardForm.NextButton.Enabled := True;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  HandoffText: String;
begin
  if CurPageID <> wpFinished then
  begin
    exit;
  end;
  OwnerHandoffMemo.Visible := False;
  OwnerHandoffMemo.Text := '';
  LaunchManagerAfterFinish.Visible := False;
  InstallationFailureMemo.Visible := False;
  InstallationFailureMemo.Text := '';
  WizardForm.NextButton.Enabled := True;
  if not LifecycleInstallCompleted then
  begin
    if not LifecycleInstallFailed then
    begin
      RecordInstallationFailure(
        '安装器未取得完整的服务与生命周期提交结果。');
    end;
    ShowInstallationFailurePage();
    exit;
  end;
  WizardForm.FinishedHeadingLabel.Caption := '小票夹已安装';
  if not OwnerHandoffExpected then
  begin
    LaunchManagerAfterFinish.Visible := True;
    WizardForm.FinishedLabel.Caption :=
      '小票夹安装维护已完成。保持下方勾选并点击“完成”将打开管理器；取消勾选则只结束安装。';
    exit;
  end;

  if not LoadCurrentOwnerHandoffDisplay(HandoffText) then
  begin
    RecordInstallationFailure(
      '小票夹程序和服务已安装，但首次绑定信息不可读。一次性信息仍受保护且未删除。');
    ShowInstallationFailurePage();
    exit;
  end;
  WizardForm.FinishedLabel.Caption :=
    '小票夹已安装。请记下下方 8 位短期配对码，再点击“完成”打开管理器。安装器不会创建、复制或保存用户长期凭据；代码过期后可从开始菜单打开“小票夹连接与恢复”重新生成。';
  OwnerHandoffMemo.Text := HandoffText;
  OwnerHandoffMemo.Visible := True;
  LaunchManagerAfterFinish.Visible := True;
  WizardForm.NextButton.Enabled := True;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  HandoffPath: String;
  Args: String;
  MessageText: String;
  VersionFailureReason: String;
  ManagerResultCode: Integer;
begin
  Result := True;

  if (CurPageID = wpFinished) and OwnerHandoffExpected and
     LifecycleInstallCompleted then
  begin
    if not OwnerHandoffMemo.Visible then
    begin
      MsgBox(
        '首次绑定信息不可读，当前不能完成交付或打开管理器。请关闭向导并运行修复安装。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -TargetBackendVersion {#AppVersion}' +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -CompleteOwnerHandoffOnly';
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\install_bundled_services.ps1'),
      Args,
      'Ticketbox owner bootstrap handoff completion') then
    begin
      if not LastPowerShellChildSucceeded then
      begin
        if LastPowerShellFailureMessage <> '' then
        begin
          MsgBox(LastPowerShellFailureMessage, mbError, MB_OK);
        end;
        Result := False;
        exit;
      end;
    end;
    HandoffPath := LifecycleInstallerStatePath(
      'installation-owner-handoff-v2.txt');
    if FileExists(HandoffPath) then
    begin
      MsgBox(
        '首次绑定信息清理后仍有敏感文件残留，拒绝完成安装。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    OwnerHandoffMemo.Text := '';
  end;

  if (CurPageID = wpFinished) and LifecycleInstallCompleted then
  begin
    if not ReleaseManagerMaintenanceGate() then
    begin
      MsgBox(
        '安装已完成，但无法安全释放管理器维护门。请关闭安装器后从开始菜单打开小票夹管理器。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    ReleaseDataRootMutationGuard();
    ReleaseLifecycleLock();
    CloseInstallerSourceLease();
    if LaunchManagerAfterFinish.Checked and (not ManagerLaunchAttempted) then
    begin
      ManagerLaunchAttempted := True;
      if not ExecAsOriginalUser(
        ExpandConstant('{app}\manager\ticketbox-manager.exe'),
        '',
        ExpandConstant('{app}\manager'),
        SW_SHOWNORMAL,
        ewNoWait,
        ManagerResultCode) then
      begin
        MsgBox(
          '小票夹已安装，但未能自动打开管理器。请从 Windows 开始菜单打开“小票夹管理器”。',
          mbInformation,
          MB_OK);
      end;
    end;
  end;

  if CurPageID = DataRootPage.ID then
  begin
    if SelectedDataRoot() = '' then
    begin
      MsgBox('请选择数据目录。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not CheckBackendVersionFloorForDataRoot(
      SelectedDataRoot(),
      VersionFailureReason) then
    begin
      MsgBox(VersionFailureReason, mbError, MB_OK);
      Result := False;
      exit;
    end;

    if ExistingInstall and (ExistingDataRoot <> '') and (SelectedDataRoot() <> ExistingDataRoot) then
    begin
      MsgBox('升级安装暂不支持在安装器中迁移数据目录。请保持原数据目录：' + ExistingDataRoot, mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = PortPage.ID then
  begin
    if not IsValidPort(SelectedPgPort()) then
    begin
      MsgBox('PostgreSQL 服务端口必须是 1 到 65535 之间的数字。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsValidPort(SelectedBackendPort()) then
    begin
      MsgBox('后端 API 端口必须是 1 到 65535 之间的数字。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if SelectedPgPort() = SelectedBackendPort() then
    begin
      MsgBox('PostgreSQL 服务端口和后端 API 端口不能相同。', mbError, MB_OK);
      Result := False;
      exit;
    end;

    if ExistingInstall then
    begin
      if (ExistingPgPort <> '') and (SelectedPgPort() <> ExistingPgPort) then
      begin
        MsgBox('升级安装暂不支持在安装器中修改 PostgreSQL 端口。请保持原端口：' + ExistingPgPort, mbError, MB_OK);
        Result := False;
        exit;
      end;
      if (ExistingBackendPort <> '') and (SelectedBackendPort() <> ExistingBackendPort) then
      begin
        MsgBox('升级安装暂不支持在安装器中修改后端 API 端口。请保持原端口：' + ExistingBackendPort, mbError, MB_OK);
        Result := False;
        exit;
      end;
    end;

    if FreshInstall() then
    begin
      MessageText := PortConflictMessage();
      if MessageText <> '' then
      begin
        MsgBox(MessageText, mbError, MB_OK);
        Result := False;
        exit;
      end;
    end;
  end;
end;

function PrepareAuthoritativePayloadReplacement(): String;
var
  Args: String;
begin
  AssertLifecycleLockActive();
  AssertManagerMaintenanceGateActive();
  SetInstallerStage(
    '正在安全检查数据目录…',
    '不会覆盖未完成备份的数据，请勿关闭安装器。');
  if not ValidateLifecycleLockBootstrapFiles() then
  begin
    Result := '受保护 lifecycle bootstrap bundle 在复制前复核失败。';
    exit;
  end;
  if not StartDataRootMutationGuard(
    LifecycleBootstrapFilePath('hold_data_root_mutation_guard.ps1'),
    ExpandConstant('{app}'),
    SelectedDataRoot()) then
  begin
    Result := '无法持续锁定 DataRoot 目录链；安装尚未进入复制前阶段。';
    exit;
  end;
  AssertLifecycleLockActive();
  AssertDataRootMutationGuardActive();
  Args :=
    '-InstallDir ' + Quote(ExpandConstant('{app}')) +
    ' -DataRoot ' + Quote(SelectedDataRoot()) +
    ' -PgPort ' + SelectedPgPort() +
    ' -BackendPort ' + SelectedBackendPort() +
    ' -TargetPgMajor {#TargetPgMajor}' +
    ' -TargetBackendVersion {#AppVersion}' +
    ' -ReleaseConfigPath ' + Quote(LifecycleBootstrapFilePath('windows-release-config.json')) +
    ' -InstalledReleaseConfigPath ' + Quote(ExpandConstant('{app}\installer\windows-release-config.json')) +
    ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId);
  SetInstallerStage(
    '正在备份并准备本机服务…',
    '慢速磁盘或安全软件扫描时可能需要几分钟。');
  if not RunPowerShellChecked(
    LifecycleBootstrapFilePath('prepare_bundled_upgrade.ps1'),
    Args,
    'Ticketbox pre-upgrade backup and service preparation') then
  begin
    if LastPowerShellChildSucceeded then
    begin
      LifecyclePrepared := True;
    end;
    ReleaseDataRootMutationGuard();
    if LastPowerShellFailureMessage <> '' then
    begin
      Result := LastPowerShellFailureMessage;
    end
    else
    begin
      Result :=
        '安装准备未完成，新程序文件尚未复制。为保护已有数据，安装器已停止。' +
        '支持代码：TBX-PREP-UNKNOWN';
    end;
    exit;
  end;
  LifecyclePrepared := True;
  SetInstallerStage(
    '正在安装小票夹程序文件…',
    '服务与数据已进入受保护维护状态。');
  AssertLifecycleLockActive();
  AssertDataRootMutationGuardActive();
  Result := '';
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  VersionFailureReason: String;
  PrerequisiteArguments: String;
begin
  AssertLifecycleLockActive();
  NeedsRestart := False;
  Result := ExistingDataRootParameterError();
  if Result <> '' then
  begin
    exit;
  end;
  OwnerHandoffExpected := False;
  if not CheckBackendVersionFloorForDataRoot(
    SelectedDataRoot(),
    VersionFailureReason) then
  begin
    Result := VersionFailureReason;
    exit;
  end;
  Result := FreshInstallPortError();
  if Result <> '' then
  begin
    exit;
  end;
  if not ValidateLifecycleLockBootstrapFiles() then
  begin
    Result := '受保护 lifecycle bootstrap bundle 在安装前复核失败。';
    exit;
  end;
  SetInstallerStage(
    '正在检查 Windows 运行环境…',
    '已安装的共享运行库满足要求时会直接跳过。');
  PrerequisiteArguments :=
    '-VcRedistPath ' +
      Quote(LifecycleBootstrapFilePath('vc_redist.x64.exe')) +
    ' -RequiredVersion ' + Quote(VisualCppRuntimeVersion) +
    ' -RequiredSha256 ' + Quote(VisualCppRuntimeSha256) +
    ' -InstallerLockOwnerProcessId ' +
      IntToStr(LifecycleLockOwnerProcessId);
  if not RunPowerShellChecked(
    LifecycleBootstrapFilePath('install_windows_prerequisites.ps1'),
    PrerequisiteArguments,
    'Ticketbox Windows prerequisite installation') then
  begin
    NeedsRestart := LastPowerShellRestartRequired;
    if LastPowerShellFailureMessage <> '' then
    begin
      Result := LastPowerShellFailureMessage;
    end
    else
    begin
      Result :=
        'Windows 前置条件未完成；小票夹安装状态尚未变更。' +
        '支持代码：TBX-INSTALL-PREREQ';
    end;
    exit;
  end;
  if not StartManagerMaintenanceGate() then
  begin
    Result :=
      '无法建立小票夹管理器维护门；安装尚未备份、停服或复制文件。请关闭其他安装器后重试。';
    exit;
  end;
  AssertManagerMaintenanceGateActive();
  Result := '';
end;

function AuthoritativePayloadReplacementPrepared(): Boolean;
begin
  Result := LifecyclePrepared;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Args: String;
  PreparationFailure: String;
  VersionFailureReason: String;
  PublicFailurePath: String;
begin
  if CurStep = ssInstall then
  begin
    SetInstallerStage(
      '正在准备安装…',
      '正在验证安装包、服务和数据状态。');
    AssertLifecycleLockActive();
    AssertManagerMaintenanceGateActive();
    PreparationFailure := PrepareAuthoritativePayloadReplacement();
    if PreparationFailure <> '' then
    begin
      LifecycleInstallFailed := True;
      LifecycleFailureMessage := PreparationFailure;
      SuppressibleMsgBox(
        PreparationFailure,
        mbError,
        MB_OK,
        IDOK);
      Abort();
    end;
    if not CheckBackendVersionFloorForDataRoot(
      SelectedDataRoot(),
      VersionFailureReason) then
    begin
      RaiseException(VersionFailureReason);
    end;
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -TargetBackendVersion {#AppVersion}' +
      ' -ReleaseConfigPath ' + Quote(LifecycleBootstrapFilePath('windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -MarkProgramFilesInstalledBackupPending';
    if not RunPowerShellChecked(
      LifecycleBootstrapFilePath('prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox program-files copy boundary') then
    begin
      if LastPowerShellChildSucceeded then
      begin
        LifecycleFilesMayBeReplaced := True;
      end;
      RaiseException('Ticketbox program-files copy boundary persistence failed.');
    end;
    LifecycleFilesMayBeReplaced := True;
    AssertLifecycleLockActive();
  end;
  if CurStep = ssPostInstall then
  begin
    try
      AssertLifecycleLockActive();
      AssertManagerMaintenanceGateActive();
      AssertDataRootMutationGuardActive();
    if not BeginLifecycleFinalizationAttempt() then
    begin
      RecordInstallationFailure(
        '无法建立受保护的服务初始化尝试；安装交付未完成。');
      exit;
    end;
    PublicFailurePath :=
      LifecycleBootstrapFilePath(InstallPublicFailureFileName);
    if FileExists(PublicFailurePath) and
       (not DeleteFile(PublicFailurePath)) then
    begin
      RecordInstallationFailure(
        '无法清理上一次受保护的安装失败回执；为避免误报，本次安装已停止。');
      exit;
    end;
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -TargetBackendVersion {#AppVersion}' +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -LifecycleFinalizationAttemptId ' +
        LifecycleFinalizationAttemptId +
      ' -PublicFailurePath ' + Quote(PublicFailurePath);
    SetInstallerStage(
      '正在初始化数据库和后端服务…',
      '首次初始化可能需要几分钟，安装器仍在工作。');
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\install_bundled_services.ps1'),
      Args,
      'Ticketbox service installation') then
    begin
      if LastPowerShellFailureMessage <> '' then
      begin
        RecordInstallationFailure(LastPowerShellFailureMessage);
        exit;
      end;
      RecordInstallationFailure(
        '小票夹服务初始化未完成，且没有取得可验证的公开失败回执。');
      exit;
    end;
    if FileExists(PublicFailurePath) and
       (not DeleteFile(PublicFailurePath)) then
    begin
      Log('Unable to remove the no-longer-needed public failure receipt.');
    end;
    AssertLifecycleLockActive();
    OwnerHandoffExpected := HasCurrentOwnerHandoffPendingArtifact();
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -TargetBackendVersion {#AppVersion}' +
      ' -ReleaseConfigPath ' + Quote(LifecycleBootstrapFilePath('windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -CommitCompletedInstall';
    SetInstallerStage(
      '正在验证安装结果…',
      '正在确认服务、版本和首次连接材料。');
    if not RunPowerShellChecked(
      LifecycleBootstrapFilePath('prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox installer lifecycle commit') then
    begin
      RecordInstallationFailure(
        '服务初始化已返回，但安装生命周期提交未通过最终验证。');
      exit;
    end;
    AssertLifecycleLockActive();
    AssertDataRootMutationGuardActive();
    LifecycleInstallCompleted := True;
      SetInstallerStage('安装完成', '服务已就绪，正在准备首次连接。');
    except
      RecordInstallationFailure(
        '安装后安全验证发生内部错误，安装交付未完成。');
    end;
  end;
end;

function GetCustomSetupExitCode(): Integer;
begin
  if LifecycleInstallFailed or
     (LifecyclePrepared and (not LifecycleInstallCompleted)) then
  begin
    Result := 4;
  end
  else
  begin
    Result := 0;
  end;
end;

procedure DeinitializeSetup();
var
  Args: String;
begin
  if LifecyclePrepared and (not LifecycleInstallCompleted) then
  begin
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -TargetBackendVersion {#AppVersion}' +
      ' -ReleaseConfigPath ' + Quote(LifecycleBootstrapFilePath('windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -RecoverPreparedInstall';
    if LifecycleFilesMayBeReplaced then
    begin
      Args := Args + ' -FilesReplaced';
    end;
    if not RunPowerShellChecked(
      LifecycleBootstrapFilePath('prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox failed-install isolation') then
    begin
      MsgBox(
        '安装失败后的故障隔离未完整完成。请保留数据目录和 recovery-required 标记，修复占用后重新运行安装器。未执行自动二进制或数据库回滚。',
        mbError,
        MB_OK);
    end;
  end;
  ReleaseDataRootMutationGuard();
  ReleaseLifecycleLock();
  CloseInstallerSourceLease();
  CloseManagerMaintenanceGate();
end;

function GetTicketboxRegisteredUninstallDataRoot(var DataRoot: String): Boolean;
begin
  DataRoot := '';
  Result :=
    RegQueryStringValue(
      HKLM64,
      'Software\Ticketbox',
      'DataRoot',
      DataRoot) and
    (Trim(DataRoot) <> '');
  if Result then
  begin
    DataRoot := Trim(DataRoot);
  end;
end;

function ConfirmTicketboxUninstallDataDisposition(): Boolean;
var
  Form: TSetupForm;
  HeadingLabel: TNewStaticText;
  ExplanationLabel: TNewStaticText;
  DataRootLabel: TNewStaticText;
  DataRootEdit: TNewEdit;
  DeleteDataCheck: TNewCheckBox;
  WarningLabel: TNewStaticText;
  ContinueButton: TNewButton;
  CancelButton: TNewButton;
  RegisteredDataRoot: String;
  HasRegisteredDataRoot: Boolean;
  ButtonWidth: Integer;
  ConfirmationResult: Integer;
begin
  Result := False;
  if UninstallDataChoiceResolved then
  begin
    Result := True;
    exit;
  end;
  UninstallDeleteDataSelected := False;
  if UninstallSilent then
  begin
    Log('Silent uninstall defaults to preserving local data.');
    UninstallDataChoiceResolved := True;
    Result := True;
    exit;
  end;

  HasRegisteredDataRoot :=
    GetTicketboxRegisteredUninstallDataRoot(RegisteredDataRoot);
  if not HasRegisteredDataRoot then
  begin
    RegisteredDataRoot :=
      '未找到 HKLM64\Software\Ticketbox\DataRoot；已强制保留数据';
  end;

  Form := CreateCustomForm(ScaleX(600), ScaleY(285), False, False);
  try
    Form.Caption := '卸载小票夹';

    HeadingLabel := TNewStaticText.Create(Form);
    HeadingLabel.Parent := Form;
    HeadingLabel.Left := ScaleX(16);
    HeadingLabel.Top := ScaleY(16);
    HeadingLabel.Width := Form.ClientWidth - ScaleX(32);
    HeadingLabel.Caption := '选择本机数据的处理方式';
    HeadingLabel.Font.Style := [fsBold];

    ExplanationLabel := TNewStaticText.Create(Form);
    ExplanationLabel.Parent := Form;
    ExplanationLabel.Left := ScaleX(16);
    ExplanationLabel.Top := ScaleY(45);
    ExplanationLabel.Width := Form.ClientWidth - ScaleX(32);
    ExplanationLabel.Height := ScaleY(34);
    ExplanationLabel.AutoSize := False;
    ExplanationLabel.WordWrap := True;
    ExplanationLabel.Caption :=
      '默认只卸载程序并保留数据库、上传文件、日志和备份，便于以后重装恢复。';

    DataRootLabel := TNewStaticText.Create(Form);
    DataRootLabel.Parent := Form;
    DataRootLabel.Left := ScaleX(16);
    DataRootLabel.Top := ScaleY(86);
    DataRootLabel.Caption := '当前安装登记的数据目录：';

    DataRootEdit := TNewEdit.Create(Form);
    DataRootEdit.Parent := Form;
    DataRootEdit.Left := ScaleX(16);
    DataRootEdit.Top := ScaleY(106);
    DataRootEdit.Width := Form.ClientWidth - ScaleX(32);
    DataRootEdit.Height := ScaleY(23);
    DataRootEdit.ReadOnly := True;
    DataRootEdit.Text := RegisteredDataRoot;

    DeleteDataCheck := TNewCheckBox.Create(Form);
    DeleteDataCheck.Parent := Form;
    DeleteDataCheck.Left := ScaleX(16);
    DeleteDataCheck.Top := ScaleY(148);
    DeleteDataCheck.Width := Form.ClientWidth - ScaleX(32);
    DeleteDataCheck.Caption :=
      '永久删除全部本地数据（数据库、上传文件、日志和备份）';
    DeleteDataCheck.Checked := False;
    DeleteDataCheck.Enabled := HasRegisteredDataRoot;

    WarningLabel := TNewStaticText.Create(Form);
    WarningLabel.Parent := Form;
    WarningLabel.Left := ScaleX(36);
    WarningLabel.Top := ScaleY(177);
    WarningLabel.Width := Form.ClientWidth - ScaleX(52);
    WarningLabel.Height := ScaleY(38);
    WarningLabel.AutoSize := False;
    WarningLabel.WordWrap := True;
    WarningLabel.Caption :=
      '删除不可恢复。只有勾选此项并在下一步再次明确确认，卸载器才会请求删除数据。';

    ContinueButton := TNewButton.Create(Form);
    ContinueButton.Parent := Form;
    ContinueButton.Caption := '继续卸载';
    ContinueButton.Top := Form.ClientHeight - ScaleY(39);
    ContinueButton.Height := ScaleY(23);
    ContinueButton.ModalResult := mrOk;
    ContinueButton.Default := True;

    CancelButton := TNewButton.Create(Form);
    CancelButton.Parent := Form;
    CancelButton.Caption := '取消';
    CancelButton.Top := ContinueButton.Top;
    CancelButton.Height := ContinueButton.Height;
    CancelButton.ModalResult := mrCancel;
    CancelButton.Cancel := True;

    ButtonWidth :=
      Form.CalculateButtonWidth([ContinueButton.Caption, CancelButton.Caption]);
    ContinueButton.Width := ButtonWidth;
    CancelButton.Width := ButtonWidth;
    CancelButton.Left := Form.ClientWidth - ScaleX(16) - CancelButton.Width;
    ContinueButton.Left := CancelButton.Left - ScaleX(8) - ContinueButton.Width;
    if HasRegisteredDataRoot then
    begin
      Form.ActiveControl := DeleteDataCheck;
    end
    else
    begin
      Form.ActiveControl := ContinueButton;
    end;
    Form.FlipAndCenterIfNeeded(True, UninstallProgressForm, False);

    if Form.ShowModal() <> mrOk then
    begin
      exit;
    end;
    if DeleteDataCheck.Checked and HasRegisteredDataRoot then
    begin
      ConfirmationResult := SuppressibleTaskDialogMsgBox(
        '确认是否永久删除全部本地数据',
        '将删除以下数据目录中的数据库、上传文件、日志和备份：' + #13#10 +
          RegisteredDataRoot + #13#10#13#10 +
          '此操作不可恢复。若不确定，请选择“保留数据并卸载”。',
        mbConfirmation,
        MB_YESNO, [
          '永久删除数据并卸载'#13#10'不可恢复',
          '保留数据并卸载'#13#10'可供以后重装恢复'
        ],
        0,
        IDNO);
      UninstallDeleteDataSelected := ConfirmationResult = IDYES;
    end;
    UninstallDataChoiceResolved := True;
    Result := True;
  finally
    Form.Free();
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Args: String;
begin
  if CurUninstallStep = usUninstall then
  begin
    if (not LifecycleLockActive()) or (not ManagerMaintenanceGateActive()) then
    begin
      Log('Uninstall authority check failed; public code TBX-UNINSTALL-LOCK.');
      RaiseException(TicketboxUninstallLockPublicMessage());
    end;
    if not ConfirmTicketboxUninstallDataDisposition() then
    begin
      Abort();
    end;
    if (not LifecycleLockActive()) or (not ManagerMaintenanceGateActive()) then
    begin
      Log('Uninstall authority changed during confirmation; public code TBX-UNINSTALL-LOCK.');
      RaiseException(TicketboxUninstallLockPublicMessage());
    end;
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId);
    if UninstallDeleteDataSelected then
    begin
      Args := Args + ' -DeleteData';
    end;
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\uninstall_bundled_services.ps1'),
      Args,
      'Ticketbox service uninstall') then
    begin
      if (not LifecycleLockActive()) or (not ManagerMaintenanceGateActive()) then
      begin
        Log('Uninstall authority changed after child start; public post-mutation code selected.');
        RaiseException(
          TicketboxUninstallPostMutationAuthorityMessage(
            UninstallDeleteDataSelected));
      end
      else if UninstallDeleteDataSelected then
      begin
        RaiseException(
          '卸载器无法证明本机数据已完整删除。请勿手工删除目录；' +
          '保留现状并联系支持。支持代码：TBX-UNINSTALL-DATA');
      end
      else
      begin
        RaiseException(
          '小票夹程序卸载未完整完成；本机数据未被请求删除。' +
          '请保留现状并重试。支持代码：TBX-UNINSTALL-FAILED');
      end;
    end;
    if (not LifecycleLockActive()) or (not ManagerMaintenanceGateActive()) then
    begin
      Log('Uninstall authority changed after child success; public post-mutation code selected.');
      RaiseException(
        TicketboxUninstallPostMutationAuthorityMessage(
          UninstallDeleteDataSelected));
    end;
  end;
end;
