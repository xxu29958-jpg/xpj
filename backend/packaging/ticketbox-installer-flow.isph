function ServiceExists(ServiceName: String): Boolean;
var
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\sc.exe'), 'query ' + ServiceName, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Result := ResultCode = 0;
end;

procedure LoadExistingConfig();
begin
  ExistingDataRoot := '';
  ExistingPgPort := '';
  ExistingBackendPort := '';

  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'DataRoot', ExistingDataRoot);
  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'PgPort', ExistingPgPort);
  RegQueryStringValue(HKLM, 'Software\Ticketbox', 'BackendPort', ExistingBackendPort);

  ExistingInstall :=
    (ExistingDataRoot <> '') or
    ServiceExists('{#PgServiceName}') or
    ServiceExists('{#BackendServiceName}');
end;

function IsPortListening(Port: String): Boolean;
var
  ResultCode: Integer;
  Params: String;
begin
  Params := '-NoProfile -ExecutionPolicy Bypass -Command ' +
    Quote('try { if (Get-NetTCPConnection -State Listen -LocalPort ' + Port +
      ' -ErrorAction Stop) { exit 1 }; exit 0 } catch { ' +
      'if ($_.FullyQualifiedErrorId -eq ''CmdletizationQuery_NotFound,Get-NetTCPConnection'') ' +
      '{ exit 0 }; exit 2 }');
  if not Exec(PowerShellExecutable(), Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    PortProbeFailed := True;
    Result := True;
    exit;
  end;
  if ResultCode = 0 then
  begin
    Result := False;
  end
  else if ResultCode = 1 then
  begin
    Result := True;
  end
  else
  begin
    PortProbeFailed := True;
    Result := True;
  end;
end;

function IsValidPort(Port: String): Boolean;
var
  PortNumber: Integer;
begin
  PortNumber := StrToIntDef(Trim(Port), -1);
  Result := (PortNumber >= 1) and (PortNumber <= 65535);
end;

function SelectInitialDataRoot(): String;
var
  ParamValue: String;
begin
  ParamValue := ExpandConstant('{param:TicketboxDataRoot|}');
  if ParamValue <> '' then
  begin
    Result := ParamValue;
  end
  else if ExistingDataRoot <> '' then
  begin
    Result := ExistingDataRoot;
  end
  else
  begin
    Result := ExpandConstant('{commonappdata}\Ticketbox');
  end;
end;

function SelectInitialPort(ParamName: String; ExistingValue: String; DefaultValue: String; FallbackValue: String): String;
var
  ParamValue: String;
begin
  ParamValue := ExpandConstant('{param:' + ParamName + '|}');
  if ParamValue <> '' then
  begin
    Result := ParamValue;
  end
  else if ExistingValue <> '' then
  begin
    Result := ExistingValue;
  end
  else if (not ExistingInstall) and IsPortListening(DefaultValue) and (not IsPortListening(FallbackValue)) then
  begin
    Result := FallbackValue;
  end
  else
  begin
    Result := DefaultValue;
  end;
end;

function SelectedDataRoot(): String;
begin
  if DataRootPage <> nil then
  begin
    Result := Trim(DataRootPage.Values[0]);
  end
  else
  begin
    Result := SelectInitialDataRoot();
  end;
end;

function SelectedPgPort(): String;
begin
  if PortPage <> nil then
  begin
    Result := Trim(PortPage.Values[0]);
  end
  else
  begin
    Result := SelectInitialPort(
      'TicketboxPgPort', ExistingPgPort, '{#DefaultPgPort}', '{#FallbackPgPort}');
  end;
end;

function SelectedBackendPort(): String;
begin
  if PortPage <> nil then
  begin
    Result := Trim(PortPage.Values[1]);
  end
  else
  begin
    Result := SelectInitialPort(
      'TicketboxBackendPort', ExistingBackendPort, '{#DefaultBackendPort}', '{#FallbackBackendPort}');
  end;
end;

function GetDataRoot(Param: String): String;
begin
  Result := SelectedDataRoot();
end;

function GetPgPort(Param: String): String;
begin
  Result := SelectedPgPort();
end;

function GetBackendPort(Param: String): String;
begin
  Result := SelectedBackendPort();
end;

function FreshInstall(): Boolean;
begin
  Result := (not ExistingInstall) and (not DirExists(SelectedDataRoot() + '\pgdata'));
end;

function PortConflictMessage(): String;
var
  PgPort: String;
  BackendPort: String;
  BusyPorts: String;
begin
  Result := '';
  PortProbeFailed := False;
  PgPort := SelectedPgPort();
  BackendPort := SelectedBackendPort();
  BusyPorts := '';

  if IsPortListening(PgPort) then
  begin
    BusyPorts := 'PostgreSQL 服务端口 ' + PgPort;
  end;
  if IsPortListening(BackendPort) then
  begin
    if BusyPorts <> '' then
    begin
      BusyPorts := BusyPorts + '、';
    end;
    BusyPorts := BusyPorts + '后端 API 端口 ' + BackendPort;
  end;

  if PortProbeFailed then
  begin
    Result := '无法可靠检查所选端口。安装器已停止，未复制任何程序文件。请检查 PowerShell 后重试。';
  end
  else if BusyPorts <> '' then
  begin
    Result :=
      '所选端口已被占用：' + BusyPorts + '。' + #13#10 + #13#10 +
      '请关闭占用这些端口的程序，或在上一步改用其它端口。开发机隔离端口：PostgreSQL ' +
      '{#FallbackPgPort}，后端 API {#FallbackBackendPort}。';
  end;
end;

function FreshInstallPortError(): String;
begin
  Result := '';
  if FreshInstall() then
  begin
    Result := PortConflictMessage();
  end;
end;

procedure InitializeWizard();
begin
  LoadExistingConfig();

  DataRootPage := CreateInputDirPage(
    wpSelectDir,
    '选择小票夹数据目录',
    '数据库、上传图片、日志和备份会保存到这里。',
    '普通用户保持默认即可。开发机或想放到 D 盘时，可以在这里更改。',
    False,
    ''
  );
  DataRootPage.Add('数据目录');
  DataRootPage.Values[0] := SelectInitialDataRoot();

  PortPage := CreateInputQueryPage(
    DataRootPage.ID,
    '配置本机服务端口',
    '小票夹会安装 PostgreSQL 服务和后端 API 服务。',
    '普通用户保持默认即可；如果本机已有 PostgreSQL 或正在运行源码后端，请使用未被占用的端口。'
  );
  PortPage.Add('PostgreSQL 服务端口', False);
  PortPage.Add('后端 API 端口', False);
  PortPage.Values[0] := SelectInitialPort(
    'TicketboxPgPort', ExistingPgPort, '{#DefaultPgPort}', '{#FallbackPgPort}');
  PortPage.Values[1] := SelectInitialPort(
    'TicketboxBackendPort', ExistingBackendPort, '{#DefaultBackendPort}', '{#FallbackBackendPort}');

  OwnerHandoffMemo := TNewMemo.Create(WizardForm.FinishedPage);
  OwnerHandoffMemo.Parent := WizardForm.FinishedPage;
  OwnerHandoffMemo.Left := 0;
  OwnerHandoffMemo.Top := WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(12);
  OwnerHandoffMemo.Width := WizardForm.FinishedPage.ClientWidth;
  OwnerHandoffMemo.ReadOnly := True;
  OwnerHandoffMemo.ScrollBars := ssVertical;
  OwnerHandoffMemo.Visible := False;

  OwnerHandoffConfirmation := TNewCheckBox.Create(WizardForm.FinishedPage);
  OwnerHandoffConfirmation.Parent := WizardForm.FinishedPage;
  OwnerHandoffConfirmation.Left := 0;
  OwnerHandoffConfirmation.Width := WizardForm.FinishedPage.ClientWidth;
  OwnerHandoffConfirmation.Height := ScaleY(24);
  OwnerHandoffConfirmation.Top :=
    WizardForm.FinishedPage.ClientHeight - OwnerHandoffConfirmation.Height;
  OwnerHandoffConfirmation.Caption :=
    '我已复制并妥善保存上面的一次性绑定信息';
  OwnerHandoffConfirmation.Checked := False;
  OwnerHandoffConfirmation.Visible := False;
  OwnerHandoffMemo.Height :=
    OwnerHandoffConfirmation.Top - OwnerHandoffMemo.Top - ScaleY(8);
end;

function LoadUtf8TextFile(FileName: String; MaximumLength: Integer; var Text: String): Boolean;
var
  Lines: TArrayOfString;
  Index: Integer;
begin
  Result := False;
  Text := '';
  if not LoadStringsFromFile(FileName, Lines) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(Lines) - 1 do
  begin
    if Index > 0 then
    begin
      Text := Text + #13#10;
    end;
    Text := Text + Lines[Index];
    if Length(Text) > MaximumLength then
    begin
      Text := '';
      exit;
    end;
  end;
  Result := Length(Text) > 0;
end;

function HasCurrentOwnerHandoffPendingArtifact(): Boolean;
var
  PendingPath: String;
  PendingValue: String;
begin
  Result := False;
  PendingPath := SelectedDataRoot() + '\app\owner-handoff-pending';
  if not FileExists(PendingPath) then
  begin
    exit;
  end;
  if LoadUtf8TextFile(PendingPath, 4096, PendingValue) then
  begin
    Result :=
      (Pos('SCHEMA=ticketbox-owner-handoff-v2' + #13#10, PendingValue) = 1) and
      (Pos('STATE=pending' + #13#10, PendingValue) > 0) and
      (Pos(
        'INSTALLER_OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10,
        PendingValue) > 0) and
      (Pos('CREDENTIAL_SHA256=', PendingValue) > 0);
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  HandoffPath: String;
  HandoffText: String;
begin
  if CurPageID <> wpFinished then
  begin
    exit;
  end;
  OwnerHandoffMemo.Visible := False;
  OwnerHandoffConfirmation.Checked := False;
  OwnerHandoffConfirmation.Visible := False;
  if (not OwnerHandoffExpected) or (not LifecycleInstallCompleted) then
  begin
    exit;
  end;

  HandoffPath := SelectedDataRoot() + '\app\owner-bootstrap.txt';
  if not LoadUtf8TextFile(HandoffPath, 16384, HandoffText) then
  begin
    WizardForm.FinishedLabel.Caption :=
      '小票夹已安装，但无法读取首次绑定信息。请保留安装日志并运行修复安装。';
    exit;
  end;
  WizardForm.FinishedLabel.Caption :=
    '小票夹已安装。请先选中并复制下面的一次性绑定信息，再关闭安装器。';
  OwnerHandoffMemo.Text := HandoffText;
  OwnerHandoffMemo.Visible := True;
  OwnerHandoffConfirmation.Visible := True;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  HandoffPath: String;
  HandoffPendingPath: String;
  Args: String;
  MessageText: String;
  VersionFailureReason: String;
begin
  Result := True;

  if (CurPageID = wpFinished) and OwnerHandoffExpected and
     LifecycleInstallCompleted and OwnerHandoffMemo.Visible then
  begin
    AssertDataRootMutationGuardActive();
    if not OwnerHandoffConfirmation.Checked then
    begin
      MsgBox(
        '请先复制一次性绑定信息，并勾选确认后再完成安装。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -CompleteOwnerHandoffOnly';
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\install_bundled_services.ps1'),
      Args,
      'Ticketbox owner bootstrap handoff completion') then
    begin
      if not LastPowerShellChildSucceeded then
      begin
        Result := False;
        exit;
      end;
    end;
    HandoffPath := SelectedDataRoot() + '\app\owner-bootstrap.txt';
    HandoffPendingPath := SelectedDataRoot() + '\app\owner-handoff-pending';
    if FileExists(HandoffPath) or FileExists(HandoffPendingPath) then
    begin
      MsgBox(
        '首次绑定信息清理后仍有敏感文件残留，拒绝完成安装。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    OwnerHandoffMemo.Text := '';
  end;

  if CurPageID = DataRootPage.ID then
  begin
    if SelectedDataRoot() = '' then
    begin
      MsgBox('请选择数据目录。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not CheckBackendVersionFloorForDataRoot(
      SelectedDataRoot(),
      VersionFailureReason) then
    begin
      MsgBox(VersionFailureReason, mbError, MB_OK);
      Result := False;
      exit;
    end;

    if ExistingInstall and (ExistingDataRoot <> '') and (SelectedDataRoot() <> ExistingDataRoot) then
    begin
      MsgBox('升级安装暂不支持在安装器中迁移数据目录。请保持原数据目录：' + ExistingDataRoot, mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = PortPage.ID then
  begin
    if not IsValidPort(SelectedPgPort()) then
    begin
      MsgBox('PostgreSQL 服务端口必须是 1 到 65535 之间的数字。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsValidPort(SelectedBackendPort()) then
    begin
      MsgBox('后端 API 端口必须是 1 到 65535 之间的数字。', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if SelectedPgPort() = SelectedBackendPort() then
    begin
      MsgBox('PostgreSQL 服务端口和后端 API 端口不能相同。', mbError, MB_OK);
      Result := False;
      exit;
    end;

    if ExistingInstall then
    begin
      if (ExistingPgPort <> '') and (SelectedPgPort() <> ExistingPgPort) then
      begin
        MsgBox('升级安装暂不支持在安装器中修改 PostgreSQL 端口。请保持原端口：' + ExistingPgPort, mbError, MB_OK);
        Result := False;
        exit;
      end;
      if (ExistingBackendPort <> '') and (SelectedBackendPort() <> ExistingBackendPort) then
      begin
        MsgBox('升级安装暂不支持在安装器中修改后端 API 端口。请保持原端口：' + ExistingBackendPort, mbError, MB_OK);
        Result := False;
        exit;
      end;
    end;

    if FreshInstall() then
    begin
      MessageText := PortConflictMessage();
      if MessageText <> '' then
      begin
        MsgBox(MessageText, mbError, MB_OK);
        Result := False;
        exit;
      end;
    end;
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Args: String;
  VersionFailureReason: String;
begin
  OwnerHandoffExpected := False;
  if not CheckBackendVersionFloorForDataRoot(
    SelectedDataRoot(),
    VersionFailureReason) then
  begin
    Result := VersionFailureReason;
    exit;
  end;
  Result := FreshInstallPortError();
  if Result <> '' then
  begin
    exit;
  end;
  ExtractTemporaryFile('windows_service_contract.ps1');
  ExtractTemporaryFile('windows_service_lifecycle.ps1');
  ExtractTemporaryFile('windows_installation_safety.ps1');
  ExtractTemporaryFile('windows_lifecycle_receipt.ps1');
  ExtractTemporaryFile('windows_lifecycle_lock.ps1');
  ExtractTemporaryFile('windows_database_safety.ps1');
  ExtractTemporaryFile('windows_pg_recovery_tools.ps1');
  ExtractTemporaryFile('windows_release_config.ps1');
  ExtractTemporaryFile('windows-release-config.json');
  ExtractTemporaryFile('windows_backend_build_provenance.ps1');
  ExtractTemporaryFile('windows_build_provenance.ps1');
  ExtractTemporaryFile('prepare_bundled_upgrade.ps1');
  if not StartDataRootMutationGuard(
    ExpandConstant('{tmp}\prepare_bundled_upgrade.ps1'),
    ExpandConstant('{app}'),
    SelectedDataRoot(),
    SelectedPgPort(),
    SelectedBackendPort()) then
  begin
    Result := '无法持续锁定 DataRoot 目录链；安装尚未进入复制前阶段。';
    exit;
  end;
  AssertDataRootMutationGuardActive();
  Args :=
    '-InstallDir ' + Quote(ExpandConstant('{app}')) +
    ' -DataRoot ' + Quote(SelectedDataRoot()) +
    ' -PgPort ' + SelectedPgPort() +
    ' -BackendPort ' + SelectedBackendPort() +
    ' -TargetPgMajor {#TargetPgMajor}' +
    ' -ReleaseConfigPath ' + Quote(ExpandConstant('{tmp}\windows-release-config.json')) +
    ' -InstalledReleaseConfigPath ' + Quote(ExpandConstant('{app}\installer\windows-release-config.json')) +
    ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
    ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId);
  if not RunPowerShellChecked(
    ExpandConstant('{tmp}\prepare_bundled_upgrade.ps1'),
    Args,
    'Ticketbox pre-upgrade backup and service preparation') then
  begin
    if LastPowerShellChildSucceeded then
    begin
      LifecyclePrepared := True;
    end;
    Result := '升级前备份或服务检查失败。本次安装尚未复制程序文件；若已有 recovery-required 标记，请按提示重新运行安装器修复。';
    exit;
  end;
  LifecyclePrepared := True;
  AssertDataRootMutationGuardActive();
  Result := '';
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Args: String;
begin
  if CurStep = ssInstall then
  begin
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -ReleaseConfigPath ' + Quote(ExpandConstant('{tmp}\windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -MarkProgramFilesInstalledBackupPending';
    if not RunPowerShellChecked(
      ExpandConstant('{tmp}\prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox program-files copy boundary') then
    begin
      if LastPowerShellChildSucceeded then
      begin
        LifecycleFilesMayBeReplaced := True;
      end;
      RaiseException('Ticketbox program-files copy boundary persistence failed.');
    end;
    LifecycleFilesMayBeReplaced := True;
  end;
  if CurStep = ssPostInstall then
  begin
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId);
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\install_bundled_services.ps1'),
      Args,
      'Ticketbox service installation') then
    begin
      RaiseException('Ticketbox service installation failed.');
    end;
    OwnerHandoffExpected := HasCurrentOwnerHandoffPendingArtifact();
    AssertDataRootMutationGuardActive();
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -ReleaseConfigPath ' + Quote(ExpandConstant('{tmp}\windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -CommitCompletedInstall';
    if not RunPowerShellChecked(
      ExpandConstant('{tmp}\prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox installer lifecycle commit') then
    begin
      RaiseException('Ticketbox installer lifecycle commit failed.');
    end;
    LifecycleInstallCompleted := True;
  end;
end;

procedure DeinitializeSetup();
var
  Args: String;
begin
  if LifecyclePrepared and (not LifecycleInstallCompleted) then
  begin
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -DataRoot ' + Quote(SelectedDataRoot()) +
      ' -PgPort ' + SelectedPgPort() +
      ' -BackendPort ' + SelectedBackendPort() +
      ' -TargetPgMajor {#TargetPgMajor}' +
      ' -ReleaseConfigPath ' + Quote(ExpandConstant('{tmp}\windows-release-config.json')) +
      ' -LifecycleReceiptPath ' + Quote(ExpandConstant('{commoncf64}\Ticketbox\installer-lifecycle-receipt.json')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
      ' -RecoverPreparedInstall';
    if LifecycleFilesMayBeReplaced then
    begin
      Args := Args + ' -FilesReplaced';
    end;
    if not RunPowerShellChecked(
      ExpandConstant('{tmp}\prepare_bundled_upgrade.ps1'),
      Args,
      'Ticketbox failed-install isolation') then
    begin
      MsgBox(
        '安装失败后的故障隔离未完整完成。请保留数据目录和 recovery-required 标记，修复占用后重新运行安装器。未执行自动二进制或数据库回滚。',
        mbError,
        MB_OK);
    end;
  end;
  ReleaseDataRootMutationGuard();
  ReleaseLifecycleLock();
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Args: String;
begin
  if CurUninstallStep = usUninstall then
  begin
    Args :=
      '-InstallDir ' + Quote(ExpandConstant('{app}')) +
      ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId);
    if not RunPowerShellChecked(
      ExpandConstant('{app}\installer\uninstall_bundled_services.ps1'),
      Args,
      'Ticketbox service uninstall') then
    begin
      RaiseException('Ticketbox service uninstall failed.');
    end;
  end;
end;
