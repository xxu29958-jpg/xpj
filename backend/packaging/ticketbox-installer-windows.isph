const
  InvalidHandleValue = $FFFFFFFF;
  ProcessSynchronize = $00100000;
  ProcessQueryLimitedInformation = $00001000;
  WaitObject0 = 0;
  WaitTimeout = 258;
  GenericRead = $80000000;
  FileShareRead = $00000001;
  OpenExisting = 3;
  FileAttributeNormal = $00000080;
  ManagerMaintenanceRegistryPath = 'Software\Ticketbox';
  ManagerMaintenanceRegistryValue = 'MaintenanceOwner';
  ManagerMaintenanceRecordSchema = 'ticketbox-manager-maintenance-v1';
  LifecycleSafetyScriptSha256 = '{#LifecycleSafetyScriptSha256}';
  LifecycleLockScriptSha256 = '{#LifecycleLockScriptSha256}';
  LifecycleHolderScriptSha256 = '{#LifecycleHolderScriptSha256}';
  DataRootGuardScriptSha256 = '{#DataRootGuardScriptSha256}';
  PrepareScriptSha256 = '{#PrepareScriptSha256}';
  ServiceContractScriptSha256 = '{#ServiceContractScriptSha256}';
  ServiceLifecycleScriptSha256 = '{#ServiceLifecycleScriptSha256}';
  LifecycleReceiptScriptSha256 = '{#LifecycleReceiptScriptSha256}';
  DatabaseSafetyScriptSha256 = '{#DatabaseSafetyScriptSha256}';
  PgRecoveryToolsScriptSha256 = '{#PgRecoveryToolsScriptSha256}';
  ReleaseConfigScriptSha256 = '{#ReleaseConfigScriptSha256}';
  ReleaseConfigJsonSha256 = '{#ReleaseConfigJsonSha256}';
  BuildProvenanceScriptSha256 = '{#BuildProvenanceScriptSha256}';
  BackendBuildProvenanceScriptSha256 = '{#BackendBuildProvenanceScriptSha256}';

type
  TTicketboxFileTime = record
    LowDateTime: LongWord;
    HighDateTime: LongWord;
  end;

var
  DataRootPage: TInputDirWizardPage;
  PortPage: TInputQueryWizardPage;
  AdvancedPortSettings: TNewCheckBox;
  ExistingInstall: Boolean;
  ExistingDataRoot: String;
  ExistingPgPort: String;
  ExistingBackendPort: String;
  ResolvedPgPort: String;
  ResolvedBackendPort: String;
  AutomaticPortSelectionError: String;
  SelectedPowerShellPath: String;
  PortProbeFailed: Boolean;
  LifecycleLockHolderProcessHandle: LongWord;
  LifecycleLockHolderProcessId: LongWord;
  LifecycleLockRootValidatedPath: String;
  LifecycleLockHolderReadyPath: String;
  LifecycleLockHolderReleasePath: String;
  LifecycleLockReleaseNonce: String;
  LifecycleInstallerStateDirectory: String;
  LifecycleLockHolderScriptPath: String;
  LifecycleLockBootstrapDirectory: String;
  LifecycleLockBootstrapFilesStaged: Boolean;
  LifecycleLockHolderStarted: Boolean;
  LifecycleLockHolderActive: Boolean;
  LifecycleLockOwnerPath: String;
  LifecycleLockOwnerProcessId: LongWord;
  LifecycleLockOwnerStartedFileTimeHigh: String;
  LifecycleLockOwnerStartedFileTimeLow: String;
  LifecycleLockError: String;
  LifecyclePrepared: Boolean;
  LifecycleFilesMayBeReplaced: Boolean;
  LifecycleInstallCompleted: Boolean;
  InstallerLogSequence: Integer;
  LastInstallerLogPath: String;
  LastPowerShellChildSucceeded: Boolean;
  OwnerHandoffExpected: Boolean;
  OwnerHandoffMemo: TNewMemo;
  OwnerHandoffConfirmation: TNewCheckBox;
  DataRootGuardProcessId: LongWord;
  DataRootGuardProcessHandle: LongWord;
  DataRootGuardProcessStartedFileTimeHigh: String;
  DataRootGuardProcessStartedFileTimeLow: String;
  DataRootGuardReadyPath: String;
  DataRootGuardReleasePath: String;
  DataRootGuardReleaseNonce: String;
  DataRootGuardScriptPath: String;
  DataRootGuardProcessStarted: Boolean;
  DataRootGuardActive: Boolean;
  ManagerMaintenanceOwnerRecord: String;
  InstallerSourceLeaseHandle: LongWord;

function CloseHandle(Handle: LongWord): Boolean;
  external 'CloseHandle@kernel32.dll stdcall';
function GetCurrentProcessId(): LongWord;
  external 'GetCurrentProcessId@kernel32.dll stdcall';
function GetLastError(): LongWord;
  external 'GetLastError@kernel32.dll stdcall';
procedure SetLastError(ErrorCode: LongWord);
  external 'SetLastError@kernel32.dll stdcall';
function CreateFileForLease(
  FileName: String;
  DesiredAccess: LongWord;
  ShareMode: LongWord;
  SecurityAttributes: LongWord;
  CreationDisposition: LongWord;
  FlagsAndAttributes: LongWord;
  TemplateFile: LongWord
): LongWord;
  external 'CreateFileW@kernel32.dll stdcall';
function OpenProcess(
  DesiredAccess: LongWord;
  InheritHandle: Boolean;
  ProcessId: LongWord
): LongWord;
  external 'OpenProcess@kernel32.dll stdcall';
function WaitForSingleObject(Handle: LongWord; Milliseconds: LongWord): LongWord;
  external 'WaitForSingleObject@kernel32.dll stdcall';
function GetProcessTimes(
  ProcessHandle: LongWord;
  var CreationTime: TTicketboxFileTime;
  var ExitTime: TTicketboxFileTime;
  var KernelTime: TTicketboxFileTime;
  var UserTime: TTicketboxFileTime
): Boolean;
  external 'GetProcessTimes@kernel32.dll stdcall';

procedure CloseInstallerSourceLease();
begin
  if (InstallerSourceLeaseHandle <> 0) and
     (InstallerSourceLeaseHandle <> InvalidHandleValue) then
  begin
    CloseHandle(InstallerSourceLeaseHandle);
  end;
  InstallerSourceLeaseHandle := InvalidHandleValue;
end;

function AcquireInstallerSourceLease(): Boolean;
begin
  InstallerSourceLeaseHandle := CreateFileForLease(
    ExpandConstant('{srcexe}'),
    GenericRead,
    FileShareRead,
    0,
    OpenExisting,
    FileAttributeNormal,
    0);
  if (InstallerSourceLeaseHandle = 0) or
     (InstallerSourceLeaseHandle = InvalidHandleValue) then
  begin
    Log('Could not acquire the installer source file lease.');
    Result := False;
    exit;
  end;
  Result := True;
end;

function BuildManagerMaintenanceOwnerRecord(): String;
begin
  Result :=
    ManagerMaintenanceRecordSchema + '|' +
    IntToStr(LifecycleLockOwnerProcessId) + '|' +
    LifecycleLockOwnerStartedFileTimeHigh + '|' +
    LifecycleLockOwnerStartedFileTimeLow;
end;

function StartManagerMaintenanceGate(): Boolean;
var
  Persisted: String;
begin
  if ManagerMaintenanceOwnerRecord <> '' then
  begin
    Result :=
      RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted) and
      (Persisted = ManagerMaintenanceOwnerRecord);
    exit;
  end;
  if (LifecycleLockOwnerProcessId = 0) or
     (LifecycleLockOwnerStartedFileTimeHigh = '') or
     (LifecycleLockOwnerStartedFileTimeLow = '') then
  begin
    Log('Lifecycle owner identity is unavailable for the Manager maintenance marker.');
    Result := False;
    exit;
  end;
  ManagerMaintenanceOwnerRecord := BuildManagerMaintenanceOwnerRecord();
  if not RegWriteStringValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue,
    ManagerMaintenanceOwnerRecord) then
  begin
    ManagerMaintenanceOwnerRecord := '';
    Log('Could not publish the Manager maintenance owner marker.');
    Result := False;
    exit;
  end;
  if (not RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted)) or
     (Persisted <> ManagerMaintenanceOwnerRecord) then
  begin
    ManagerMaintenanceOwnerRecord := '';
    Log('The Manager maintenance owner marker failed post-write verification.');
    Result := False;
    exit;
  end;
  Result := True;
end;

function ManagerMaintenanceGateActive(): Boolean;
var
  Persisted: String;
begin
  Result :=
    (ManagerMaintenanceOwnerRecord <> '') and
    RegQueryStringValue(
      HKLM64,
      ManagerMaintenanceRegistryPath,
      ManagerMaintenanceRegistryValue,
      Persisted) and
    (Persisted = ManagerMaintenanceOwnerRecord);
end;

procedure AssertManagerMaintenanceGateActive();
begin
  if not ManagerMaintenanceGateActive() then
  begin
    RaiseException('Manager maintenance gate is not active.');
  end;
end;

function ReleaseManagerMaintenanceGate(): Boolean;
var
  Persisted: String;
begin
  Result := True;
  if ManagerMaintenanceOwnerRecord = '' then
  begin
    exit;
  end;
  if (not RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted)) or
     (Persisted <> ManagerMaintenanceOwnerRecord) then
  begin
    Result := False;
    exit;
  end;
  if not RegDeleteValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue) then
  begin
    Result := False;
    exit;
  end;
  if RegQueryStringValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue,
    Persisted) then
  begin
    Result := False;
    exit;
  end;
  ManagerMaintenanceOwnerRecord := '';
end;

procedure CloseManagerMaintenanceGate();
var
  Persisted: String;
begin
  if (ManagerMaintenanceOwnerRecord <> '') and
     RegQueryStringValue(
       HKLM64,
       ManagerMaintenanceRegistryPath,
       ManagerMaintenanceRegistryValue,
       Persisted) and
     (Persisted = ManagerMaintenanceOwnerRecord) then
  begin
    RegDeleteValue(
      HKLM64,
      ManagerMaintenanceRegistryPath,
      ManagerMaintenanceRegistryValue);
  end;
  ManagerMaintenanceOwnerRecord := '';
end;

function IsProcessHandleRunning(Handle: LongWord): Boolean;
begin
  Result := False;
  if (Handle = 0) or (Handle = InvalidHandleValue) then
  begin
    exit;
  end;
  Result := WaitForSingleObject(Handle, 0) = WaitTimeout;
end;

function ReadProcessStartedFileTime(
  Handle: LongWord;
  var HighText: String;
  var LowText: String
): Boolean;
var
  CreationTime: TTicketboxFileTime;
  ExitTime: TTicketboxFileTime;
  KernelTime: TTicketboxFileTime;
  UserTime: TTicketboxFileTime;
begin
  Result := False;
  HighText := '';
  LowText := '';
  if (Handle = 0) or (Handle = InvalidHandleValue) then
  begin
    exit;
  end;
  if not GetProcessTimes(
    Handle,
    CreationTime,
    ExitTime,
    KernelTime,
    UserTime) then
  begin
    exit;
  end;
  HighText := IntToStr(Int64(CreationTime.HighDateTime));
  LowText := IntToStr(Int64(CreationTime.LowDateTime));
  Result := True;
end;

function ProcessHandleMatchesStartedFileTime(
  Handle: LongWord;
  ExpectedHighText: String;
  ExpectedLowText: String
): Boolean;
var
  ActualHighText: String;
  ActualLowText: String;
begin
  Result :=
    ReadProcessStartedFileTime(Handle, ActualHighText, ActualLowText) and
    (ActualHighText = ExpectedHighText) and
    (ActualLowText = ExpectedLowText);
end;

function OpenVerifiedProcessIdentityHandle(
  ProcessId: LongWord;
  ExpectedHighText: String;
  ExpectedLowText: String
): LongWord;
var
  ProcessHandle: LongWord;
begin
  Result := InvalidHandleValue;
  ProcessHandle := OpenProcess(
    ProcessSynchronize or ProcessQueryLimitedInformation,
    False,
    ProcessId);
  if not IsProcessHandleRunning(ProcessHandle) or
     not ProcessHandleMatchesStartedFileTime(
       ProcessHandle,
       ExpectedHighText,
       ExpectedLowText) then
  begin
    if (ProcessHandle <> 0) and (ProcessHandle <> InvalidHandleValue) then
    begin
      CloseHandle(ProcessHandle);
    end;
    exit;
  end;
  Result := ProcessHandle;
end;

function Quote(Value: String): String;
var
  Index: Integer;
begin
  if (Pos('"', Value) > 0) or (Pos(#0, Value) > 0) or
     (Pos(#13, Value) > 0) or (Pos(#10, Value) > 0) then
  begin
    RaiseException('Windows command arguments cannot contain quotes or newlines.');
  end;
  Result := '"' + Value;
  Index := Length(Value);
  while (Index > 0) and (Value[Index] = '\') do
  begin
    Result := Result + '\';
    Index := Index - 1;
  end;
  Result := Result + '"';
end;

function WindowsPowerShellExecutable(): String;
begin
  Result := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
end;

function RunLifecycleIcacls(TargetPath: String; Arguments: String): Boolean;
var
  ResultCode: Integer;
begin
  if not Exec(
    ExpandConstant('{sys}\icacls.exe'),
    Quote(TargetPath) + ' ' + Arguments,
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function HardenLifecycleLockPath(TargetPath: String; IsDirectory: Boolean): Boolean;
var
  GrantArguments: String;
begin
  if IsDirectory then
  begin
    GrantArguments := '/grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F"';
  end
  else
  begin
    GrantArguments := '/grant:r "*S-1-5-18:F" "*S-1-5-32-544:F"';
  end;
  Result :=
    RunLifecycleIcacls(TargetPath, '/reset') and
    RunLifecycleIcacls(TargetPath, GrantArguments) and
    RunLifecycleIcacls(TargetPath, '/inheritance:r') and
    RunLifecycleIcacls(TargetPath, '/setowner *S-1-5-18') and
    RunLifecycleIcacls(TargetPath, '/verify');
end;

procedure CleanupLifecycleLockBootstrapDirectory();
begin
  if LifecycleLockBootstrapDirectory = '' then
  begin
    LifecycleLockRootValidatedPath := '';
    LifecycleLockBootstrapFilesStaged := False;
    exit;
  end;
  if LifecycleLockRootValidatedPath <> '' then
  begin
    DeleteFile(LifecycleLockRootValidatedPath);
  end;
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_installer_lifecycle_lock.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_lifecycle_lock.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_installation_safety.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_data_root_mutation_guard.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'prepare_bundled_upgrade.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_service_contract.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_service_lifecycle.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_lifecycle_receipt.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_database_safety.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_pg_recovery_tools.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_release_config.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows-release-config.json');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_build_provenance.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_backend_build_provenance.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'ticketbox-run-installer-child-logged.ps1');
  if DirExists(LifecycleLockBootstrapDirectory) and
     (not RemoveDir(LifecycleLockBootstrapDirectory)) then
  begin
    Log('Could not remove the protected lifecycle bootstrap directory; it contains no authority state.');
  end;
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockRootValidatedPath := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderScriptPath := '';
end;

function StageLifecycleLockBootstrapFile(
  FileName: String;
  ExpectedSha256: String
): Boolean;
var
  ExtractedPath: String;
  ProtectedPath: String;
  ActualSha256: String;
begin
  Result := False;
  try
    ExtractTemporaryFile(FileName);
  except
    LifecycleLockError :=
      '无法从安装器内嵌 payload 提取 lifecycle bootstrap 文件 ' + FileName +
      '：' + GetExceptionMessage();
    exit;
  end;
  ExtractedPath := ExpandConstant('{tmp}\') + FileName;
  ProtectedPath := AddBackslash(LifecycleLockBootstrapDirectory) + FileName;
  if not CopyFile(ExtractedPath, ProtectedPath, True) then
  begin
    LifecycleLockError := '无法把 lifecycle bootstrap 文件复制到受保护 staging：' + FileName;
    exit;
  end;
  if not HardenLifecycleLockPath(ProtectedPath, False) then
  begin
    LifecycleLockError := '无法收紧 lifecycle bootstrap 文件 ACL：' + FileName;
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(ProtectedPath));
  except
    LifecycleLockError := '无法计算受保护 lifecycle bootstrap 文件 SHA-256：' + FileName;
    exit;
  end;
  if CompareText(ActualSha256, ExpectedSha256) <> 0 then
  begin
    LifecycleLockError := '受保护 lifecycle bootstrap 文件与构建时 SHA-256 不匹配：' + FileName;
    exit;
  end;
  Result := True;
end;

function ValidateLifecycleLockBootstrapFile(
  FileName: String;
  ExpectedSha256: String
): Boolean;
var
  FilePath: String;
  ActualSha256: String;
begin
  Result := False;
  if LifecycleLockBootstrapDirectory = '' then
  begin
    exit;
  end;
  FilePath := AddBackslash(LifecycleLockBootstrapDirectory) + FileName;
  if not FileExists(FilePath) then
  begin
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(FilePath));
  except
    exit;
  end;
  Result := CompareText(ActualSha256, ExpectedSha256) = 0;
end;

function ValidateLifecycleLockBootstrapFiles(): Boolean;
begin
  Result :=
    ValidateLifecycleLockBootstrapFile(
      'windows_installation_safety.ps1', LifecycleSafetyScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_lifecycle_lock.ps1', LifecycleLockScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'hold_installer_lifecycle_lock.ps1', LifecycleHolderScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'hold_data_root_mutation_guard.ps1', DataRootGuardScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'prepare_bundled_upgrade.ps1', PrepareScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_service_contract.ps1', ServiceContractScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_service_lifecycle.ps1', ServiceLifecycleScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_lifecycle_receipt.ps1', LifecycleReceiptScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_database_safety.ps1', DatabaseSafetyScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_pg_recovery_tools.ps1', PgRecoveryToolsScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_release_config.ps1', ReleaseConfigScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows-release-config.json', ReleaseConfigJsonSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_build_provenance.ps1', BuildProvenanceScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_backend_build_provenance.ps1', BackendBuildProvenanceScriptSha256);
end;

function LifecycleBootstrapFilePath(FileName: String): String;
begin
  if LifecycleLockBootstrapDirectory = '' then
  begin
    RaiseException('受保护 lifecycle bootstrap staging 尚未建立。');
  end;
  Result := AddBackslash(LifecycleLockBootstrapDirectory) + FileName;
end;

function LifecycleInstallerStatePath(FileName: String): String;
begin
  if LifecycleInstallerStateDirectory = '' then
  begin
    RaiseException('机器级安装锁 holder 尚未声明 installer state 路径。');
  end;
  Result := AddBackslash(LifecycleInstallerStateDirectory) + FileName;
end;

function PrepareLifecycleLockBootstrapDirectory(): Boolean;
begin
  Result := False;
  LifecycleLockError := '';
  LifecycleLockBootstrapDirectory :=
    ExpandConstant('{commoncf64}\Ticketbox-Installer-Bootstrap-') +
    IntToStr(GetCurrentProcessId());
  if FileOrDirExists(LifecycleLockBootstrapDirectory) then
  begin
    LifecycleLockError :=
      '检测到同 PID 的旧 lifecycle bootstrap staging，拒绝复用：' +
      LifecycleLockBootstrapDirectory;
    exit;
  end;
  if not CreateDir(LifecycleLockBootstrapDirectory) then
  begin
    LifecycleLockError := '无法创建 lifecycle bootstrap staging。';
    exit;
  end;
  if not HardenLifecycleLockPath(LifecycleLockBootstrapDirectory, True) then
  begin
    LifecycleLockError := '无法收紧 lifecycle bootstrap staging ACL。';
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  Result := True;
end;

function PrepareSetupLifecycleLockHolderScripts(): Boolean;
begin
  Result := False;
  if not PrepareLifecycleLockBootstrapDirectory() then
  begin
    exit;
  end;
  if not StageLifecycleLockBootstrapFile(
    'windows_installation_safety.ps1',
    LifecycleSafetyScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_lifecycle_lock.ps1',
    LifecycleLockScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'hold_installer_lifecycle_lock.ps1',
    LifecycleHolderScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'hold_data_root_mutation_guard.ps1',
    DataRootGuardScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'prepare_bundled_upgrade.ps1',
    PrepareScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_service_contract.ps1',
    ServiceContractScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_service_lifecycle.ps1',
    ServiceLifecycleScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_lifecycle_receipt.ps1',
    LifecycleReceiptScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_database_safety.ps1',
    DatabaseSafetyScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_pg_recovery_tools.ps1',
    PgRecoveryToolsScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_release_config.ps1',
    ReleaseConfigScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows-release-config.json',
    ReleaseConfigJsonSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_build_provenance.ps1',
    BuildProvenanceScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_backend_build_provenance.ps1',
    BackendBuildProvenanceScriptSha256) then
  begin
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  LifecycleLockHolderScriptPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_installer_lifecycle_lock.ps1';
  LifecycleLockBootstrapFilesStaged := True;
  Result := True;
end;

function PrepareUninstallLifecycleLockHolderScript(): Boolean;
begin
  Result := PrepareLifecycleLockBootstrapDirectory();
  if not Result then
  begin
    exit;
  end;
  LifecycleLockHolderScriptPath :=
    ExpandConstant('{app}\installer\hold_installer_lifecycle_lock.ps1');
end;

function IsLowerHexLifecycleNonce(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 64;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
            ((Value[Index] >= 'a') and (Value[Index] <= 'f'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function AcquireLifecycleLock(): Boolean;
var
  LockDirectory: String;
  Params: String;
  ResultCode: Integer;
  Attempt: Integer;
  RootValidatedText: AnsiString;
  ReadyText: AnsiString;
  ExpectedRootValidatedText: String;
  RootValidatedValue: String;
  RootValidated: Boolean;
  ReadyPrefix: String;
  ReadyRemainder: String;
  HolderIdentityRemainder: String;
  HolderStartedLowRemainder: String;
  InstallerStateRemainder: String;
  HolderStartedHighDelimiter: String;
  HolderStartedLowDelimiter: String;
  InstallerStateDelimiter: String;
  NonceDelimiter: String;
  HolderProcessIdText: String;
  HolderStartedFileTimeHighText: String;
  HolderStartedFileTimeLowText: String;
  HolderDelimiterPosition: Integer;
  HolderStartedLowDelimiterPosition: Integer;
  InstallerStateDelimiterPosition: Integer;
  NonceDelimiterPosition: Integer;
  ParsedHolderProcessId: Integer;
  OwnerProcessHandle: LongWord;
  ExpectedReadyText: String;
  ReadyValue: String;
begin
  LifecycleLockError := '';
  Result := False;
  if LifecycleLockHolderStarted then
  begin
    LifecycleLockError := '安装生命周期锁 holder 已启动，拒绝重复获取。';
    exit;
  end;
  LockDirectory := ExpandConstant('{commoncf64}\Ticketbox');
  LifecycleLockOwnerPath := LockDirectory + '\installer-lifecycle.owner';
  if (LifecycleLockHolderScriptPath = '') or
     (not FileExists(LifecycleLockHolderScriptPath)) then
  begin
    LifecycleLockError := '缺少受信任的机器级安装锁 holder 脚本。';
    exit;
  end;
  if LifecycleLockBootstrapFilesStaged and
     (not ValidateLifecycleLockBootstrapFiles()) then
  begin
    LifecycleLockError :=
      '受保护 lifecycle bootstrap staging 在执行前未通过 SHA-256 复核。';
    exit;
  end;
  LifecycleLockOwnerProcessId := GetCurrentProcessId();
  OwnerProcessHandle := OpenProcess(
    ProcessSynchronize or ProcessQueryLimitedInformation,
    False,
    LifecycleLockOwnerProcessId);
  if not IsProcessHandleRunning(OwnerProcessHandle) or
     not ReadProcessStartedFileTime(
       OwnerProcessHandle,
       LifecycleLockOwnerStartedFileTimeHigh,
       LifecycleLockOwnerStartedFileTimeLow) then
  begin
    if (OwnerProcessHandle <> 0) and
       (OwnerProcessHandle <> InvalidHandleValue) then
    begin
      CloseHandle(OwnerProcessHandle);
    end;
    LifecycleLockError := '无法冻结安装器进程创建身份。';
    exit;
  end;
  CloseHandle(OwnerProcessHandle);
  LifecycleLockRootValidatedPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) +
    'lifecycle-root-validated.ready';
  if FileExists(LifecycleLockRootValidatedPath) then
  begin
    LifecycleLockError := '机器根验证信号已存在，拒绝复用。';
    exit;
  end;
  LifecycleLockHolderReadyPath :=
    LockDirectory + '\installer-lifecycle-' +
    IntToStr(LifecycleLockOwnerProcessId) + '.ready';
  LifecycleLockHolderReleasePath :=
    LockDirectory + '\installer-lifecycle-' +
    IntToStr(LifecycleLockOwnerProcessId) + '.release';
  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' +
     Quote(LifecycleLockHolderScriptPath) +
     ' -InstallerOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
     ' -InstallerOwnerStartedFileTimeHigh ' + LifecycleLockOwnerStartedFileTimeHigh +
     ' -InstallerOwnerStartedFileTimeLow ' + LifecycleLockOwnerStartedFileTimeLow +
     ' -ExpectedLockDirectory ' + Quote(LockDirectory) +
    ' -RootValidatedPath ' + Quote(LifecycleLockRootValidatedPath) +
    ' -ReadyPath ' + Quote(LifecycleLockHolderReadyPath) +
    ' -ReleasePath ' + Quote(LifecycleLockHolderReleasePath);
  if not Exec(
    WindowsPowerShellExecutable(),
    Params,
    '',
    SW_HIDE,
    ewNoWait,
    ResultCode) then
  begin
    LifecycleLockError := '无法启动受保护的机器级安装锁 holder。';
    exit;
  end;
  LifecycleLockHolderStarted := True;
  ExpectedRootValidatedText :=
    'STATE=root_validated' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  RootValidated := False;
  ReadyPrefix :=
    'STATE=holding' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
    'HOLDER_PID=';
  HolderStartedHighDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_HIGH=';
  HolderStartedLowDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_LOW=';
  InstallerStateDelimiter := #13#10 + 'INSTALLER_STATE=';
  NonceDelimiter := #13#10 + 'NONCE=';
  for Attempt := 1 to 300 do
  begin
    if not RootValidated then
    begin
      if FileExists(LifecycleLockRootValidatedPath) then
      begin
        if not LoadStringFromFile(
          LifecycleLockRootValidatedPath,
          RootValidatedText) then
        begin
          LifecycleLockError := '无法读取机器根验证信号。';
          exit;
        end;
        RootValidatedValue := String(RootValidatedText);
        if RootValidatedValue <> ExpectedRootValidatedText then
        begin
          LifecycleLockError := '机器根验证信号与当前安装器身份不匹配。';
          exit;
        end;
        RootValidated := True;
      end;
    end
    else if FileExists(LifecycleLockHolderReadyPath) then
    begin
      if not LoadStringFromFile(LifecycleLockHolderReadyPath, ReadyText) then
      begin
        LifecycleLockError := '无法读取机器级安装锁 ready IPC。';
        exit;
      end;
      ReadyValue := String(ReadyText);
      if Copy(ReadyValue, 1, Length(ReadyPrefix)) <> ReadyPrefix then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 前缀不匹配当前安装器。';
        exit;
      end;
      ReadyRemainder := Copy(
        ReadyValue,
        Length(ReadyPrefix) + 1,
        Length(ReadyValue));
      HolderDelimiterPosition := Pos(HolderStartedHighDelimiter, ReadyRemainder);
      if HolderDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder PID。';
        exit;
      end;
      HolderProcessIdText := Copy(
        ReadyRemainder,
        1,
        HolderDelimiterPosition - 1);
      ParsedHolderProcessId := StrToIntDef(HolderProcessIdText, 0);
      if (ParsedHolderProcessId <= 0) or
         (IntToStr(ParsedHolderProcessId) <> HolderProcessIdText) then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 的 holder PID 无效。';
        exit;
      end;
      HolderIdentityRemainder := Copy(
        ReadyRemainder,
        HolderDelimiterPosition + Length(HolderStartedHighDelimiter),
        Length(ReadyRemainder));
      HolderStartedLowDelimiterPosition := Pos(
        HolderStartedLowDelimiter,
        HolderIdentityRemainder);
      if HolderStartedLowDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder 创建时间高位。';
        exit;
      end;
      HolderStartedFileTimeHighText := Copy(
        HolderIdentityRemainder,
        1,
        HolderStartedLowDelimiterPosition - 1);
      HolderStartedLowRemainder := Copy(
        HolderIdentityRemainder,
        HolderStartedLowDelimiterPosition + Length(HolderStartedLowDelimiter),
        Length(HolderIdentityRemainder));
      InstallerStateDelimiterPosition := Pos(
        InstallerStateDelimiter,
        HolderStartedLowRemainder);
      if InstallerStateDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder 创建时间低位。';
        exit;
      end;
      HolderStartedFileTimeLowText := Copy(
        HolderStartedLowRemainder,
        1,
        InstallerStateDelimiterPosition - 1);
      InstallerStateRemainder := Copy(
        HolderStartedLowRemainder,
        InstallerStateDelimiterPosition + Length(InstallerStateDelimiter),
        Length(HolderStartedLowRemainder));
      NonceDelimiterPosition := Pos(NonceDelimiter, InstallerStateRemainder);
      if NonceDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 installer state 路径。';
        exit;
      end;
      LifecycleInstallerStateDirectory := Copy(
        InstallerStateRemainder,
        1,
        NonceDelimiterPosition - 1);
      if (CompareText(ExtractFileDir(LifecycleInstallerStateDirectory), LockDirectory) <> 0) or
         (CompareText(LifecycleInstallerStateDirectory, LockDirectory) = 0) then
      begin
        LifecycleLockError := '机器级安装锁 holder 声明的 installer state 越出机器根。';
        LifecycleInstallerStateDirectory := '';
        exit;
      end;
      LifecycleLockReleaseNonce := Copy(
        InstallerStateRemainder,
        NonceDelimiterPosition + Length(NonceDelimiter),
        64);
      ExpectedReadyText :=
        ReadyPrefix + HolderProcessIdText + HolderStartedHighDelimiter +
        HolderStartedFileTimeHighText + HolderStartedLowDelimiter +
        HolderStartedFileTimeLowText + InstallerStateDelimiter +
        LifecycleInstallerStateDirectory + NonceDelimiter +
        LifecycleLockReleaseNonce + #13#10;
      if (ReadyValue <> ExpectedReadyText) or
         (not IsLowerHexLifecycleNonce(LifecycleLockReleaseNonce)) then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 与当前安装器身份或随机挑战不匹配。';
        LifecycleLockReleaseNonce := '';
        LifecycleInstallerStateDirectory := '';
        exit;
      end;
      LifecycleLockHolderProcessId := LongWord(ParsedHolderProcessId);
      LifecycleLockHolderProcessHandle := OpenVerifiedProcessIdentityHandle(
        LifecycleLockHolderProcessId,
        HolderStartedFileTimeHighText,
        HolderStartedFileTimeLowText);
      if not IsProcessHandleRunning(LifecycleLockHolderProcessHandle) then
      begin
        LifecycleLockError :=
          '机器级安装锁 holder 的 PID/创建时间与 ready IPC 不匹配或进程已退出。';
        exit;
      end;
      LifecycleLockHolderActive := True;
      Result := True;
      exit;
    end;
    Sleep(100);
  end;
  if not RootValidated then
  begin
    LifecycleLockError := '机器级安装锁 holder 未在 30 秒内验证机器状态根。';
  end
  else
  begin
    LifecycleLockError := '机器级安装锁 holder 未在 30 秒内就绪。';
  end;
end;

procedure ReleaseLifecycleLock();
var
  ReleaseTempPath: String;
  ReleaseText: String;
  WaitResult: LongWord;
begin
  if not LifecycleLockHolderStarted then
  begin
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  if IsProcessHandleRunning(LifecycleLockHolderProcessHandle) then
  begin
    ReleaseTempPath := LifecycleLockHolderReleasePath + '.tmp';
    ReleaseText :=
      'STATE=release' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'NONCE=' + LifecycleLockReleaseNonce + #13#10;
    DeleteFile(ReleaseTempPath);
    if SaveStringToFile(ReleaseTempPath, ReleaseText, False) and
       HardenLifecycleLockPath(ReleaseTempPath, False) and
       RenameFile(ReleaseTempPath, LifecycleLockHolderReleasePath) then
    begin
      WaitResult := WaitForSingleObject(LifecycleLockHolderProcessHandle, 10000);
      if WaitResult <> WaitObject0 then
      begin
        Log('Lifecycle lock holder did not exit before timeout; parent exit remains the fail-safe release.');
      end;
    end
    else
    begin
      Log('Could not persist lifecycle lock release IPC; parent exit remains the fail-safe release.');
    end;
  end;
  if (LifecycleLockHolderProcessHandle <> 0) and
     (LifecycleLockHolderProcessHandle <> InvalidHandleValue) then
  begin
    CloseHandle(LifecycleLockHolderProcessHandle);
  end;
  DeleteFile(LifecycleLockHolderReadyPath);
  DeleteFile(LifecycleLockHolderReleasePath);
  DeleteFile(LifecycleLockHolderReleasePath + '.tmp');
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleInstallerStateDirectory := '';
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  LifecycleLockOwnerPath := '';
  LifecycleLockOwnerProcessId := 0;
  CleanupLifecycleLockBootstrapDirectory();
end;

procedure AssertLifecycleLockActive();
begin
  if (not LifecycleLockHolderActive) or
     (not IsProcessHandleRunning(LifecycleLockHolderProcessHandle)) then
  begin
    RaiseException('机器级安装生命周期锁未持续持有，拒绝继续 mutation。');
  end;
end;

function IsDecimalVersionComponent(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Value <> '';
  if not Result then
  begin
    exit;
  end;
  for Index := 1 to Length(Value) do
  begin
    if (Value[Index] < '0') or (Value[Index] > '9') then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function ParseSupportedNumericVersion(
  Value: String;
  var Major: Integer;
  var Minor: Integer;
  var Patch: Integer;
  var Revision: Integer
): Boolean;
var
  Parts: TArrayOfString;
  Index: Integer;
  Component: Integer;
begin
  Result := False;
  Major := 0;
  Minor := 0;
  Patch := 0;
  Revision := 0;
  Parts := StringSplit(Trim(Value), ['.'], stAll);
  if (GetArrayLength(Parts) < 3) or (GetArrayLength(Parts) > 4) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(Parts) - 1 do
  begin
    if not IsDecimalVersionComponent(Parts[Index]) then
    begin
      exit;
    end;
    Component := StrToIntDef(Parts[Index], -1);
    if (Component < 0) or (Component > 65535) then
    begin
      exit;
    end;
    case Index of
      0: Major := Component;
      1: Minor := Component;
      2: Patch := Component;
      3: Revision := Component;
    end;
  end;
  Result := True;
end;

function CompareSupportedNumericVersions(LeftValue: String; RightValue: String; var Comparable: Boolean): Integer;
var
  LeftMajor: Integer;
  LeftMinor: Integer;
  LeftPatch: Integer;
  LeftRevision: Integer;
  RightMajor: Integer;
  RightMinor: Integer;
  RightPatch: Integer;
  RightRevision: Integer;
begin
  Comparable :=
    ParseSupportedNumericVersion(LeftValue, LeftMajor, LeftMinor, LeftPatch, LeftRevision) and
    ParseSupportedNumericVersion(RightValue, RightMajor, RightMinor, RightPatch, RightRevision);
  Result := 0;
  if not Comparable then
  begin
    exit;
  end;
  if LeftMajor <> RightMajor then
  begin
    if LeftMajor < RightMajor then Result := -1 else Result := 1;
  end
  else if LeftMinor <> RightMinor then
  begin
    if LeftMinor < RightMinor then Result := -1 else Result := 1;
  end
  else if LeftPatch <> RightPatch then
  begin
    if LeftPatch < RightPatch then Result := -1 else Result := 1;
  end
  else if LeftRevision <> RightRevision then
  begin
    if LeftRevision < RightRevision then Result := -1 else Result := 1;
  end;
end;

function VersionGateServiceExists(ServiceName: String): Boolean;
var
  ResultCode: Integer;
begin
  if not Exec(
    ExpandConstant('{sys}\sc.exe'),
    'query ' + ServiceName,
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := True;
    exit;
  end;
  Result := ResultCode = 0;
end;

function HasExistingTicketboxInstallMarkers(): Boolean;
var
  ExistingValue: String;
begin
  Result :=
    RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'InstallDir', ExistingValue) or
    RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'DataRoot', ExistingValue) or
    VersionGateServiceExists('{#PgServiceName}') or
    VersionGateServiceExists('{#BackendServiceName}');
end;

function PersistentIdentityDataRoot(): String;
var
  ParamValue: String;
  RegisteredValue: String;
begin
  ParamValue := Trim(ExpandConstant('{param:TicketboxDataRoot|}'));
  if ParamValue <> '' then
  begin
    Result := ExpandFileName(ParamValue);
  end
  else if RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'DataRoot', RegisteredValue) and
          (Trim(RegisteredValue) <> '') then
  begin
    Result := ExpandFileName(Trim(RegisteredValue));
  end
  else
  begin
    Result := ExpandFileName(ExpandConstant('{commonappdata}\Ticketbox'));
  end;
end;

function PersistentIdentityPath(DataRoot: String): String;
begin
  Result := AddBackslash(DataRoot) + '.ticketbox-installation-identity';
end;

function HasProtectedPersistentIdentityAcl(IdentityPath: String): Boolean;
var
  ResultCode: Integer;
  EscapedPath: String;
  CommandText: String;
begin
  EscapedPath := IdentityPath;
  StringChangeEx(EscapedPath, '''', '''''', True);
  CommandText :=
    '$p=''' + EscapedPath + ''';' +
    '$ok=$true;' +
    '$i=Get-Item -LiteralPath $p -Force;' +
    'if(($i.Attributes-band[IO.FileAttributes]::ReparsePoint)-ne 0){$ok=$false};' +
    '$d=$i.Directory;while($null-ne$d){if(($d.Attributes-band[IO.FileAttributes]::ReparsePoint)-ne 0){$ok=$false};$d=$d.Parent};' +
    '$a=$i.GetAccessControl([Security.AccessControl.AccessControlSections]::All);' +
    '$sid=[Security.Principal.SecurityIdentifier];' +
    '$o=$a.Owner;' +
    'try{$o=(New-Object Security.Principal.NTAccount -ArgumentList $o).Translate($sid).Value}catch{};' +
    '$ok=$ok -and $a.AreAccessRulesProtected -and ($o -eq ''S-1-5-18'');' +
    '$allow=@(''S-1-5-18'',''S-1-5-32-544'');' +
    '$seen=@{};' +
    'foreach($r in $a.GetAccessRules($true,$false,$sid)){' +
    '$s=$r.IdentityReference.Value;' +
    '$full=($r.FileSystemRights-band[Security.AccessControl.FileSystemRights]::FullControl)-eq[Security.AccessControl.FileSystemRights]::FullControl;' +
    'if(($s -notin $allow) -or (-not $full) -or ($r.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow) -or $r.IsInherited){$ok=$false};$seen[$s]=$true};' +
    'foreach($s in $allow){if(-not $seen.ContainsKey($s)){$ok=$false}};' +
    'if($ok){exit 0}else{exit 1}';
  Result := Exec(
    WindowsPowerShellExecutable(),
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) and (ResultCode = 0);
end;

function IsUpperHexSha256(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 64;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
            ((Value[Index] >= 'A') and (Value[Index] <= 'F'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function IsCanonicalInstallationId(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 36;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if (Index = 9) or (Index = 14) or (Index = 19) or (Index = 24) then
    begin
      if Value[Index] <> '-' then
      begin
        Result := False;
        exit;
      end;
    end
    else if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
                 ((Value[Index] >= 'a') and (Value[Index] <= 'f')) or
                 ((Value[Index] >= 'A') and (Value[Index] <= 'F'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function TryGetPersistentBackendVersionFloor(
  DataRoot: String;
  var VersionFloor: String;
  var FailureReason: String
): Boolean;
var
  Lines: TArrayOfString;
  IdentityPath: String;
  ExpectedNames: TArrayOfString;
  Values: TArrayOfString;
  Index: Integer;
  Separator: Integer;
  Name: String;
  Value: String;
  Major: Integer;
  Minor: Integer;
  Patch: Integer;
  Revision: Integer;
begin
  Result := False;
  VersionFloor := '';
  FailureReason := '';
  IdentityPath := PersistentIdentityPath(DataRoot);
  if not FileExists(IdentityPath) then
  begin
    FailureReason := '持久安装身份文件不存在：' + IdentityPath;
    exit;
  end;
  if not HasProtectedPersistentIdentityAcl(IdentityPath) then
  begin
    FailureReason := '持久安装身份文件不是 SYSTEM/Administrators-only 精确 ACL。';
    exit;
  end;
  if not LoadStringsFromFile(IdentityPath, Lines) then
  begin
    FailureReason := '无法以 UTF-8 读取持久安装身份文件。';
    exit;
  end;
  SetArrayLength(ExpectedNames, 10);
  ExpectedNames[0] := 'SCHEMA';
  ExpectedNames[1] := 'BACKEND_VERSION_FLOOR';
  ExpectedNames[2] := 'INSTALLATION_ID';
  ExpectedNames[3] := 'BUILD_MANIFEST_SHA256';
  ExpectedNames[4] := 'DATA_ROOT';
  ExpectedNames[5] := 'INSTALL_DIR';
  ExpectedNames[6] := 'PG_SERVICE_NAME';
  ExpectedNames[7] := 'BACKEND_SERVICE_NAME';
  ExpectedNames[8] := 'PG_PORT';
  ExpectedNames[9] := 'BACKEND_PORT';
  SetArrayLength(Values, GetArrayLength(ExpectedNames));
  if GetArrayLength(Lines) <> GetArrayLength(ExpectedNames) then
  begin
    FailureReason := '持久安装身份字段数量不正确。';
    exit;
  end;
  for Index := 0 to GetArrayLength(Lines) - 1 do
  begin
    Separator := Pos('=', Lines[Index]);
    if Separator <= 1 then
    begin
      FailureReason := '持久安装身份含有无效字段。';
      exit;
    end;
    Name := Copy(Lines[Index], 1, Separator - 1);
    Value := Copy(Lines[Index], Separator + 1, MaxInt);
    if (Name <> ExpectedNames[Index]) or (Value = '') then
    begin
      FailureReason := '持久安装身份字段顺序、名称或值无效：' + Name;
      exit;
    end;
    Values[Index] := Value;
  end;
  if Values[0] <> 'ticketbox-installation-identity-v1' then
  begin
    FailureReason := '持久安装身份 schema 不受支持。';
    exit;
  end;
  if not ParseSupportedNumericVersion(Values[1], Major, Minor, Patch, Revision) then
  begin
    FailureReason := '持久 backend version floor 格式无效。';
    exit;
  end;
  if (not IsCanonicalInstallationId(Values[2])) or (not IsUpperHexSha256(Values[3])) then
  begin
    FailureReason := '持久 installation/build identity 格式无效。';
    exit;
  end;
  if Uppercase(AddBackslash(ExpandFileName(Values[4]))) <>
     Uppercase(AddBackslash(ExpandFileName(DataRoot))) then
  begin
    FailureReason := '持久安装身份绑定的 DataRoot 与当前保留数据不一致。';
    exit;
  end;
  if (Values[6] <> '{#PgServiceName}') or
     (Values[7] <> '{#BackendServiceName}') or
     (StrToIntDef(Values[8], -1) < 1) or (StrToIntDef(Values[8], -1) > 65535) or
     (StrToIntDef(Values[9], -1) < 1) or (StrToIntDef(Values[9], -1) > 65535) or
     (Values[8] = Values[9]) then
  begin
    FailureReason := '持久安装身份的服务或端口身份无效。';
    exit;
  end;
  VersionFloor := Values[1];
  Result := True;
end;

function TicketboxLegacyUninstallKey(): String;
begin
  Result :=
    'Software\Microsoft\Windows\CurrentVersion\Uninstall\{' +
    '{#TicketboxAppIdGuid}' + '}_is1';
end;

function CanonicalVersionGateInstallPath(Value: String): String;
begin
  Result := '';
  if Trim(Value) <> '' then
  begin
    Result := Uppercase(AddBackslash(ExpandFileName(Trim(Value))));
  end;
end;

function TryGetTrustedLegacyBackendVersion(
  var LegacyVersion: String;
  var FailureReason: String
): Boolean;
var
  UninstallKey: String;
  DisplayName: String;
  InstallLocation: String;
  RegisteredInstallDir: String;
  Major: Integer;
  Minor: Integer;
  Patch: Integer;
  Revision: Integer;
begin
  Result := False;
  LegacyVersion := '';
  FailureReason := '';
  UninstallKey := TicketboxLegacyUninstallKey();
  if not RegKeyExists(HKLM64, UninstallKey) then
  begin
    FailureReason := '未找到同一稳定 AppId 的 HKLM64 Inno 卸载记录。';
    exit;
  end;
  if (not RegQueryStringValue(HKLM64, UninstallKey, 'DisplayName', DisplayName)) or
     (CompareText(Trim(DisplayName), '{#AppName}') <> 0) then
  begin
    FailureReason := '旧版 Inno 卸载记录的 DisplayName 与小票夹产品身份不一致。';
    exit;
  end;
  if (not RegQueryStringValue(HKLM64, UninstallKey, 'InstallLocation', InstallLocation)) or
     (not RegQueryStringValue(
       HKLM64,
       'Software\Ticketbox',
       'InstallDir',
       RegisteredInstallDir)) or
     (not DirExists(ExpandFileName(Trim(InstallLocation)))) or
     (CanonicalVersionGateInstallPath(InstallLocation) = '') or
     (CanonicalVersionGateInstallPath(InstallLocation) <>
       CanonicalVersionGateInstallPath(RegisteredInstallDir)) then
  begin
    FailureReason :=
      '旧版 Inno 卸载记录的 InstallLocation 无法与 HKLM 小票夹 InstallDir 绑定。';
    exit;
  end;
  if not RegQueryStringValue(HKLM64, UninstallKey, 'DisplayVersion', LegacyVersion) then
  begin
    FailureReason := '旧版 Inno 卸载记录缺少 DisplayVersion。';
    exit;
  end;
  LegacyVersion := Trim(LegacyVersion);
  if not ParseSupportedNumericVersion(
    LegacyVersion,
    Major,
    Minor,
    Patch,
    Revision) then
  begin
    FailureReason :=
      '旧版 Inno DisplayVersion 不符合受支持的三段或四段纯数字版本契约。';
    exit;
  end;
  Result := True;
end;

function EvaluateBackendVersionFloorDecision(
  TargetVersion: String;
  HasFormalVersion: Boolean;
  FormalVersion: String;
  HasTrustedLegacyVersion: Boolean;
  LegacyVersion: String;
  HasExistingInstall: Boolean;
  LegacyFailureReason: String;
  var FailureReason: String
): Boolean;
var
  InstalledVersion: String;
  VersionFloorSource: String;
  Comparable: Boolean;
  Comparison: Integer;
  TargetMajor: Integer;
  TargetMinor: Integer;
  TargetPatch: Integer;
  TargetRevision: Integer;
begin
  FailureReason := '';
  VersionFloorSource := '';
  if not ParseSupportedNumericVersion(
    TargetVersion,
    TargetMajor,
    TargetMinor,
    TargetPatch,
    TargetRevision) then
  begin
    FailureReason :=
      '目标安装包版本不符合受支持的三段或四段纯数字版本契约：' + TargetVersion + #13#10 +
      '安装器已停止且不会复制文件。';
    Result := False;
    exit;
  end;
  if HasFormalVersion then
  begin
    InstalledVersion := Trim(FormalVersion);
    VersionFloorSource := '正式 BackendVersion';
  end
  else if HasTrustedLegacyVersion then
  begin
    InstalledVersion := Trim(LegacyVersion);
    VersionFloorSource := '旧版 Inno DisplayVersion';
  end
  else if HasExistingInstall then
  begin
    FailureReason :=
      '检测到已有小票夹安装，但无法读取 HKLM\Software\Ticketbox\BackendVersion。' + #13#10 +
      '旧版版本记录也不可信：' + LegacyFailureReason + #13#10 +
      '安装器无法安全判断是否降级，已停止且不会复制文件。';
    Result := False;
    exit;
  end
  else
  begin
    Result := True;
    exit;
  end;

  Comparison := CompareSupportedNumericVersions(TargetVersion, InstalledVersion, Comparable);
  if not Comparable then
  begin
    FailureReason :=
      '无法按受支持的三段或四段数字版本契约比较版本。' + #13#10 +
      '已安装版本：' + InstalledVersion + #13#10 +
      '目标版本：' + TargetVersion + #13#10 +
      '安装器已停止且不会复制文件。';
    Result := False;
    exit;
  end;
  if Comparison < 0 then
  begin
    FailureReason :=
      '拒绝安装旧版本。' + #13#10 +
      '版本下限来源：' + VersionFloorSource + #13#10 +
      '已安装或保留的版本下限：' + InstalledVersion + #13#10 +
      '目标版本：' + TargetVersion;
    Result := False;
    exit;
  end;
  Result := True;
end;

function CheckBackendVersionFloorForDataRoot(
  PreservedDataRoot: String;
  var FailureReason: String
): Boolean;
var
  HasFormalVersion: Boolean;
  FormalVersion: String;
  HasTrustedLegacyVersion: Boolean;
  LegacyVersion: String;
  HasExistingInstall: Boolean;
  LegacyFailureReason: String;
  PersistentIdentityFile: String;
  PersistentIdentityFailure: String;
  HasPersistentIdentity: Boolean;
  HasPreservedPgData: Boolean;
  RegisteredDataRoot: String;
begin
  FormalVersion := '';
  LegacyVersion := '';
  LegacyFailureReason := '';
  HasTrustedLegacyVersion := False;
  HasExistingInstall := False;
  PreservedDataRoot := ExpandFileName(PreservedDataRoot);
  PersistentIdentityFile := PersistentIdentityPath(PreservedDataRoot);
  HasPreservedPgData := FileExists(AddBackslash(PreservedDataRoot) + 'pgdata\PG_VERSION');
  HasPersistentIdentity := FileExists(PersistentIdentityFile);
  if HasPersistentIdentity then
  begin
    HasFormalVersion := TryGetPersistentBackendVersionFloor(
      PreservedDataRoot,
      FormalVersion,
      PersistentIdentityFailure);
    if not HasFormalVersion then
    begin
      FailureReason :=
        '检测到保留的 PostgreSQL 数据或安装身份，但可信 version floor 缺失或损坏。' + #13#10 +
        PersistentIdentityFailure + #13#10 +
        '安装器已 fail closed，未读取服务/版本身份，也不会复制文件。';
      Result := False;
      exit;
    end;
  end
  else if HasPreservedPgData then
  begin
    HasFormalVersion := False;
    if (not RegQueryStringValue(
          HKLM64,
          'Software\Ticketbox',
          'DataRoot',
          RegisteredDataRoot)) or
       (CanonicalVersionGateInstallPath(RegisteredDataRoot) <>
        CanonicalVersionGateInstallPath(PreservedDataRoot)) then
    begin
      FailureReason :=
        '检测到没有持久安装身份的 PostgreSQL 数据，但 HKLM DataRoot 无法与所选数据目录绑定。' + #13#10 +
        '安装器已 fail closed，不会复制文件。';
      Result := False;
      exit;
    end;
    HasTrustedLegacyVersion := TryGetTrustedLegacyBackendVersion(
      LegacyVersion,
      LegacyFailureReason);
    HasExistingInstall := True;
    if not HasTrustedLegacyVersion then
    begin
      FailureReason :=
        '检测到旧版 PostgreSQL 数据，但稳定 AppId、产品名、安装目录和版本证据不完整。' + #13#10 +
        LegacyFailureReason + #13#10 +
        '安装器已 fail closed，不会复制文件。';
      Result := False;
      exit;
    end;
  end
  else
  begin
    HasFormalVersion := RegQueryStringValue(
      HKLM64,
      'Software\Ticketbox',
      'BackendVersion',
      FormalVersion);
  end;
  if (not HasFormalVersion) and (not HasTrustedLegacyVersion) then
  begin
    HasTrustedLegacyVersion := TryGetTrustedLegacyBackendVersion(
      LegacyVersion,
      LegacyFailureReason);
    HasExistingInstall :=
      HasExistingTicketboxInstallMarkers() or
      RegKeyExists(HKLM64, TicketboxLegacyUninstallKey());
  end;
  Result := EvaluateBackendVersionFloorDecision(
    '{#AppVersion}',
    HasFormalVersion,
    FormalVersion,
    HasTrustedLegacyVersion,
    LegacyVersion,
    HasExistingInstall,
    LegacyFailureReason,
    FailureReason);
end;

function CheckBackendVersionFloor(var FailureReason: String): Boolean;
begin
  Result := CheckBackendVersionFloorForDataRoot(
    PersistentIdentityDataRoot(),
    FailureReason);
end;

function InitializeSetup(): Boolean;
var
  VersionFailureReason: String;
begin
  InstallerSourceLeaseHandle := InvalidHandleValue;
  if not AcquireInstallerSourceLease() then
  begin
    MsgBox(
      '无法锁定当前小票夹安装包；安装尚未修改服务、数据或程序文件。请重新下载后再试。',
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;
  if WizardSilent then
  begin
    MsgBox(
      '当前版本尚未提供经过安全验收的无人值守安装合同。请使用交互式安装向导。',
      mbError,
      MB_OK);
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  LifecyclePrepared := False;
  LifecycleFilesMayBeReplaced := False;
  LifecycleInstallCompleted := False;
  ManagerMaintenanceOwnerRecord := '';
  InstallerLogSequence := 0;
  LastInstallerLogPath := '';
  DataRootGuardProcessId := 0;
  DataRootGuardProcessHandle := InvalidHandleValue;
  DataRootGuardProcessStartedFileTimeHigh := '';
  DataRootGuardProcessStartedFileTimeLow := '';
  DataRootGuardReadyPath := '';
  DataRootGuardReleasePath := '';
  DataRootGuardReleaseNonce := '';
  DataRootGuardScriptPath := '';
  DataRootGuardProcessStarted := False;
  DataRootGuardActive := False;
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockRootValidatedPath := '';
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleInstallerStateDirectory := '';
  LifecycleLockHolderScriptPath := '';
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  if not PrepareSetupLifecycleLockHolderScripts() then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  Result := AcquireLifecycleLock();
  if not Result then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    ReleaseLifecycleLock();
    CloseInstallerSourceLease();
    exit;
  end;
  if not CheckBackendVersionFloor(VersionFailureReason) then
  begin
    MsgBox(VersionFailureReason, mbError, MB_OK);
    ReleaseLifecycleLock();
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  Result := True;
end;

function InitializeUninstall(): Boolean;
begin
  ManagerMaintenanceOwnerRecord := '';
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockRootValidatedPath := '';
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleInstallerStateDirectory := '';
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  if not PrepareUninstallLifecycleLockHolderScript() then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    Result := False;
    exit;
  end;
  Result := AcquireLifecycleLock();
  if not Result then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    ReleaseLifecycleLock();
    exit;
  end;
  if not StartManagerMaintenanceGate() then
  begin
    MsgBox(
      '无法建立小票夹管理器维护门；卸载尚未修改服务或文件。请关闭其他安装器后重试。',
      mbError,
      MB_OK);
    CloseManagerMaintenanceGate();
    ReleaseLifecycleLock();
    Result := False;
  end;
end;

procedure DeinitializeUninstall();
begin
  ReleaseLifecycleLock();
  CloseManagerMaintenanceGate();
end;

function IsSupportedPowerShell7Host(PowerShellPath: String): Boolean;
var
  ResultCode: Integer;
  CommandText: String;
begin
  if not FileExists(PowerShellPath) then
  begin
    Result := False;
    exit;
  end;
  CommandText :=
    'if (($PSVersionTable.PSEdition -ceq ''Core'') -and ' +
    '([int]$PSVersionTable.PSVersion.Major -ge 7) -and ' +
    '[Environment]::Is64BitProcess) { exit 0 } else { exit 1 }';
  if not Exec(
    PowerShellPath,
    '-NoLogo -NoProfile -NonInteractive -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function IsProtectedProgramFilesPath(Value: String): Boolean;
var
  CanonicalValue: String;
  ProgramFilesRoot: String;
  ProgramFilesX86Root: String;
begin
  CanonicalValue := Uppercase(ExpandFileName(Value));
  ProgramFilesRoot := Uppercase(AddBackslash(ExpandFileName(ExpandConstant('{commonpf64}'))));
  ProgramFilesX86Root := Uppercase(AddBackslash(ExpandFileName(ExpandConstant('{commonpf32}'))));
  Result :=
    (Copy(CanonicalValue, 1, Length(ProgramFilesRoot)) = ProgramFilesRoot) or
    (Copy(CanonicalValue, 1, Length(ProgramFilesX86Root)) = ProgramFilesX86Root);
end;

function HasValidMicrosoftSignature(PowerShellPath: String): Boolean;
var
  ResultCode: Integer;
  CommandText: String;
  EscapedPath: String;
begin
  EscapedPath := PowerShellPath;
  StringChangeEx(EscapedPath, '''', '''''', True);
  CommandText :=
    '$s=Get-AuthenticodeSignature -LiteralPath ''' + EscapedPath + '''; ' +
    'if ($s.Status -eq ''Valid'' -and $s.SignerCertificate.Subject -match ''Microsoft Corporation'') ' +
    '{ exit 0 } else { exit 1 }';
  if not Exec(
    WindowsPowerShellExecutable(),
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function FindMachinePowerShell7(): String;
var
  VersionKeys: TArrayOfString;
  Index: Integer;
  InstallLocation: String;
  Candidate: String;
  VersionKey: String;
begin
  Result := '';
  if not RegGetSubkeyNames(
    HKLM64,
    'SOFTWARE\Microsoft\PowerShellCore\InstalledVersions',
    VersionKeys) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(VersionKeys) - 1 do
  begin
    VersionKey := 'SOFTWARE\Microsoft\PowerShellCore\InstalledVersions\' + VersionKeys[Index];
    if RegQueryStringValue(HKLM64, VersionKey, 'InstallLocation', InstallLocation) then
    begin
      Candidate := AddBackslash(InstallLocation) + 'pwsh.exe';
      if
        FileExists(Candidate) and
        IsProtectedProgramFilesPath(Candidate) and
        HasValidMicrosoftSignature(Candidate) and
        IsSupportedPowerShell7Host(Candidate) and
        ((Result = '') or (CompareText(ExpandFileName(Candidate), ExpandFileName(Result)) < 0)) then
      begin
        Result := Candidate;
      end;
    end;
  end;
end;

function PowerShellExecutable(): String;
var
  PowerShell7: String;
begin
  if SelectedPowerShellPath <> '' then
  begin
    Result := SelectedPowerShellPath;
    exit;
  end;
  PowerShell7 := FindMachinePowerShell7();
  if PowerShell7 <> '' then
  begin
    SelectedPowerShellPath := PowerShell7;
  end
  else
  begin
    SelectedPowerShellPath := WindowsPowerShellExecutable();
  end;
  Result := SelectedPowerShellPath;
end;

function PowerShellContextChinese(Context: String): String;
begin
  if CompareText(Context, 'Ticketbox pre-upgrade backup and service preparation') = 0 then
  begin
    Result := '升级前备份与服务检查';
  end
  else if CompareText(Context, 'Ticketbox service installation') = 0 then
  begin
    Result := '安装并验证小票夹服务';
  end
  else if CompareText(Context, 'Ticketbox program-files copy boundary') = 0 then
  begin
    Result := '持久化程序文件复制边界';
  end
  else if CompareText(Context, 'Ticketbox installer lifecycle commit') = 0 then
  begin
    Result := '提交安装生命周期';
  end
  else if CompareText(Context, 'Ticketbox failed-install recovery') = 0 then
  begin
    Result := '安装失败后的自动恢复';
  end
  else if CompareText(Context, 'Ticketbox service uninstall') = 0 then
  begin
    Result := '卸载并验证小票夹服务';
  end
  else if CompareText(Context, 'Ticketbox owner bootstrap handoff completion') = 0 then
  begin
    Result := '确认并清理首次绑定凭据';
  end
  else if CompareText(Context, 'Ticketbox DataRoot guard control recovery') = 0 then
  begin
    Result := '确认 DataRoot guard 启动失败已释放全部权威';
  end
  else
  begin
    Result := '安装子步骤（' + Context + '）';
  end;
end;

function PrepareProtectedInstallerLog(var LogPath: String): Boolean;
var
  LogDirectory: String;
  LogName: String;
begin
  Result := False;
  LogPath := '';
  LogDirectory := ExpandConstant('{commoncf64}\Ticketbox\installer-logs');
  if (not ForceDirectories(LogDirectory)) or
     (not HardenLifecycleLockPath(LogDirectory, True)) then
  begin
    exit;
  end;
  InstallerLogSequence := InstallerLogSequence + 1;
  LogName :=
    'installer-' + GetDateTimeString('yyyymmdd-hhnnss', #0, #0) + '-' +
    IntToStr(GetCurrentProcessId()) + '-' + IntToStr(InstallerLogSequence) + '.log';
  LogPath := AddBackslash(LogDirectory) + LogName;
  if (not SaveStringToFile(LogPath, '小票夹安装子步骤日志' + #13#10, False)) or
     (not HardenLifecycleLockPath(LogPath, False)) then
  begin
    DeleteFile(LogPath);
    LogPath := '';
    exit;
  end;
  LastInstallerLogPath := LogPath;
  Result := True;
end;

function EnsureLoggedPowerShellRunner(
  var RunnerPath: String;
  var RunnerSha256: String
): Boolean;
var
  RunnerText: String;
begin
  Result := False;
  RunnerSha256 := '';
  if LifecycleLockBootstrapDirectory = '' then
  begin
    exit;
  end;
  RunnerPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) +
    'ticketbox-run-installer-child-logged.ps1';
  RunnerText :=
    '#Requires -Version 5.1' + #13#10 +
    '[CmdletBinding()]' + #13#10 +
    'param(' + #13#10 +
    '    [Parameter(Mandatory=$true)][string]$TargetScript,' + #13#10 +
    '    [Parameter(Mandatory=$true)][string]$LogPath,' + #13#10 +
    '    [Parameter(ValueFromRemainingArguments=$true)][string[]]$TargetArguments' + #13#10 +
    ')' + #13#10 +
    '$ErrorActionPreference = "Stop"' + #13#10 +
    '$exitCode = 0' + #13#10 +
    '$transcriptStarted = $false' + #13#10 +
    'try {' + #13#10 +
    '    Start-Transcript -LiteralPath $LogPath -Append -Force | Out-Null' + #13#10 +
    '    $transcriptStarted = $true' + #13#10 +
    '    $command = Get-Command -Name $TargetScript -CommandType ExternalScript -ErrorAction Stop' + #13#10 +
    '    if ([IO.Path]::GetFullPath($command.Source) -ine [IO.Path]::GetFullPath($TargetScript)) { throw "Child script resolution mismatch." }' + #13#10 +
    '    $scriptName = [IO.Path]::GetFileName($command.Source)' + #13#10 +
    '    $allowedByScript = @{' + #13#10 +
    '        "hold_data_root_mutation_guard.ps1" = @("InstallDir","DataRoot","InstallerLockOwnerProcessId","Hold","ConfirmStopped","DataRootGuardReadyPath","DataRootGuardReleasePath","ExpectedHolderProcessId","ExpectedHolderStartedFileTimeHigh","ExpectedHolderStartedFileTimeLow","ExpectedNonce")' + #13#10 +
    '        "prepare_bundled_upgrade.ps1" = @("InstallDir","DataRoot","PgPort","BackendPort","TargetPgMajor","ReleaseConfigPath","InstalledReleaseConfigPath","LifecycleReceiptPath","InstallerLockOwnerProcessId","CommitCompletedInstall","MarkProgramFilesInstalledBackupPending","RecoverPreparedInstall","FilesReplaced")' + #13#10 +
    '        "install_bundled_services.ps1" = @("InstallDir","DataRoot","PgPort","BackendPort","TargetPgMajor","LifecycleReceiptPath","InstallerLockOwnerProcessId","CompleteOwnerHandoffOnly")' + #13#10 +
    '        "uninstall_bundled_services.ps1" = @("InstallDir","InstallerLockOwnerProcessId","DeleteData")' + #13#10 +
    '    }' + #13#10 +
    '    if (-not $allowedByScript.ContainsKey($scriptName)) { throw "Installer child script is not allowlisted: $scriptName" }' + #13#10 +
    '    $allowed = @{}' + #13#10 +
    '    foreach ($allowedName in $allowedByScript[$scriptName]) { $allowed[$allowedName] = $true }' + #13#10 +
    '    $bound = @{}' + #13#10 +
    '    for ($index = 0; $index -lt $TargetArguments.Count; $index++) {' + #13#10 +
    '        $token = $TargetArguments[$index]' + #13#10 +
    '        if (-not $token.StartsWith("-") -or $token.Length -lt 2) { throw "Unexpected child argument: $token" }' + #13#10 +
    '        $name = $token.Substring(1)' + #13#10 +
    '        if (-not $allowed.ContainsKey($name)) { throw "Child parameter is not allowlisted: $token" }' + #13#10 +
    '        if ($bound.ContainsKey($name)) { throw "Duplicate child parameter: $token" }' + #13#10 +
    '        if (-not $command.Parameters.ContainsKey($name)) { throw "Unknown child parameter: $token" }' + #13#10 +
    '        $metadata = $command.Parameters[$name]' + #13#10 +
    '        if ($metadata.ParameterType -eq [System.Management.Automation.SwitchParameter]) {' + #13#10 +
    '            $bound[$name] = $true' + #13#10 +
    '        } else {' + #13#10 +
    '            $index++' + #13#10 +
    '            if ($index -ge $TargetArguments.Count) { throw "Missing value for child parameter: $token" }' + #13#10 +
    '            $bound[$name] = $TargetArguments[$index]' + #13#10 +
    '        }' + #13#10 +
    '    }' + #13#10 +
    '    $global:LASTEXITCODE = 0' + #13#10 +
    '    & $TargetScript @bound' + #13#10 +
    '    if ($LASTEXITCODE -ne 0) { $exitCode = $LASTEXITCODE }' + #13#10 +
    '} catch {' + #13#10 +
    '    $exitCode = 1' + #13#10 +
    '    Write-Host ("ERROR: " + $_.Exception.Message)' + #13#10 +
    '    if ($_.ScriptStackTrace) { Write-Host $_.ScriptStackTrace }' + #13#10 +
    '} finally {' + #13#10 +
    '    if ($transcriptStarted) { try { Stop-Transcript | Out-Null } catch { } }' + #13#10 +
    '}' + #13#10 +
    'exit $exitCode' + #13#10;
  DeleteFile(RunnerPath);
  if (not SaveStringToFile(RunnerPath, RunnerText, False)) or
     (not HardenLifecycleLockPath(RunnerPath, False)) then
  begin
    DeleteFile(RunnerPath);
    exit;
  end;
  try
    RunnerSha256 := Lowercase(GetSHA256OfFile(RunnerPath));
  except
    RunnerSha256 := '';
  end;
  Result := RunnerSha256 <> '';
end;

function ValidateLoggedPowerShellRunner(
  RunnerPath: String;
  ExpectedSha256: String
): Boolean;
var
  ActualSha256: String;
begin
  Result := False;
  if (ExpectedSha256 = '') or (not FileExists(RunnerPath)) then
  begin
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(RunnerPath));
  except
    exit;
  end;
  Result := CompareText(ActualSha256, ExpectedSha256) = 0;
end;

function RunPowerShellChecked(ScriptPath: String; Arguments: String; Context: String): Boolean;
var
  ResultCode: Integer;
  Params: String;
  PowerShellPath: String;
  Started: Boolean;
  LogPath: String;
  RunnerPath: String;
  RunnerSha256: String;
  ChineseContext: String;
begin
  ChineseContext := PowerShellContextChinese(Context);
  LastPowerShellChildSucceeded := False;
  if not PrepareProtectedInstallerLog(LogPath) then
  begin
    MsgBox(
      '无法创建并收紧机器级安装日志，已拒绝运行 PowerShell 子脚本。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      '日志目录：' + ExpandConstant('{commoncf64}\Ticketbox\installer-logs'),
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;
  if not EnsureLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
  begin
    MsgBox(
      '无法创建 PowerShell 日志运行器，已拒绝继续。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      '日志：' + LogPath,
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;
  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + Quote(RunnerPath) +
    ' -TargetScript ' + Quote(ScriptPath) +
    ' -LogPath ' + Quote(LogPath) + ' ' + Arguments;
  PowerShellPath := PowerShellExecutable();
  if not ValidateLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
  begin
    MsgBox(
      '受保护 PowerShell 日志运行器在执行前完整性复核失败。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      '日志：' + LogPath,
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;
  Started := Exec(PowerShellPath, Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  if (not Started) and (CompareText(PowerShellPath, WindowsPowerShellExecutable()) <> 0) then
  begin
    if not ValidateLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
    begin
      MsgBox(
        '受保护 PowerShell 日志运行器在兼容宿主回退前完整性复核失败。',
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    Started := Exec(
      WindowsPowerShellExecutable(),
      Params,
      '',
      SW_HIDE,
      ewWaitUntilTerminated,
      ResultCode);
  end;
  DeleteFile(RunnerPath);
  if not Started then
  begin
    MsgBox(
      '无法启动 PowerShell，安装子步骤未执行。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      '日志：' + LogPath,
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;

  LastPowerShellChildSucceeded := ResultCode = 0;

  if CompareText(Context, 'Ticketbox installer lifecycle commit') = 0 then
  begin
    if ResultCode <> 0 then
    begin
      MsgBox(
        '小票夹安装生命周期最终提交失败。' + #13#10 +
        'PowerShell 退出码：' + IntToStr(ResultCode) + #13#10 +
        '详细日志：' + LogPath,
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
    Result := True;
    exit;
  end;

  if not HardenLifecycleLockPath(LogPath, False) then
  begin
    MsgBox(
      'PowerShell 子脚本已结束，但无法确认机器级日志权限，已按失败处理。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      '日志：' + LogPath,
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;

  if ResultCode <> 0 then
  begin
    MsgBox(
      '小票夹安装子步骤失败。' + #13#10 +
      '操作：' + ChineseContext + #13#10 +
      'PowerShell 退出码：' + IntToStr(ResultCode) + #13#10 +
      '详细日志：' + LogPath,
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;

  if CompareText(Context, 'Ticketbox service installation') = 0 then
  begin
    if not RegWriteStringValue(
      HKLM64,
      'Software\Ticketbox',
      'BackendVersion',
      '{#AppVersion}') then
    begin
      MsgBox(
        '服务已安装，但无法写入机器级 BackendVersion，无法建立防降级版本下限。' + #13#10 +
        '安装器已按失败处理。' + #13#10 +
        '日志：' + LogPath,
        mbError,
        MB_OK);
      Result := False;
      exit;
    end;
  end;

  Result := True;
end;

procedure ResetDataRootMutationGuardState();
begin
  if (DataRootGuardProcessHandle <> 0) and
     (DataRootGuardProcessHandle <> InvalidHandleValue) then
  begin
    CloseHandle(DataRootGuardProcessHandle);
  end;
  DeleteFile(DataRootGuardReadyPath);
  DeleteFile(DataRootGuardReleasePath);
  DeleteFile(DataRootGuardReleasePath + '.tmp');
  DataRootGuardProcessHandle := InvalidHandleValue;
  DataRootGuardProcessId := 0;
  DataRootGuardProcessStartedFileTimeHigh := '';
  DataRootGuardProcessStartedFileTimeLow := '';
  DataRootGuardReleaseNonce := '';
  DataRootGuardScriptPath := '';
  DataRootGuardProcessStarted := False;
  DataRootGuardActive := False;
end;

function PersistDataRootGuardControl(ControlState: String): Boolean;
var
  ControlTempPath: String;
  ControlText: String;
begin
  Result := False;
  if (CompareText(ControlState, 'release') = 0) and
     (not IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce)) then
  begin
    exit;
  end;
  if (CompareText(ControlState, 'release') = 0) then
  begin
    ControlText :=
      'STATE=release' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'NONCE=' + DataRootGuardReleaseNonce + #13#10;
  end
  else if CompareText(ControlState, 'abort') = 0 then
  begin
    ControlText :=
      'STATE=abort' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  end
  else
  begin
    exit;
  end;
  ControlTempPath := DataRootGuardReleasePath + '.tmp';
  DeleteFile(ControlTempPath);
  if FileExists(DataRootGuardReleasePath) then
  begin
    exit;
  end;
  Result :=
    SaveStringToFile(ControlTempPath, ControlText, False) and
    HardenLifecycleLockPath(ControlTempPath, False) and
    RenameFile(ControlTempPath, DataRootGuardReleasePath);
  if not Result then
  begin
    DeleteFile(ControlTempPath);
  end;
end;

function DataRootGuardStoppedAcknowledged(): Boolean;
var
  AckText: AnsiString;
  ExpectedAck: String;
begin
  Result := False;
  if not FileExists(DataRootGuardReleasePath) then
  begin
    exit;
  end;
  if not LoadStringFromFile(DataRootGuardReleasePath, AckText) then
  begin
    exit;
  end;
  ExpectedAck :=
    'STATE=stopped' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  Result := String(AckText) = ExpectedAck;
end;

function WaitForDataRootGuardStoppedAcknowledgement(): Boolean;
var
  Attempt: Integer;
begin
  Result := False;
  for Attempt := 1 to 100 do
  begin
    if DataRootGuardStoppedAcknowledged() then
    begin
      Result := True;
      exit;
    end;
    Sleep(100);
  end;
end;

function ConfirmDataRootGuardStoppedAfterControlFailure(): Boolean;
var
  Args: String;
begin
  Result := False;
  if (DataRootGuardScriptPath = '') or
     (DataRootGuardReadyPath = '') or
     (DataRootGuardReleasePath = '') then
  begin
    exit;
  end;
  if not ValidateLifecycleLockBootstrapFiles() then
  begin
    Log('DataRoot guard recovery refused a changed lifecycle bootstrap bundle.');
    exit;
  end;
  Args :=
    '-InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
    ' -ConfirmStopped' +
    ' -DataRootGuardReadyPath ' + Quote(DataRootGuardReadyPath) +
    ' -DataRootGuardReleasePath ' + Quote(DataRootGuardReleasePath);
  if (DataRootGuardProcessId > 0) and
     (DataRootGuardProcessStartedFileTimeHigh <> '') and
     (DataRootGuardProcessStartedFileTimeLow <> '') and
     IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce) then
  begin
    Args := Args +
      ' -ExpectedHolderProcessId ' + IntToStr(DataRootGuardProcessId) +
      ' -ExpectedHolderStartedFileTimeHigh ' + DataRootGuardProcessStartedFileTimeHigh +
      ' -ExpectedHolderStartedFileTimeLow ' + DataRootGuardProcessStartedFileTimeLow +
      ' -ExpectedNonce ' + DataRootGuardReleaseNonce;
  end;
  if not RunPowerShellChecked(
    DataRootGuardScriptPath,
    Args,
    'Ticketbox DataRoot guard control recovery') then
  begin
    exit;
  end;
  Result := DataRootGuardStoppedAcknowledged();
end;

function AbortDataRootMutationGuardStartup(): Boolean;
begin
  Result := False;
  if not DataRootGuardProcessStarted then
  begin
    Result := True;
    exit;
  end;
  if DataRootGuardStoppedAcknowledged() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  if not PersistDataRootGuardControl('abort') then
  begin
    if DataRootGuardStoppedAcknowledged() then
    begin
      ResetDataRootMutationGuardState();
      Result := True;
      exit;
    end;
    if ConfirmDataRootGuardStoppedAfterControlFailure() then
    begin
      ResetDataRootMutationGuardState();
      Result := True;
      exit;
    end;
    Log('Could not persist DataRoot guard startup abort; keeping local holder state fail closed.');
    exit;
  end;
  if WaitForDataRootGuardStoppedAcknowledgement() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  if ConfirmDataRootGuardStoppedAfterControlFailure() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  Log('DataRoot guard startup abort was not acknowledged and inactivity could not be proven; keeping local holder state fail closed.');
end;

function StartDataRootMutationGuard(
  ScriptPath: String;
  InstallDir: String;
  DataRoot: String
): Boolean;
var
  Params: String;
  PowerShellPath: String;
  ResultCode: Integer;
  Started: Boolean;
  Attempt: Integer;
  ReadyText: AnsiString;
  ReadyPrefix: String;
  ReadyRemainder: String;
  HolderIdentityRemainder: String;
  HolderStartedHighDelimiter: String;
  HolderStartedLowDelimiter: String;
  NonceDelimiter: String;
  HolderProcessIdText: String;
  HolderStartedFileTimeHighText: String;
  HolderStartedFileTimeLowText: String;
  HolderDelimiterPosition: Integer;
  NonceDelimiterPosition: Integer;
  ParsedHolderProcessId: Integer;
  ReadyValue: String;
  ExpectedReadyText: String;
begin
  Result := False;
  if DataRootGuardProcessStarted and
     (not AbortDataRootMutationGuardStartup()) then
  begin
    MsgBox('上一轮 DataRoot guard 尚未证明停止，拒绝在同一安装生命周期重复获取。', mbError, MB_OK);
    exit;
  end;
  DataRootGuardScriptPath := ScriptPath;
  DataRootGuardReadyPath :=
    ExpandConstant('{commoncf64}\Ticketbox\data-root-guard-') +
    IntToStr(LifecycleLockOwnerProcessId) + '.ready';
  DataRootGuardReleasePath :=
    ExpandConstant('{commoncf64}\Ticketbox\data-root-guard-') +
    IntToStr(LifecycleLockOwnerProcessId) + '.release';
  if FileExists(DataRootGuardReadyPath) or FileExists(DataRootGuardReleasePath) then
  begin
    MsgBox('检测到当前 PID 对应的过期 DataRoot guard artifact，已拒绝复用。', mbError, MB_OK);
    exit;
  end;

  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + Quote(ScriptPath) +
    ' -InstallDir ' + Quote(InstallDir) +
    ' -DataRoot ' + Quote(DataRoot) +
    ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
    ' -Hold' +
    ' -DataRootGuardReadyPath ' + Quote(DataRootGuardReadyPath) +
    ' -DataRootGuardReleasePath ' + Quote(DataRootGuardReleasePath);
  PowerShellPath := PowerShellExecutable();
  Started := Exec(PowerShellPath, Params, '', SW_HIDE, ewNoWait, ResultCode);
  if (not Started) and (CompareText(PowerShellPath, WindowsPowerShellExecutable()) <> 0) then
  begin
    Started := Exec(
      WindowsPowerShellExecutable(),
      Params,
      '',
      SW_HIDE,
      ewNoWait,
      ResultCode);
  end;
  if not Started then
  begin
    MsgBox('无法启动持续 DataRoot guard 进程，安装尚未进入复制前阶段。', mbError, MB_OK);
    exit;
  end;

  DataRootGuardProcessStarted := True;
  try
    ReadyPrefix :=
      'STATE=holding' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'HOLDER_PID=';
    HolderStartedHighDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_HIGH=';
    HolderStartedLowDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_LOW=';
    NonceDelimiter := #13#10 + 'NONCE=';
    for Attempt := 1 to 300 do
    begin
      if FileExists(DataRootGuardReadyPath) then
      begin
        if not LoadStringFromFile(DataRootGuardReadyPath, ReadyText) then
        begin
          MsgBox('无法读取 DataRoot guard ready artifact。', mbError, MB_OK);
          exit;
        end;
        ReadyValue := String(ReadyText);
        if Copy(ReadyValue, 1, Length(ReadyPrefix)) <> ReadyPrefix then
        begin
          MsgBox('DataRoot guard ready artifact 与当前安装器身份不匹配。', mbError, MB_OK);
          exit;
        end;
        ReadyRemainder := Copy(
          ReadyValue,
          Length(ReadyPrefix) + 1,
          Length(ReadyValue));
        HolderDelimiterPosition := Pos(HolderStartedHighDelimiter, ReadyRemainder);
        if HolderDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder PID。', mbError, MB_OK);
          exit;
        end;
        HolderProcessIdText := Copy(
          ReadyRemainder,
          1,
          HolderDelimiterPosition - 1);
        ParsedHolderProcessId := StrToIntDef(HolderProcessIdText, 0);
        if (ParsedHolderProcessId <= 0) or
           (IntToStr(ParsedHolderProcessId) <> HolderProcessIdText) then
        begin
          MsgBox('DataRoot guard ready artifact 的 holder PID 无效。', mbError, MB_OK);
          exit;
        end;
        HolderIdentityRemainder := Copy(
          ReadyRemainder,
          HolderDelimiterPosition + Length(HolderStartedHighDelimiter),
          Length(ReadyRemainder));
        NonceDelimiterPosition := Pos(HolderStartedLowDelimiter, HolderIdentityRemainder);
        if NonceDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder 创建时间高位。', mbError, MB_OK);
          exit;
        end;
        HolderStartedFileTimeHighText := Copy(
          HolderIdentityRemainder,
          1,
          NonceDelimiterPosition - 1);
        HolderIdentityRemainder := Copy(
          HolderIdentityRemainder,
          NonceDelimiterPosition + Length(HolderStartedLowDelimiter),
          Length(HolderIdentityRemainder));
        NonceDelimiterPosition := Pos(NonceDelimiter, HolderIdentityRemainder);
        if NonceDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder 创建时间低位。', mbError, MB_OK);
          exit;
        end;
        HolderStartedFileTimeLowText := Copy(
          HolderIdentityRemainder,
          1,
          NonceDelimiterPosition - 1);
        DataRootGuardReleaseNonce := Copy(
          HolderIdentityRemainder,
          NonceDelimiterPosition + Length(NonceDelimiter),
          64);
        ExpectedReadyText :=
          ReadyPrefix + HolderProcessIdText + HolderStartedHighDelimiter +
          HolderStartedFileTimeHighText + HolderStartedLowDelimiter +
          HolderStartedFileTimeLowText + NonceDelimiter +
          DataRootGuardReleaseNonce + #13#10;
        if (ReadyValue <> ExpectedReadyText) or
           (not IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce)) then
        begin
          DataRootGuardReleaseNonce := '';
          MsgBox('DataRoot guard ready artifact 的随机挑战无效。', mbError, MB_OK);
          exit;
        end;
        DataRootGuardProcessId := LongWord(ParsedHolderProcessId);
        DataRootGuardProcessStartedFileTimeHigh := HolderStartedFileTimeHighText;
        DataRootGuardProcessStartedFileTimeLow := HolderStartedFileTimeLowText;
        DataRootGuardProcessHandle := OpenVerifiedProcessIdentityHandle(
          DataRootGuardProcessId,
          HolderStartedFileTimeHighText,
          HolderStartedFileTimeLowText);
        if not IsProcessHandleRunning(DataRootGuardProcessHandle) then
        begin
          MsgBox(
            'DataRoot guard 的 PID/创建时间与 ready artifact 不匹配或进程已退出。',
            mbError,
            MB_OK);
          exit;
        end;
        DataRootGuardActive := True;
        Result := True;
        exit;
      end;
      Sleep(100);
    end;
    MsgBox('DataRoot guard 未在 30 秒内就绪，安装尚未进入复制前阶段。', mbError, MB_OK);
  finally
    if (not Result) and (not AbortDataRootMutationGuardStartup()) then
    begin
      Log('DataRoot guard startup could not be rolled back in-process; retry remains blocked until Setup exits.');
    end;
  end;
end;

procedure AssertDataRootMutationGuardActive();
begin
  if (not DataRootGuardActive) or
     (not IsProcessHandleRunning(DataRootGuardProcessHandle)) then
  begin
    RaiseException('DataRoot guard lease 未持续持有，拒绝继续安装生命周期 mutation。');
  end;
end;

procedure ReleaseDataRootMutationGuard();
begin
  if not DataRootGuardProcessStarted then
  begin
    exit;
  end;
  if not DataRootGuardActive then
  begin
    AbortDataRootMutationGuardStartup();
    exit;
  end;
  if DataRootGuardStoppedAcknowledged() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  if not PersistDataRootGuardControl('release') then
  begin
    if DataRootGuardStoppedAcknowledged() or
       ConfirmDataRootGuardStoppedAfterControlFailure() then
    begin
      ResetDataRootMutationGuardState();
      exit;
    end;
    Log('Could not persist the DataRoot guard release artifact; keeping local state fail closed.');
    exit;
  end;
  if WaitForDataRootGuardStoppedAcknowledgement() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  if ConfirmDataRootGuardStoppedAfterControlFailure() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  Log('DataRoot guard release was not acknowledged and stopped authority could not be proven; keeping local state fail closed.');
end;
