function CloseHandle(Handle: LongWord): Boolean;
  external 'CloseHandle@kernel32.dll stdcall';
function GetCurrentProcessId(): LongWord;
  external 'GetCurrentProcessId@kernel32.dll stdcall';
function GetLastError(): LongWord;
  external 'GetLastError@kernel32.dll stdcall';
procedure SetLastError(ErrorCode: LongWord);
  external 'SetLastError@kernel32.dll stdcall';
function OpenTicketboxScManager(
  MachineName: LongWord;
  DatabaseName: LongWord;
  DesiredAccess: LongWord
): LongWord;
  external 'OpenSCManagerW@advapi32.dll stdcall';
function OpenTicketboxService(
  ServiceManager: LongWord;
  ServiceName: String;
  DesiredAccess: LongWord
): LongWord;
  external 'OpenServiceW@advapi32.dll stdcall';
function CloseTicketboxServiceHandle(Handle: LongWord): Boolean;
  external 'CloseServiceHandle@advapi32.dll stdcall';
function CreateFileForLease(
  FileName: String;
  DesiredAccess: LongWord;
  ShareMode: LongWord;
  SecurityAttributes: LongWord;
  CreationDisposition: LongWord;
  FlagsAndAttributes: LongWord;
  TemplateFile: LongWord
): LongWord;
  external 'CreateFileW@kernel32.dll stdcall';
function OpenProcess(
  DesiredAccess: LongWord;
  InheritHandle: Boolean;
  ProcessId: LongWord
): LongWord;
  external 'OpenProcess@kernel32.dll stdcall';
function WaitForSingleObject(Handle: LongWord; Milliseconds: LongWord): LongWord;
  external 'WaitForSingleObject@kernel32.dll stdcall';
function GetProcessTimes(
  ProcessHandle: LongWord;
  var CreationTime: TTicketboxFileTime;
  var ExitTime: TTicketboxFileTime;
  var KernelTime: TTicketboxFileTime;
  var UserTime: TTicketboxFileTime
): Boolean;
  external 'GetProcessTimes@kernel32.dll stdcall';

function TicketboxServiceExistsNative(ServiceName: String): Boolean;
var
  ServiceManager: LongWord;
  ServiceHandle: LongWord;
  ErrorCode: LongWord;
begin
  { Treat SCM access failures as an existing marker so preflight fails closed. }
  Result := True;
  ServiceManager := OpenTicketboxScManager(0, 0, ScManagerConnect);
  if ServiceManager = 0 then
  begin
    Log('Could not open the local SCM for a read-only service existence check.');
    exit;
  end;
  try
    SetLastError(0);
    ServiceHandle := OpenTicketboxService(
      ServiceManager,
      ServiceName,
      ServiceQueryStatus);
    if ServiceHandle <> 0 then
    begin
      CloseTicketboxServiceHandle(ServiceHandle);
      Result := True;
    end
    else
    begin
      ErrorCode := GetLastError();
      Result := ErrorCode <> ErrorServiceDoesNotExist;
      if Result then
      begin
        Log('SCM service existence check failed closed; error=' + IntToStr(ErrorCode));
      end;
    end;
  finally
    CloseTicketboxServiceHandle(ServiceManager);
  end;
end;

procedure CloseInstallerSourceLease();
begin
  if (InstallerSourceLeaseHandle <> 0) and
     (InstallerSourceLeaseHandle <> InvalidHandleValue) then
  begin
    CloseHandle(InstallerSourceLeaseHandle);
  end;
  InstallerSourceLeaseHandle := InvalidHandleValue;
end;

function AcquireInstallerSourceLease(): Boolean;
begin
  InstallerSourceLeaseHandle := CreateFileForLease(
    ExpandConstant('{srcexe}'),
    GenericRead,
    FileShareRead,
    0,
    OpenExisting,
    FileAttributeNormal,
    0);
  if (InstallerSourceLeaseHandle = 0) or
     (InstallerSourceLeaseHandle = InvalidHandleValue) then
  begin
    Log('Could not acquire the installer source file lease.');
    Result := False;
    exit;
  end;
  Result := True;
end;

function BuildManagerMaintenanceOwnerRecord(): String;
begin
  Result :=
    ManagerMaintenanceRecordSchema + '|' +
    IntToStr(LifecycleLockOwnerProcessId) + '|' +
    LifecycleLockOwnerStartedFileTimeHigh + '|' +
    LifecycleLockOwnerStartedFileTimeLow;
end;

function StartManagerMaintenanceGate(): Boolean;
var
  Persisted: String;
begin
  if ManagerMaintenanceOwnerRecord <> '' then
  begin
    Result :=
      RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted) and
      (Persisted = ManagerMaintenanceOwnerRecord);
    exit;
  end;
  if (LifecycleLockOwnerProcessId = 0) or
     (LifecycleLockOwnerStartedFileTimeHigh = '') or
     (LifecycleLockOwnerStartedFileTimeLow = '') then
  begin
    Log('Lifecycle owner identity is unavailable for the Manager maintenance marker.');
    Result := False;
    exit;
  end;
  ManagerMaintenanceOwnerRecord := BuildManagerMaintenanceOwnerRecord();
  if not RegWriteStringValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue,
    ManagerMaintenanceOwnerRecord) then
  begin
    ManagerMaintenanceOwnerRecord := '';
    Log('Could not publish the Manager maintenance owner marker.');
    Result := False;
    exit;
  end;
  if (not RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted)) or
     (Persisted <> ManagerMaintenanceOwnerRecord) then
  begin
    ManagerMaintenanceOwnerRecord := '';
    Log('The Manager maintenance owner marker failed post-write verification.');
    Result := False;
    exit;
  end;
  Result := True;
end;

function ManagerMaintenanceGateActive(): Boolean;
var
  Persisted: String;
begin
  Result :=
    (ManagerMaintenanceOwnerRecord <> '') and
    RegQueryStringValue(
      HKLM64,
      ManagerMaintenanceRegistryPath,
      ManagerMaintenanceRegistryValue,
      Persisted) and
    (Persisted = ManagerMaintenanceOwnerRecord);
end;

procedure AssertManagerMaintenanceGateActive();
begin
  if not ManagerMaintenanceGateActive() then
  begin
    RaiseException('Manager maintenance gate is not active.');
  end;
end;

function ReleaseManagerMaintenanceGate(): Boolean;
var
  Persisted: String;
begin
  Result := True;
  if ManagerMaintenanceOwnerRecord = '' then
  begin
    exit;
  end;
  if (not RegQueryStringValue(
        HKLM64,
        ManagerMaintenanceRegistryPath,
        ManagerMaintenanceRegistryValue,
        Persisted)) or
     (Persisted <> ManagerMaintenanceOwnerRecord) then
  begin
    Result := False;
    exit;
  end;
  if not RegDeleteValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue) then
  begin
    Result := False;
    exit;
  end;
  if RegQueryStringValue(
    HKLM64,
    ManagerMaintenanceRegistryPath,
    ManagerMaintenanceRegistryValue,
    Persisted) then
  begin
    Result := False;
    exit;
  end;
  ManagerMaintenanceOwnerRecord := '';
end;

procedure CloseManagerMaintenanceGate();
var
  Persisted: String;
begin
  if (ManagerMaintenanceOwnerRecord <> '') and
     RegQueryStringValue(
       HKLM64,
       ManagerMaintenanceRegistryPath,
       ManagerMaintenanceRegistryValue,
       Persisted) and
     (Persisted = ManagerMaintenanceOwnerRecord) then
  begin
    RegDeleteValue(
      HKLM64,
      ManagerMaintenanceRegistryPath,
      ManagerMaintenanceRegistryValue);
  end;
  ManagerMaintenanceOwnerRecord := '';
end;

function IsProcessHandleRunning(Handle: LongWord): Boolean;
begin
  Result := False;
  if (Handle = 0) or (Handle = InvalidHandleValue) then
  begin
    exit;
  end;
  Result := WaitForSingleObject(Handle, 0) = WaitTimeout;
end;

function ReadProcessStartedFileTime(
  Handle: LongWord;
  var HighText: String;
  var LowText: String
): Boolean;
var
  CreationTime: TTicketboxFileTime;
  ExitTime: TTicketboxFileTime;
  KernelTime: TTicketboxFileTime;
  UserTime: TTicketboxFileTime;
begin
  Result := False;
  HighText := '';
  LowText := '';
  if (Handle = 0) or (Handle = InvalidHandleValue) then
  begin
    exit;
  end;
  if not GetProcessTimes(
    Handle,
    CreationTime,
    ExitTime,
    KernelTime,
    UserTime) then
  begin
    exit;
  end;
  HighText := IntToStr(Int64(CreationTime.HighDateTime));
  LowText := IntToStr(Int64(CreationTime.LowDateTime));
  Result := True;
end;

function ProcessHandleMatchesStartedFileTime(
  Handle: LongWord;
  ExpectedHighText: String;
  ExpectedLowText: String
): Boolean;
var
  ActualHighText: String;
  ActualLowText: String;
begin
  Result :=
    ReadProcessStartedFileTime(Handle, ActualHighText, ActualLowText) and
    (ActualHighText = ExpectedHighText) and
    (ActualLowText = ExpectedLowText);
end;

function OpenVerifiedProcessIdentityHandle(
  ProcessId: LongWord;
  ExpectedHighText: String;
  ExpectedLowText: String
): LongWord;
var
  ProcessHandle: LongWord;
begin
  Result := InvalidHandleValue;
  ProcessHandle := OpenProcess(
    ProcessSynchronize or ProcessQueryLimitedInformation,
    False,
    ProcessId);
  if not IsProcessHandleRunning(ProcessHandle) or
     not ProcessHandleMatchesStartedFileTime(
       ProcessHandle,
       ExpectedHighText,
       ExpectedLowText) then
  begin
    if (ProcessHandle <> 0) and (ProcessHandle <> InvalidHandleValue) then
    begin
      CloseHandle(ProcessHandle);
    end;
    exit;
  end;
  Result := ProcessHandle;
end;

function Quote(Value: String): String;
var
  Index: Integer;
begin
  if (Pos('"', Value) > 0) or (Pos(#0, Value) > 0) or
     (Pos(#13, Value) > 0) or (Pos(#10, Value) > 0) then
  begin
    RaiseException('Windows command arguments cannot contain quotes or newlines.');
  end;
  Result := '"' + Value;
  Index := Length(Value);
  while (Index > 0) and (Value[Index] = '\') do
  begin
    Result := Result + '\';
    Index := Index - 1;
  end;
  Result := Result + '"';
end;

function WindowsPowerShellExecutable(): String;
begin
  Result := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
end;

function RunLifecycleIcacls(TargetPath: String; Arguments: String): Boolean;
var
  ResultCode: Integer;
begin
  if not Exec(
    ExpandConstant('{sys}\icacls.exe'),
    Quote(TargetPath) + ' ' + Arguments,
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function HardenLifecycleLockPath(TargetPath: String; IsDirectory: Boolean): Boolean;
var
  GrantArguments: String;
begin
  if IsDirectory then
  begin
    GrantArguments := '/grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F"';
  end
  else
  begin
    GrantArguments := '/grant:r "*S-1-5-18:F" "*S-1-5-32-544:F"';
  end;
  Result :=
    RunLifecycleIcacls(TargetPath, '/reset') and
    RunLifecycleIcacls(TargetPath, GrantArguments) and
    RunLifecycleIcacls(TargetPath, '/inheritance:r') and
    RunLifecycleIcacls(TargetPath, '/setowner *S-1-5-18') and
    RunLifecycleIcacls(TargetPath, '/verify');
end;

procedure CleanupLifecycleLockBootstrapDirectory();
begin
  if LifecycleLockBootstrapDirectory = '' then
  begin
    LifecycleLockRootValidatedPath := '';
    LifecycleLockBootstrapFilesStaged := False;
    exit;
  end;
  if LifecycleLockRootValidatedPath <> '' then
  begin
    DeleteFile(LifecycleLockRootValidatedPath);
  end;
  if LifecycleLockHolderFailurePath <> '' then
  begin
    DeleteFile(LifecycleLockHolderFailurePath);
  end;
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_installer_lifecycle_lock.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'install_windows_prerequisites.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'vc_redist.x64.exe');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_lifecycle_lock.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_installation_safety.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_security_primitives.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\byte_array.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\token_privilege_native.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\token_privilege.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\descriptor_comparison.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\descriptor_diagnostic.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives\file_security.ps1');
  RemoveDir(AddBackslash(LifecycleLockBootstrapDirectory) + 'security_primitives');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_data_root_mutation_guard.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'prepare_bundled_upgrade.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_service_contract.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_service_identity.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_service_lifecycle.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_lifecycle_receipt.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_database_safety.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_pg_recovery_tools.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_release_config.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows-release-config.json');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_build_provenance.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_backend_build_provenance.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_database_generation.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_database_generation_contract.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'windows_database_generation_artifacts.ps1');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'DATABASE_GENERATION_PROGRAM.json');
  DeleteFile(AddBackslash(LifecycleLockBootstrapDirectory) + 'ticketbox-run-installer-child-logged.ps1');
  if DirExists(LifecycleLockBootstrapDirectory) and
     (not RemoveDir(LifecycleLockBootstrapDirectory)) then
  begin
    Log('Could not remove the protected lifecycle bootstrap directory; it contains no authority state.');
  end;
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockRootValidatedPath := '';
  LifecycleLockHolderFailurePath := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderScriptPath := '';
end;

function StageLifecycleLockBootstrapFileAs(
  EmbeddedFileName: String;
  ProtectedFileName: String;
  ExpectedSha256: String
): Boolean;
var
  ExtractedPath: String;
  ProtectedPath: String;
  ProtectedDirectory: String;
  ActualSha256: String;
begin
  Result := False;
  try
    ExtractTemporaryFile(EmbeddedFileName);
  except
    LifecycleLockError :=
      '无法从安装器内嵌 payload 提取 lifecycle bootstrap 文件 ' +
      EmbeddedFileName +
      '：' + GetExceptionMessage();
    exit;
  end;
  ExtractedPath := ExpandConstant('{tmp}\') + EmbeddedFileName;
  ProtectedPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) + ProtectedFileName;
  ProtectedDirectory := ExtractFileDir(ProtectedPath);
  if CompareText(ProtectedDirectory, LifecycleLockBootstrapDirectory) <> 0 then
  begin
    if not ForceDirectories(ProtectedDirectory) then
    begin
      LifecycleLockError :=
        '无法创建 lifecycle bootstrap 组件目录：' + ProtectedFileName;
      exit;
    end;
    if not HardenLifecycleLockPath(ProtectedDirectory, True) then
    begin
      LifecycleLockError :=
        '无法收紧 lifecycle bootstrap 组件目录 ACL：' + ProtectedFileName;
      exit;
    end;
  end;
  if not CopyFile(ExtractedPath, ProtectedPath, True) then
  begin
    LifecycleLockError :=
      '无法把 lifecycle bootstrap 文件复制到受保护 staging：' +
      ProtectedFileName;
    exit;
  end;
  if not HardenLifecycleLockPath(ProtectedPath, False) then
  begin
    LifecycleLockError :=
      '无法收紧 lifecycle bootstrap 文件 ACL：' + ProtectedFileName;
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(ProtectedPath));
  except
    LifecycleLockError :=
      '无法计算受保护 lifecycle bootstrap 文件 SHA-256：' +
      ProtectedFileName;
    exit;
  end;
  if CompareText(ActualSha256, ExpectedSha256) <> 0 then
  begin
    LifecycleLockError :=
      '受保护 lifecycle bootstrap 文件与构建时 SHA-256 不匹配：' +
      ProtectedFileName;
    exit;
  end;
  Result := True;
end;

function StageLifecycleLockBootstrapFile(
  FileName: String;
  ExpectedSha256: String
): Boolean;
begin
  Result := StageLifecycleLockBootstrapFileAs(
    FileName,
    FileName,
    ExpectedSha256);
end;

function ValidateLifecycleLockBootstrapFile(
  FileName: String;
  ExpectedSha256: String
): Boolean;
var
  FilePath: String;
  ActualSha256: String;
begin
  Result := False;
  if LifecycleLockBootstrapDirectory = '' then
  begin
    exit;
  end;
  FilePath := AddBackslash(LifecycleLockBootstrapDirectory) + FileName;
  if not FileExists(FilePath) then
  begin
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(FilePath));
  except
    exit;
  end;
  Result := CompareText(ActualSha256, ExpectedSha256) = 0;
end;

function ValidateLifecycleLockBootstrapFiles(): Boolean;
begin
  Result :=
    ValidateLifecycleLockBootstrapFile(
      'windows_installation_safety.ps1', LifecycleSafetyScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_security_primitives.ps1',
      WindowsSecurityPrimitivesScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\byte_array.ps1',
      WindowsSecurityByteArrayScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\token_privilege_native.ps1',
      WindowsSecurityTokenPrivilegeNativeScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\token_privilege.ps1',
      WindowsSecurityTokenPrivilegeScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\descriptor_comparison.ps1',
      WindowsSecurityDescriptorComparisonScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\descriptor_diagnostic.ps1',
      WindowsSecurityDescriptorDiagnosticScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'security_primitives\file_security.ps1',
      WindowsSecurityFileSecurityScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_lifecycle_lock.ps1', LifecycleLockScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'hold_installer_lifecycle_lock.ps1', LifecycleHolderScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'install_windows_prerequisites.ps1', WindowsPrerequisiteScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'vc_redist.x64.exe', VisualCppRuntimeSha256) and
    ValidateLifecycleLockBootstrapFile(
      'hold_data_root_mutation_guard.ps1', DataRootGuardScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'prepare_bundled_upgrade.ps1', PrepareScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_service_contract.ps1', ServiceContractScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_service_identity.ps1', ServiceIdentityScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_service_lifecycle.ps1', ServiceLifecycleScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_lifecycle_receipt.ps1', LifecycleReceiptScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_database_safety.ps1', DatabaseSafetyScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_pg_recovery_tools.ps1', PgRecoveryToolsScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_release_config.ps1', ReleaseConfigScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows-release-config.json', ReleaseConfigJsonSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_build_provenance.ps1', BuildProvenanceScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_backend_build_provenance.ps1', BackendBuildProvenanceScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_database_generation.ps1', DatabaseGenerationScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_database_generation_contract.ps1',
      DatabaseGenerationContractScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'windows_database_generation_artifacts.ps1',
      DatabaseGenerationArtifactsScriptSha256) and
    ValidateLifecycleLockBootstrapFile(
      'DATABASE_GENERATION_PROGRAM.json', DatabaseGenerationProgramSha256);
end;

function LifecycleBootstrapFilePath(FileName: String): String;
begin
  if LifecycleLockBootstrapDirectory = '' then
  begin
    RaiseException('受保护 lifecycle bootstrap staging 尚未建立。');
  end;
  Result := AddBackslash(LifecycleLockBootstrapDirectory) + FileName;
end;

function LifecycleInstallerStatePath(FileName: String): String;
begin
  if LifecycleInstallerStateDirectory = '' then
  begin
    RaiseException('机器级安装锁 holder 尚未声明 installer state 路径。');
  end;
  Result := AddBackslash(LifecycleInstallerStateDirectory) + FileName;
end;

function PrepareLifecycleLockBootstrapDirectory(): Boolean;
begin
  Result := False;
  LifecycleLockError := '';
  LifecycleLockBootstrapDirectory :=
    ExpandConstant('{commoncf64}\Ticketbox-Installer-Bootstrap-') +
    IntToStr(GetCurrentProcessId());
  if FileOrDirExists(LifecycleLockBootstrapDirectory) then
  begin
    LifecycleLockError :=
      '检测到同 PID 的旧 lifecycle bootstrap staging，拒绝复用：' +
      LifecycleLockBootstrapDirectory;
    exit;
  end;
  if not CreateDir(LifecycleLockBootstrapDirectory) then
  begin
    LifecycleLockError := '无法创建 lifecycle bootstrap staging。';
    exit;
  end;
  if not HardenLifecycleLockPath(LifecycleLockBootstrapDirectory, True) then
  begin
    LifecycleLockError := '无法收紧 lifecycle bootstrap staging ACL。';
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  Result := True;
end;

function PrepareSetupLifecycleLockHolderScripts(): Boolean;
begin
  Result := False;
  if not PrepareLifecycleLockBootstrapDirectory() then
  begin
    exit;
  end;
  if not StageLifecycleLockBootstrapFile(
    'windows_installation_safety.ps1',
    LifecycleSafetyScriptSha256) or
     not StageLifecycleLockBootstrapFile(
       'windows_security_primitives.ps1',
       WindowsSecurityPrimitivesScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-byte-array.ps1',
       'security_primitives\byte_array.ps1',
       WindowsSecurityByteArrayScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-token-privilege-native.ps1',
       'security_primitives\token_privilege_native.ps1',
       WindowsSecurityTokenPrivilegeNativeScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-token-privilege.ps1',
       'security_primitives\token_privilege.ps1',
       WindowsSecurityTokenPrivilegeScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-descriptor-comparison.ps1',
       'security_primitives\descriptor_comparison.ps1',
       WindowsSecurityDescriptorComparisonScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-descriptor-diagnostic.ps1',
       'security_primitives\descriptor_diagnostic.ps1',
       WindowsSecurityDescriptorDiagnosticScriptSha256) or
     not StageLifecycleLockBootstrapFileAs(
       'ticketbox-security-file-security.ps1',
       'security_primitives\file_security.ps1',
       WindowsSecurityFileSecurityScriptSha256) or
     not StageLifecycleLockBootstrapFile(
       'windows_lifecycle_lock.ps1',
       LifecycleLockScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'hold_installer_lifecycle_lock.ps1',
    LifecycleHolderScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'install_windows_prerequisites.ps1',
    WindowsPrerequisiteScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'vc_redist.x64.exe',
    VisualCppRuntimeSha256) or
     not StageLifecycleLockBootstrapFile(
    'hold_data_root_mutation_guard.ps1',
    DataRootGuardScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'prepare_bundled_upgrade.ps1',
    PrepareScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_service_contract.ps1',
    ServiceContractScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_service_identity.ps1',
    ServiceIdentityScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_service_lifecycle.ps1',
    ServiceLifecycleScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_lifecycle_receipt.ps1',
    LifecycleReceiptScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_database_safety.ps1',
    DatabaseSafetyScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_pg_recovery_tools.ps1',
    PgRecoveryToolsScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_release_config.ps1',
    ReleaseConfigScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows-release-config.json',
    ReleaseConfigJsonSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_build_provenance.ps1',
    BuildProvenanceScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_backend_build_provenance.ps1',
    BackendBuildProvenanceScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_database_generation.ps1',
    DatabaseGenerationScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_database_generation_contract.ps1',
    DatabaseGenerationContractScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'windows_database_generation_artifacts.ps1',
    DatabaseGenerationArtifactsScriptSha256) or
     not StageLifecycleLockBootstrapFile(
    'DATABASE_GENERATION_PROGRAM.json',
    DatabaseGenerationProgramSha256) then
  begin
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  LifecycleLockHolderScriptPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) + 'hold_installer_lifecycle_lock.ps1';
  LifecycleLockBootstrapFilesStaged := True;
  Result := True;
end;

function PrepareUninstallLifecycleLockHolderScript(): Boolean;
begin
  Result := PrepareLifecycleLockBootstrapDirectory();
  if not Result then
  begin
    exit;
  end;
  LifecycleLockHolderScriptPath :=
    ExpandConstant('{app}\installer\hold_installer_lifecycle_lock.ps1');
end;

function IsLowerHexLifecycleNonce(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 64;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
            ((Value[Index] >= 'a') and (Value[Index] <= 'f'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function LifecycleFinalizationAttemptIdFromNonce(Value: String): String;
begin
  Result := '';
  if not IsLowerHexLifecycleNonce(Value) then
  begin
    exit;
  end;
  Result :=
    Copy(Value, 1, 8) + '-' +
    Copy(Value, 9, 4) + '-' +
    Copy(Value, 13, 4) + '-' +
    Copy(Value, 17, 4) + '-' +
    Copy(Value, 21, 12);
  if Result = '00000000-0000-0000-0000-000000000000' then
  begin
    Result := '';
  end;
end;

function BeginLifecycleFinalizationAttempt(): Boolean;
var
  BindingText: String;
  BindingSha256: String;
begin
  Result := False;
  LifecycleFinalizationAttemptId := '';
  if (not LifecycleLockHolderActive) or
     (not IsLowerHexLifecycleNonce(LifecycleLockReleaseNonce)) or
     (LifecycleLockOwnerProcessId = 0) or
     (LifecycleLockOwnerStartedFileTimeHigh = '') or
     (LifecycleLockOwnerStartedFileTimeLow = '') then
  begin
    exit;
  end;
  LifecycleFinalizationAttemptSequence :=
    LifecycleFinalizationAttemptSequence + 1;
  BindingText :=
    'ticketbox-c07-lifecycle-finalization-attempt-v1|' +
    LifecycleLockReleaseNonce + '|' +
    IntToStr(LifecycleLockOwnerProcessId) + '|' +
    LifecycleLockOwnerStartedFileTimeHigh + '|' +
    LifecycleLockOwnerStartedFileTimeLow + '|' +
    IntToStr(LifecycleFinalizationAttemptSequence);
  try
    BindingSha256 := Lowercase(GetSHA256OfString(BindingText));
  except
    BindingSha256 := '';
  end;
  LifecycleFinalizationAttemptId :=
    LifecycleFinalizationAttemptIdFromNonce(BindingSha256);
  Result := LifecycleFinalizationAttemptId <> '';
end;

function IsLifecycleHolderFailureCode(Value: String): Boolean;
begin
  Result :=
    (Value = 'restore_privilege_unavailable') or
    (Value = 'installer_identity_invalid') or
    (Value = 'machine_root_invalid') or
    (Value = 'bootstrap_dependency_missing') or
    (Value = 'holder_start_failed');
end;

function LoadLifecycleCoordinationArtifact(
  const Path: String;
  var Text: AnsiString
): Boolean;
var
  Attempt: Integer;
begin
  Result := False;
  for Attempt := 1 to LifecycleCoordinationReadAttempts do
  begin
    if LoadStringFromFile(Path, Text) then
    begin
      if Attempt > 1 then
      begin
        Log(
          'Lifecycle coordination read recovered after a transient file-open conflict: ' +
          Path + ' attempts=' + IntToStr(Attempt));
      end;
      Result := True;
      exit;
    end;
    if Attempt < LifecycleCoordinationReadAttempts then
    begin
      Sleep(LifecycleCoordinationReadDelayMilliseconds);
    end;
  end;
end;

function ConsumeLifecycleHolderStartupFailure(): Boolean;
var
  FailureText: AnsiString;
  FailureValue: String;
  FailurePrefix: String;
  MessageDelimiter: String;
  FailureRemainder: String;
  ErrorCode: String;
  MessageText: String;
  DelimiterPosition: Integer;
  ExpectedFailureText: String;
begin
  Result := False;
  if (LifecycleLockHolderFailurePath = '') or
     (not FileExists(LifecycleLockHolderFailurePath)) then
  begin
    exit;
  end;
  Result := True;
  if not LoadLifecycleCoordinationArtifact(
    LifecycleLockHolderFailurePath,
    FailureText) then
  begin
    LifecycleLockError := '机器级安装锁 holder 已退出，但启动诊断无法读取。';
    exit;
  end;
  FailureValue := String(FailureText);
  if Length(FailureValue) > 2048 then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断超出大小限制。';
    exit;
  end;
  FailurePrefix :=
    'SCHEMA=ticketbox-lifecycle-holder-failure-v1' + #13#10 +
    'STATE=failed' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
    'OWNER_STARTED_FILETIME_HIGH=' + LifecycleLockOwnerStartedFileTimeHigh + #13#10 +
    'OWNER_STARTED_FILETIME_LOW=' + LifecycleLockOwnerStartedFileTimeLow + #13#10 +
    'ERROR_CODE=';
  if Copy(FailureValue, 1, Length(FailurePrefix)) <> FailurePrefix then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断与当前安装器身份不匹配。';
    exit;
  end;
  FailureRemainder := Copy(
    FailureValue,
    Length(FailurePrefix) + 1,
    Length(FailureValue));
  MessageDelimiter := #13#10 + 'MESSAGE=';
  DelimiterPosition := Pos(MessageDelimiter, FailureRemainder);
  if DelimiterPosition <= 1 then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断格式无效。';
    exit;
  end;
  ErrorCode := Copy(FailureRemainder, 1, DelimiterPosition - 1);
  MessageText := Copy(
    FailureRemainder,
    DelimiterPosition + Length(MessageDelimiter),
    Length(FailureRemainder));
  if (Length(MessageText) < 3) or
     (Copy(MessageText, Length(MessageText) - 1, 2) <> #13#10) then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断缺少终止标记。';
    exit;
  end;
  Delete(MessageText, Length(MessageText) - 1, 2);
  ExpectedFailureText :=
    FailurePrefix + ErrorCode + MessageDelimiter + MessageText + #13#10;
  if (FailureValue <> ExpectedFailureText) or
     (not IsLifecycleHolderFailureCode(ErrorCode)) or
     (Length(MessageText) > 512) then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断未通过完整性检查。';
    exit;
  end;
  Log('Lifecycle lock holder startup failure code: ' + ErrorCode);
  if ErrorCode = 'restore_privilege_unavailable' then
  begin
    LifecycleLockError :=
      'Windows 安全策略未向安装器提供“还原文件和目录”权限，无法安全创建机器状态。' +
      '安装尚未修改服务和数据；请让设备管理员或 IT 检查 SeRestorePrivilege 本机安全策略。' +
      '支持代码：TBX-LOCK-PRIVILEGE。';
  end
  else if ErrorCode = 'installer_identity_invalid' then
  begin
    LifecycleLockError :=
      '安装器与机器级锁进程的身份校验失败。请关闭其他安装器后重新双击此安装包。';
  end
  else if ErrorCode = 'machine_root_invalid' then
  begin
    LifecycleLockError :=
      'Windows 机器状态目录不可用或不可信，安装器未修改服务和数据。请检查系统盘后重试。';
  end
  else if ErrorCode = 'bootstrap_dependency_missing' then
  begin
    LifecycleLockError :=
      '安装包的受保护启动组件不完整，安装器未修改服务和数据。请重新获取可信安装包。';
  end
  else
  begin
    LifecycleLockError :=
      '机器级安装锁启动失败（' + ErrorCode + '）。安装器未修改服务和数据；' +
      '请关闭其他安装器后重试，若仍失败请联系支持。支持代码：TBX-LOCK-START。';
  end;
end;

function AcquireLifecycleLock(): Boolean;
var
  LockDirectory: String;
  Params: String;
  ResultCode: Integer;
  Attempt: Integer;
  RootValidatedText: AnsiString;
  ReadyText: AnsiString;
  ExpectedRootValidatedText: String;
  RootValidatedValue: String;
  RootValidated: Boolean;
  ReadyPrefix: String;
  ReadyRemainder: String;
  HolderIdentityRemainder: String;
  HolderStartedLowRemainder: String;
  InstallerStateRemainder: String;
  HolderStartedHighDelimiter: String;
  HolderStartedLowDelimiter: String;
  InstallerStateDelimiter: String;
  NonceDelimiter: String;
  HolderProcessIdText: String;
  HolderStartedFileTimeHighText: String;
  HolderStartedFileTimeLowText: String;
  HolderDelimiterPosition: Integer;
  HolderStartedLowDelimiterPosition: Integer;
  InstallerStateDelimiterPosition: Integer;
  NonceDelimiterPosition: Integer;
  ParsedHolderProcessId: Integer;
  OwnerProcessHandle: LongWord;
  ExpectedReadyText: String;
  ReadyValue: String;
begin
  LifecycleLockError := '';
  LifecycleFinalizationAttemptId := '';
  Result := False;
  if LifecycleLockHolderStarted then
  begin
    LifecycleLockError := '安装生命周期锁 holder 已启动，拒绝重复获取。';
    exit;
  end;
  LockDirectory := ExpandConstant('{commoncf64}\Ticketbox');
  LifecycleLockOwnerPath := LockDirectory + '\installer-lifecycle.owner';
  if (LifecycleLockHolderScriptPath = '') or
     (not FileExists(LifecycleLockHolderScriptPath)) then
  begin
    LifecycleLockError := '缺少受信任的机器级安装锁 holder 脚本。';
    exit;
  end;
  if LifecycleLockBootstrapFilesStaged and
     (not ValidateLifecycleLockBootstrapFiles()) then
  begin
    LifecycleLockError :=
      '受保护 lifecycle bootstrap staging 在执行前未通过 SHA-256 复核。';
    exit;
  end;
  LifecycleLockOwnerProcessId := GetCurrentProcessId();
  OwnerProcessHandle := OpenProcess(
    ProcessSynchronize or ProcessQueryLimitedInformation,
    False,
    LifecycleLockOwnerProcessId);
  if not IsProcessHandleRunning(OwnerProcessHandle) or
     not ReadProcessStartedFileTime(
       OwnerProcessHandle,
       LifecycleLockOwnerStartedFileTimeHigh,
       LifecycleLockOwnerStartedFileTimeLow) then
  begin
    if (OwnerProcessHandle <> 0) and
       (OwnerProcessHandle <> InvalidHandleValue) then
    begin
      CloseHandle(OwnerProcessHandle);
    end;
    LifecycleLockError := '无法冻结安装器进程创建身份。';
    exit;
  end;
  CloseHandle(OwnerProcessHandle);
  LifecycleLockRootValidatedPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) +
    'lifecycle-root-validated.ready';
  LifecycleLockHolderFailurePath :=
    AddBackslash(LifecycleLockBootstrapDirectory) +
    'lifecycle-holder-failure.txt';
  if FileExists(LifecycleLockRootValidatedPath) then
  begin
    LifecycleLockError := '机器根验证信号已存在，拒绝复用。';
    exit;
  end;
  if FileExists(LifecycleLockHolderFailurePath) then
  begin
    LifecycleLockError := '机器级安装锁 holder 启动诊断已存在，拒绝复用。';
    exit;
  end;
  LifecycleLockHolderReadyPath :=
    LockDirectory + '\installer-lifecycle-' +
    IntToStr(LifecycleLockOwnerProcessId) + '.ready';
  LifecycleLockHolderReleasePath :=
    LockDirectory + '\installer-lifecycle-' +
    IntToStr(LifecycleLockOwnerProcessId) + '.release';
  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' +
     Quote(LifecycleLockHolderScriptPath) +
     ' -InstallerOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
     ' -InstallerOwnerStartedFileTimeHigh ' + LifecycleLockOwnerStartedFileTimeHigh +
     ' -InstallerOwnerStartedFileTimeLow ' + LifecycleLockOwnerStartedFileTimeLow +
     ' -ExpectedLockDirectory ' + Quote(LockDirectory) +
    ' -RootValidatedPath ' + Quote(LifecycleLockRootValidatedPath) +
    ' -ReadyPath ' + Quote(LifecycleLockHolderReadyPath) +
    ' -ReleasePath ' + Quote(LifecycleLockHolderReleasePath) +
    ' -FailurePath ' + Quote(LifecycleLockHolderFailurePath);
  if not Exec(
    WindowsPowerShellExecutable(),
    Params,
    '',
    SW_HIDE,
    ewNoWait,
    ResultCode) then
  begin
    LifecycleLockError := '无法启动受保护的机器级安装锁 holder。';
    exit;
  end;
  LifecycleLockHolderStarted := True;
  ExpectedRootValidatedText :=
    'STATE=root_validated' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  RootValidated := False;
  ReadyPrefix :=
    'STATE=holding' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
    'HOLDER_PID=';
  HolderStartedHighDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_HIGH=';
  HolderStartedLowDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_LOW=';
  InstallerStateDelimiter := #13#10 + 'INSTALLER_STATE=';
  NonceDelimiter := #13#10 + 'NONCE=';
  for Attempt := 1 to 300 do
  begin
    if ConsumeLifecycleHolderStartupFailure() then
    begin
      exit;
    end;
    if not RootValidated then
    begin
      if FileExists(LifecycleLockRootValidatedPath) then
      begin
        if not LoadLifecycleCoordinationArtifact(
          LifecycleLockRootValidatedPath,
          RootValidatedText) then
        begin
          LifecycleLockError := '无法读取机器根验证信号。';
          exit;
        end;
        RootValidatedValue := String(RootValidatedText);
        if RootValidatedValue <> ExpectedRootValidatedText then
        begin
          LifecycleLockError := '机器根验证信号与当前安装器身份不匹配。';
          exit;
        end;
        RootValidated := True;
      end;
    end
    else if FileExists(LifecycleLockHolderReadyPath) then
    begin
      if not LoadLifecycleCoordinationArtifact(
        LifecycleLockHolderReadyPath,
        ReadyText) then
      begin
        LifecycleLockError := '无法读取机器级安装锁 ready IPC。';
        exit;
      end;
      ReadyValue := String(ReadyText);
      if Copy(ReadyValue, 1, Length(ReadyPrefix)) <> ReadyPrefix then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 前缀不匹配当前安装器。';
        exit;
      end;
      ReadyRemainder := Copy(
        ReadyValue,
        Length(ReadyPrefix) + 1,
        Length(ReadyValue));
      HolderDelimiterPosition := Pos(HolderStartedHighDelimiter, ReadyRemainder);
      if HolderDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder PID。';
        exit;
      end;
      HolderProcessIdText := Copy(
        ReadyRemainder,
        1,
        HolderDelimiterPosition - 1);
      ParsedHolderProcessId := StrToIntDef(HolderProcessIdText, 0);
      if (ParsedHolderProcessId <= 0) or
         (IntToStr(ParsedHolderProcessId) <> HolderProcessIdText) then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 的 holder PID 无效。';
        exit;
      end;
      HolderIdentityRemainder := Copy(
        ReadyRemainder,
        HolderDelimiterPosition + Length(HolderStartedHighDelimiter),
        Length(ReadyRemainder));
      HolderStartedLowDelimiterPosition := Pos(
        HolderStartedLowDelimiter,
        HolderIdentityRemainder);
      if HolderStartedLowDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder 创建时间高位。';
        exit;
      end;
      HolderStartedFileTimeHighText := Copy(
        HolderIdentityRemainder,
        1,
        HolderStartedLowDelimiterPosition - 1);
      HolderStartedLowRemainder := Copy(
        HolderIdentityRemainder,
        HolderStartedLowDelimiterPosition + Length(HolderStartedLowDelimiter),
        Length(HolderIdentityRemainder));
      InstallerStateDelimiterPosition := Pos(
        InstallerStateDelimiter,
        HolderStartedLowRemainder);
      if InstallerStateDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 holder 创建时间低位。';
        exit;
      end;
      HolderStartedFileTimeLowText := Copy(
        HolderStartedLowRemainder,
        1,
        InstallerStateDelimiterPosition - 1);
      InstallerStateRemainder := Copy(
        HolderStartedLowRemainder,
        InstallerStateDelimiterPosition + Length(InstallerStateDelimiter),
        Length(HolderStartedLowRemainder));
      NonceDelimiterPosition := Pos(NonceDelimiter, InstallerStateRemainder);
      if NonceDelimiterPosition <= 1 then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 缺少 installer state 路径。';
        exit;
      end;
      LifecycleInstallerStateDirectory := Copy(
        InstallerStateRemainder,
        1,
        NonceDelimiterPosition - 1);
      if (CompareText(ExtractFileDir(LifecycleInstallerStateDirectory), LockDirectory) <> 0) or
         (CompareText(LifecycleInstallerStateDirectory, LockDirectory) = 0) then
      begin
        LifecycleLockError := '机器级安装锁 holder 声明的 installer state 越出机器根。';
        LifecycleInstallerStateDirectory := '';
        exit;
      end;
      LifecycleLockReleaseNonce := Copy(
        InstallerStateRemainder,
        NonceDelimiterPosition + Length(NonceDelimiter),
        64);
      ExpectedReadyText :=
        ReadyPrefix + HolderProcessIdText + HolderStartedHighDelimiter +
        HolderStartedFileTimeHighText + HolderStartedLowDelimiter +
        HolderStartedFileTimeLowText + InstallerStateDelimiter +
        LifecycleInstallerStateDirectory + NonceDelimiter +
        LifecycleLockReleaseNonce + #13#10;
      if (ReadyValue <> ExpectedReadyText) or
         (not IsLowerHexLifecycleNonce(LifecycleLockReleaseNonce)) then
      begin
        LifecycleLockError := '机器级安装锁 ready IPC 与当前安装器身份或随机挑战不匹配。';
        LifecycleLockReleaseNonce := '';
        LifecycleFinalizationAttemptId := '';
        LifecycleInstallerStateDirectory := '';
        exit;
      end;
      LifecycleLockHolderProcessId := LongWord(ParsedHolderProcessId);
      LifecycleLockHolderProcessHandle := OpenVerifiedProcessIdentityHandle(
        LifecycleLockHolderProcessId,
        HolderStartedFileTimeHighText,
        HolderStartedFileTimeLowText);
      if not IsProcessHandleRunning(LifecycleLockHolderProcessHandle) then
      begin
        LifecycleLockError :=
          '机器级安装锁 holder 的 PID/创建时间与 ready IPC 不匹配或进程已退出。';
        exit;
      end;
      LifecycleLockHolderActive := True;
      Result := True;
      exit;
    end;
    Sleep(100);
  end;
  if not RootValidated then
  begin
    LifecycleLockError := '机器级安装锁 holder 未在 30 秒内验证机器状态根。';
  end
  else
  begin
    LifecycleLockError := '机器级安装锁 holder 未在 30 秒内就绪。';
  end;
end;

procedure ReleaseLifecycleLock();
var
  ReleaseTempPath: String;
  ReleaseText: String;
  WaitResult: LongWord;
begin
  if not LifecycleLockHolderStarted then
  begin
    CleanupLifecycleLockBootstrapDirectory();
    exit;
  end;
  if IsProcessHandleRunning(LifecycleLockHolderProcessHandle) then
  begin
    ReleaseTempPath := LifecycleLockHolderReleasePath + '.tmp';
    ReleaseText :=
      'STATE=release' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'NONCE=' + LifecycleLockReleaseNonce + #13#10;
    DeleteFile(ReleaseTempPath);
    if SaveStringToFile(ReleaseTempPath, ReleaseText, False) and
       HardenLifecycleLockPath(ReleaseTempPath, False) and
       RenameFile(ReleaseTempPath, LifecycleLockHolderReleasePath) then
    begin
      WaitResult := WaitForSingleObject(LifecycleLockHolderProcessHandle, 10000);
      if WaitResult <> WaitObject0 then
      begin
        Log('Lifecycle lock holder did not exit before timeout; parent exit remains the fail-safe release.');
      end;
    end
    else
    begin
      Log('Could not persist lifecycle lock release IPC; parent exit remains the fail-safe release.');
    end;
  end;
  if (LifecycleLockHolderProcessHandle <> 0) and
     (LifecycleLockHolderProcessHandle <> InvalidHandleValue) then
  begin
    CloseHandle(LifecycleLockHolderProcessHandle);
  end;
  DeleteFile(LifecycleLockHolderReadyPath);
  DeleteFile(LifecycleLockHolderReleasePath);
  DeleteFile(LifecycleLockHolderReleasePath + '.tmp');
  DeleteFile(LifecycleLockHolderFailurePath);
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockHolderFailurePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleFinalizationAttemptId := '';
  LifecycleFinalizationAttemptSequence := 0;
  LifecycleInstallerStateDirectory := '';
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  LifecycleLockOwnerPath := '';
  LifecycleLockOwnerProcessId := 0;
  CleanupLifecycleLockBootstrapDirectory();
end;

function LifecycleLockActive(): Boolean;
begin
  Result :=
    LifecycleLockHolderActive and
    IsProcessHandleRunning(LifecycleLockHolderProcessHandle);
end;

procedure AssertLifecycleLockActive();
begin
  if not LifecycleLockActive() then
  begin
    RaiseException('机器级安装生命周期锁未持续持有，拒绝继续 mutation。');
  end;
end;

function IsDecimalVersionComponent(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := (Value <> '') and (Length(Value) <= 5);
  if not Result then
  begin
    exit;
  end;
  if (Length(Value) > 1) and (Value[1] = '0') then
  begin
    Result := False;
    exit;
  end;
  for Index := 1 to Length(Value) do
  begin
    if (Value[Index] < '0') or (Value[Index] > '9') then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function ParseSupportedNumericVersion(
  Value: String;
  var Major: Integer;
  var Minor: Integer;
  var Patch: Integer;
  var Revision: Integer
): Boolean;
var
  Parts: TArrayOfString;
  Index: Integer;
  Component: Integer;
begin
  Result := False;
  Major := 0;
  Minor := 0;
  Patch := 0;
  Revision := 0;
  Parts := StringSplit(Trim(Value), ['.'], stAll);
  if (GetArrayLength(Parts) < 3) or (GetArrayLength(Parts) > 4) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(Parts) - 1 do
  begin
    if not IsDecimalVersionComponent(Parts[Index]) then
    begin
      exit;
    end;
    Component := StrToIntDef(Parts[Index], -1);
    if (Component < 0) or (Component > 65535) then
    begin
      exit;
    end;
    case Index of
      0: Major := Component;
      1: Minor := Component;
      2: Patch := Component;
      3: Revision := Component;
    end;
  end;
  Result := True;
end;

function CompareSupportedNumericVersions(LeftValue: String; RightValue: String; var Comparable: Boolean): Integer;
var
  LeftMajor: Integer;
  LeftMinor: Integer;
  LeftPatch: Integer;
  LeftRevision: Integer;
  RightMajor: Integer;
  RightMinor: Integer;
  RightPatch: Integer;
  RightRevision: Integer;
begin
  Comparable :=
    ParseSupportedNumericVersion(LeftValue, LeftMajor, LeftMinor, LeftPatch, LeftRevision) and
    ParseSupportedNumericVersion(RightValue, RightMajor, RightMinor, RightPatch, RightRevision);
  Result := 0;
  if not Comparable then
  begin
    exit;
  end;
  if LeftMajor <> RightMajor then
  begin
    if LeftMajor < RightMajor then Result := -1 else Result := 1;
  end
  else if LeftMinor <> RightMinor then
  begin
    if LeftMinor < RightMinor then Result := -1 else Result := 1;
  end
  else if LeftPatch <> RightPatch then
  begin
    if LeftPatch < RightPatch then Result := -1 else Result := 1;
  end
  else if LeftRevision <> RightRevision then
  begin
    if LeftRevision < RightRevision then Result := -1 else Result := 1;
  end;
end;

function VersionGateServiceExists(ServiceName: String): Boolean;
begin
  Result := TicketboxServiceExistsNative(ServiceName);
end;

function HasExistingTicketboxInstallMarkers(): Boolean;
var
  ExistingValue: String;
begin
  Result :=
    RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'InstallDir', ExistingValue) or
    RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'DataRoot', ExistingValue) or
    VersionGateServiceExists('{#PgServiceName}') or
    VersionGateServiceExists('{#BackendServiceName}');
end;

function PersistentIdentityDataRoot(): String;
var
  ParamValue: String;
  RegisteredValue: String;
begin
  ParamValue := Trim(ExpandConstant('{param:TicketboxDataRoot|}'));
  if RegQueryStringValue(HKLM64, 'Software\Ticketbox', 'DataRoot', RegisteredValue) and
     (Trim(RegisteredValue) <> '') then
  begin
    Result := ExpandFileName(Trim(RegisteredValue));
  end
  else if ParamValue <> '' then
  begin
    Result := ExpandFileName(ParamValue);
  end
  else
  begin
    Result := ExpandFileName(ExpandConstant('{commonappdata}\Ticketbox'));
  end;
end;

function PersistentIdentityPath(DataRoot: String): String;
begin
  Result := AddBackslash(DataRoot) + '.ticketbox-installation-identity';
end;

function HasProtectedPersistentIdentityAcl(IdentityPath: String): Boolean;
var
  ResultCode: Integer;
  EscapedPath: String;
  CommandText: String;
begin
  EscapedPath := IdentityPath;
  StringChangeEx(EscapedPath, '''', '''''', True);
  CommandText :=
    '$p=''' + EscapedPath + ''';' +
    '$ok=$true;' +
    '$i=Get-Item -LiteralPath $p -Force;' +
    'if(($i.Attributes-band[IO.FileAttributes]::ReparsePoint)-ne 0){$ok=$false};' +
    '$d=$i.Directory;while($null-ne$d){if(($d.Attributes-band[IO.FileAttributes]::ReparsePoint)-ne 0){$ok=$false};$d=$d.Parent};' +
    '$a=$i.GetAccessControl([Security.AccessControl.AccessControlSections]::All);' +
    '$sid=[Security.Principal.SecurityIdentifier];' +
    '$o=$a.Owner;' +
    'try{$o=(New-Object Security.Principal.NTAccount -ArgumentList $o).Translate($sid).Value}catch{};' +
    '$ok=$ok -and $a.AreAccessRulesProtected -and ($o -eq ''S-1-5-18'');' +
    '$allow=@(''S-1-5-18'',''S-1-5-32-544'');' +
    '$seen=@{};' +
    'foreach($r in $a.GetAccessRules($true,$false,$sid)){' +
    '$s=$r.IdentityReference.Value;' +
    '$full=($r.FileSystemRights-band[Security.AccessControl.FileSystemRights]::FullControl)-eq[Security.AccessControl.FileSystemRights]::FullControl;' +
    'if(($s -notin $allow) -or (-not $full) -or ($r.AccessControlType -ne [Security.AccessControl.AccessControlType]::Allow) -or $r.IsInherited){$ok=$false};$seen[$s]=$true};' +
    'foreach($s in $allow){if(-not $seen.ContainsKey($s)){$ok=$false}};' +
    'if($ok){exit 0}else{exit 1}';
  Result := Exec(
    WindowsPowerShellExecutable(),
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) and (ResultCode = 0);
end;

function IsUpperHexSha256(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 64;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
            ((Value[Index] >= 'A') and (Value[Index] <= 'F'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function IsCanonicalInstallationId(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 36;
  if not Result then exit;
  for Index := 1 to Length(Value) do
  begin
    if (Index = 9) or (Index = 14) or (Index = 19) or (Index = 24) then
    begin
      if Value[Index] <> '-' then
      begin
        Result := False;
        exit;
      end;
    end
    else if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
                 ((Value[Index] >= 'a') and (Value[Index] <= 'f')) or
                 ((Value[Index] >= 'A') and (Value[Index] <= 'F'))) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function TryGetPersistentBackendVersionFloor(
  DataRoot: String;
  var VersionFloor: String;
  var FailureReason: String
): Boolean;
var
  Lines: TArrayOfString;
  IdentityPath: String;
  ExpectedNames: TArrayOfString;
  Values: TArrayOfString;
  Index: Integer;
  Separator: Integer;
  Name: String;
  Value: String;
  Major: Integer;
  Minor: Integer;
  Patch: Integer;
  Revision: Integer;
begin
  Result := False;
  VersionFloor := '';
  FailureReason := '';
  IdentityPath := PersistentIdentityPath(DataRoot);
  if not FileExists(IdentityPath) then
  begin
    FailureReason := '持久安装身份文件不存在：' + IdentityPath;
    exit;
  end;
  if not HasProtectedPersistentIdentityAcl(IdentityPath) then
  begin
    FailureReason := '持久安装身份文件不是 SYSTEM/Administrators-only 精确 ACL。';
    exit;
  end;
  if not LoadStringsFromFile(IdentityPath, Lines) then
  begin
    FailureReason := '无法以 UTF-8 读取持久安装身份文件。';
    exit;
  end;
  SetArrayLength(ExpectedNames, 18);
  ExpectedNames[0] := 'SCHEMA';
  ExpectedNames[1] := 'STATE';
  ExpectedNames[2] := 'OPERATION_ID';
  ExpectedNames[3] := 'BACKEND_VERSION_FLOOR';
  ExpectedNames[4] := 'INSTALLATION_ID';
  ExpectedNames[5] := 'BUILD_MANIFEST_SHA256';
  ExpectedNames[6] := 'MIGRATION_HELPER_RELATIVE_PATH';
  ExpectedNames[7] := 'MIGRATION_HELPER_SIZE';
  ExpectedNames[8] := 'MIGRATION_HELPER_SHA256';
  ExpectedNames[9] := 'DATABASE_GENERATION_PROGRAM_RELATIVE_PATH';
  ExpectedNames[10] := 'DATABASE_GENERATION_PROGRAM_SIZE';
  ExpectedNames[11] := 'DATABASE_GENERATION_PROGRAM_SHA256';
  ExpectedNames[12] := 'DATA_ROOT';
  ExpectedNames[13] := 'INSTALL_DIR';
  ExpectedNames[14] := 'PG_SERVICE_NAME';
  ExpectedNames[15] := 'BACKEND_SERVICE_NAME';
  ExpectedNames[16] := 'PG_PORT';
  ExpectedNames[17] := 'BACKEND_PORT';
  SetArrayLength(Values, GetArrayLength(ExpectedNames));
  if GetArrayLength(Lines) <> GetArrayLength(ExpectedNames) then
  begin
    FailureReason := '持久安装身份字段数量不正确。';
    exit;
  end;
  for Index := 0 to GetArrayLength(Lines) - 1 do
  begin
    Separator := Pos('=', Lines[Index]);
    if Separator <= 1 then
    begin
      FailureReason := '持久安装身份含有无效字段。';
      exit;
    end;
    Name := Copy(Lines[Index], 1, Separator - 1);
    Value := Copy(Lines[Index], Separator + 1, MaxInt);
    if (Name <> ExpectedNames[Index]) or (Value = '') then
    begin
      FailureReason := '持久安装身份字段顺序、名称或值无效：' + Name;
      exit;
    end;
    Values[Index] := Value;
  end;
  if (Values[0] <> 'ticketbox-installation-identity-v3') or
     ((Values[1] <> 'PENDING') and (Values[1] <> 'READY')) then
  begin
    FailureReason := '持久安装身份 schema 不受支持。';
    exit;
  end;
  if not ParseSupportedNumericVersion(Values[3], Major, Minor, Patch, Revision) then
  begin
    FailureReason := '持久 backend version floor 格式无效。';
    exit;
  end;
  if (not IsCanonicalInstallationId(Values[2])) or
     (not IsCanonicalInstallationId(Values[4])) or
     (not IsUpperHexSha256(Values[5])) or
     (Values[6] <> 'ticketbox-c07-migrator.exe') or
     (StrToIntDef(Values[7], -1) < 1) or
     (not IsUpperHexSha256(Values[8])) or
     (Values[9] <> 'DATABASE_GENERATION_PROGRAM.json') or
     (StrToIntDef(Values[10], -1) < 1) or
     (not IsUpperHexSha256(Values[11])) then
  begin
    FailureReason := '持久 installation/build/program identity 格式无效。';
    exit;
  end;
  if Uppercase(AddBackslash(ExpandFileName(Values[12]))) <>
     Uppercase(AddBackslash(ExpandFileName(DataRoot))) then
  begin
    FailureReason := '持久安装身份绑定的 DataRoot 与当前保留数据不一致。';
    exit;
  end;
  if (Values[14] <> '{#PgServiceName}') or
     (Values[15] <> '{#BackendServiceName}') or
     (StrToIntDef(Values[16], -1) < 1) or
     (StrToIntDef(Values[16], -1) > 65535) or
     (StrToIntDef(Values[17], -1) < 1) or
     (StrToIntDef(Values[17], -1) > 65535) or
     (Values[16] = Values[17]) then
  begin
    FailureReason := '持久安装身份的服务或端口身份无效。';
    exit;
  end;
  VersionFloor := Values[3];
  Result := True;
end;

function TicketboxLegacyUninstallKey(): String;
begin
  Result :=
    'Software\Microsoft\Windows\CurrentVersion\Uninstall\{' +
    '{#TicketboxAppIdGuid}' + '}_is1';
end;

function CanonicalVersionGateInstallPath(Value: String): String;
begin
  Result := '';
  if Trim(Value) <> '' then
  begin
    Result := Uppercase(AddBackslash(ExpandFileName(Trim(Value))));
  end;
end;

function TryGetTrustedLegacyBackendVersion(
  var LegacyVersion: String;
  var FailureReason: String
): Boolean;
var
  UninstallKey: String;
  DisplayName: String;
  InstallLocation: String;
  RegisteredInstallDir: String;
  Major: Integer;
  Minor: Integer;
  Patch: Integer;
  Revision: Integer;
begin
  Result := False;
  LegacyVersion := '';
  FailureReason := '';
  UninstallKey := TicketboxLegacyUninstallKey();
  if not RegKeyExists(HKLM64, UninstallKey) then
  begin
    FailureReason := '未找到同一稳定 AppId 的 HKLM64 Inno 卸载记录。';
    exit;
  end;
  if (not RegQueryStringValue(HKLM64, UninstallKey, 'DisplayName', DisplayName)) or
     (CompareText(Trim(DisplayName), '{#AppName}') <> 0) then
  begin
    FailureReason := '旧版 Inno 卸载记录的 DisplayName 与小票夹产品身份不一致。';
    exit;
  end;
  if (not RegQueryStringValue(HKLM64, UninstallKey, 'InstallLocation', InstallLocation)) or
     (not RegQueryStringValue(
       HKLM64,
       'Software\Ticketbox',
       'InstallDir',
       RegisteredInstallDir)) or
     (not DirExists(ExpandFileName(Trim(InstallLocation)))) or
     (CanonicalVersionGateInstallPath(InstallLocation) = '') or
     (CanonicalVersionGateInstallPath(InstallLocation) <>
       CanonicalVersionGateInstallPath(RegisteredInstallDir)) then
  begin
    FailureReason :=
      '旧版 Inno 卸载记录的 InstallLocation 无法与 HKLM 小票夹 InstallDir 绑定。';
    exit;
  end;
  if not RegQueryStringValue(HKLM64, UninstallKey, 'DisplayVersion', LegacyVersion) then
  begin
    FailureReason := '旧版 Inno 卸载记录缺少 DisplayVersion。';
    exit;
  end;
  LegacyVersion := Trim(LegacyVersion);
  if not ParseSupportedNumericVersion(
    LegacyVersion,
    Major,
    Minor,
    Patch,
    Revision) then
  begin
    FailureReason :=
      '旧版 Inno DisplayVersion 不符合受支持的三段或四段纯数字版本契约。';
    exit;
  end;
  Result := True;
end;

function EvaluateBackendVersionFloorDecision(
  TargetVersion: String;
  HasFormalVersion: Boolean;
  FormalVersion: String;
  HasTrustedLegacyVersion: Boolean;
  LegacyVersion: String;
  HasExistingInstall: Boolean;
  LegacyFailureReason: String;
  var FailureReason: String
): Boolean;
var
  InstalledVersion: String;
  VersionFloorSource: String;
  Comparable: Boolean;
  Comparison: Integer;
  TargetMajor: Integer;
  TargetMinor: Integer;
  TargetPatch: Integer;
  TargetRevision: Integer;
begin
  FailureReason := '';
  VersionFloorSource := '';
  if not ParseSupportedNumericVersion(
    TargetVersion,
    TargetMajor,
    TargetMinor,
    TargetPatch,
    TargetRevision) then
  begin
    FailureReason :=
      '目标安装包版本不符合受支持的三段或四段纯数字版本契约：' + TargetVersion + #13#10 +
      '安装器已停止且不会复制文件。';
    Result := False;
    exit;
  end;
  if HasFormalVersion then
  begin
    InstalledVersion := Trim(FormalVersion);
    VersionFloorSource := '正式 BackendVersion';
  end
  else if HasTrustedLegacyVersion then
  begin
    InstalledVersion := Trim(LegacyVersion);
    VersionFloorSource := '旧版 Inno DisplayVersion';
  end
  else if HasExistingInstall then
  begin
    FailureReason :=
      '检测到已有小票夹安装，但无法读取 HKLM\Software\Ticketbox\BackendVersion。' + #13#10 +
      '旧版版本记录也不可信：' + LegacyFailureReason + #13#10 +
      '安装器无法安全判断是否降级，已停止且不会复制文件。';
    Result := False;
    exit;
  end
  else
  begin
    Result := True;
    exit;
  end;

  Comparison := CompareSupportedNumericVersions(TargetVersion, InstalledVersion, Comparable);
  if not Comparable then
  begin
    FailureReason :=
      '无法按受支持的三段或四段数字版本契约比较版本。' + #13#10 +
      '已安装版本：' + InstalledVersion + #13#10 +
      '目标版本：' + TargetVersion + #13#10 +
      '安装器已停止且不会复制文件。';
    Result := False;
    exit;
  end;
  if Comparison < 0 then
  begin
    FailureReason :=
      '拒绝安装旧版本。' + #13#10 +
      '版本下限来源：' + VersionFloorSource + #13#10 +
      '已安装或保留的版本下限：' + InstalledVersion + #13#10 +
      '目标版本：' + TargetVersion;
    Result := False;
    exit;
  end;
  Result := True;
end;

function CheckBackendVersionFloorForDataRoot(
  PreservedDataRoot: String;
  var FailureReason: String
): Boolean;
var
  HasFormalVersion: Boolean;
  FormalVersion: String;
  HasTrustedLegacyVersion: Boolean;
  LegacyVersion: String;
  HasExistingInstall: Boolean;
  LegacyFailureReason: String;
  PersistentIdentityFile: String;
  PersistentIdentityFailure: String;
  HasPersistentIdentity: Boolean;
  HasPreservedPgData: Boolean;
  RegisteredDataRoot: String;
  RegisteredVersion: String;
  VersionsComparable: Boolean;
  VersionComparison: Integer;
begin
  FormalVersion := '';
  LegacyVersion := '';
  LegacyFailureReason := '';
  HasTrustedLegacyVersion := False;
  HasExistingInstall := False;
  PreservedDataRoot := ExpandFileName(PreservedDataRoot);
  PersistentIdentityFile := PersistentIdentityPath(PreservedDataRoot);
  HasPreservedPgData := FileExists(AddBackslash(PreservedDataRoot) + 'pgdata\PG_VERSION');
  HasPersistentIdentity := FileExists(PersistentIdentityFile);
  if HasPersistentIdentity then
  begin
    HasFormalVersion := TryGetPersistentBackendVersionFloor(
      PreservedDataRoot,
      FormalVersion,
      PersistentIdentityFailure);
    if not HasFormalVersion then
    begin
      FailureReason :=
        '检测到保留的 PostgreSQL 数据或安装身份，但可信 version floor 缺失或损坏。' + #13#10 +
        PersistentIdentityFailure + #13#10 +
        '安装器已 fail closed，未读取服务/版本身份，也不会复制文件。';
      Result := False;
      exit;
    end;
    if RegQueryStringValue(
         HKLM64,
         'Software\Ticketbox',
         'DataRoot',
         RegisteredDataRoot) and
       (CanonicalVersionGateInstallPath(RegisteredDataRoot) =
        CanonicalVersionGateInstallPath(PreservedDataRoot)) and
       RegQueryStringValue(
         HKLM64,
         'Software\Ticketbox',
         'BackendVersion',
         RegisteredVersion) then
    begin
      VersionComparison := CompareSupportedNumericVersions(
        RegisteredVersion,
        FormalVersion,
        VersionsComparable);
      if not VersionsComparable then
      begin
        FailureReason :=
          '同一 DataRoot 的机器级 BackendVersion 不符合受支持的版本契约。' + #13#10 +
          '安装器无法安全计算中断升级后的防降级下限，已停止且不会复制文件。';
        Result := False;
        exit;
      end;
      if VersionComparison > 0 then
      begin
        FormalVersion := Trim(RegisteredVersion);
      end;
    end;
  end
  else if HasPreservedPgData then
  begin
    HasFormalVersion := False;
    if (not RegQueryStringValue(
          HKLM64,
          'Software\Ticketbox',
          'DataRoot',
          RegisteredDataRoot)) or
       (CanonicalVersionGateInstallPath(RegisteredDataRoot) <>
        CanonicalVersionGateInstallPath(PreservedDataRoot)) then
    begin
      FailureReason :=
        '检测到没有持久安装身份的 PostgreSQL 数据，但 HKLM DataRoot 无法与所选数据目录绑定。' + #13#10 +
        '安装器已 fail closed，不会复制文件。';
      Result := False;
      exit;
    end;
    HasTrustedLegacyVersion := TryGetTrustedLegacyBackendVersion(
      LegacyVersion,
      LegacyFailureReason);
    HasExistingInstall := True;
    if not HasTrustedLegacyVersion then
    begin
      FailureReason :=
        '检测到旧版 PostgreSQL 数据，但稳定 AppId、产品名、安装目录和版本证据不完整。' + #13#10 +
        LegacyFailureReason + #13#10 +
        '安装器已 fail closed，不会复制文件。';
      Result := False;
      exit;
    end;
  end
  else
  begin
    HasFormalVersion := RegQueryStringValue(
      HKLM64,
      'Software\Ticketbox',
      'BackendVersion',
      FormalVersion);
  end;
  if (not HasFormalVersion) and (not HasTrustedLegacyVersion) then
  begin
    HasTrustedLegacyVersion := TryGetTrustedLegacyBackendVersion(
      LegacyVersion,
      LegacyFailureReason);
    HasExistingInstall :=
      HasExistingTicketboxInstallMarkers() or
      RegKeyExists(HKLM64, TicketboxLegacyUninstallKey());
  end;
  Result := EvaluateBackendVersionFloorDecision(
    '{#AppVersion}',
    HasFormalVersion,
    FormalVersion,
    HasTrustedLegacyVersion,
    LegacyVersion,
    HasExistingInstall,
    LegacyFailureReason,
    FailureReason);
end;

function CheckBackendVersionFloor(var FailureReason: String): Boolean;
begin
  Result := CheckBackendVersionFloorForDataRoot(
    PersistentIdentityDataRoot(),
    FailureReason);
end;

function InitializeSetup(): Boolean;
var
  VersionFailureReason: String;
begin
  InstallerSourceLeaseHandle := InvalidHandleValue;
  if not AcquireInstallerSourceLease() then
  begin
    MsgBox(
      '无法锁定当前小票夹安装包；安装尚未修改服务、数据或程序文件。请重新下载后再试。',
      mbError,
      MB_OK);
    Result := False;
    exit;
  end;
  if WizardSilent then
  begin
    MsgBox(
      '当前版本尚未提供经过安全验收的无人值守安装合同。请使用交互式安装向导。',
      mbError,
      MB_OK);
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  LifecyclePrepared := False;
  LifecycleFilesMayBeReplaced := False;
  LifecycleInstallCompleted := False;
  LifecycleInstallFailed := False;
  LifecycleFailureMessage := '';
  ManagerMaintenanceOwnerRecord := '';
  InstallerLogSequence := 0;
  LastPowerShellFailureMessage := '';
  DataRootGuardProcessId := 0;
  DataRootGuardProcessHandle := InvalidHandleValue;
  DataRootGuardProcessStartedFileTimeHigh := '';
  DataRootGuardProcessStartedFileTimeLow := '';
  DataRootGuardReadyPath := '';
  DataRootGuardReleasePath := '';
  DataRootGuardReleaseNonce := '';
  DataRootGuardScriptPath := '';
  DataRootGuardProcessStarted := False;
  DataRootGuardActive := False;
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockRootValidatedPath := '';
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockHolderFailurePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleFinalizationAttemptId := '';
  LifecycleFinalizationAttemptSequence := 0;
  LifecycleInstallerStateDirectory := '';
  LifecycleLockHolderScriptPath := '';
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  if not PrepareSetupLifecycleLockHolderScripts() then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  Result := AcquireLifecycleLock();
  if not Result then
  begin
    MsgBox(LifecycleLockError, mbError, MB_OK);
    ReleaseLifecycleLock();
    CloseInstallerSourceLease();
    exit;
  end;
  if not CheckBackendVersionFloor(VersionFailureReason) then
  begin
    MsgBox(VersionFailureReason, mbError, MB_OK);
    ReleaseLifecycleLock();
    CloseInstallerSourceLease();
    Result := False;
    exit;
  end;
  Result := True;
end;

function TicketboxUninstallLockPublicMessage(): String;
begin
  Result :=
    '无法取得小票夹机器级维护锁，卸载尚未修改服务、程序或数据。' +
    '请关闭其他小票夹安装器或管理器后重试；若仍失败，请联系支持。' +
    '支持代码：TBX-UNINSTALL-LOCK';
end;

function TicketboxUninstallPostMutationAuthorityMessage(
  DeleteDataSelected: Boolean
): String;
begin
  if DeleteDataSelected then
  begin
    Result :=
      '卸载过程中维护权限已失效，无法证明本机数据的删除状态。' +
      '请勿手工删除目录；保留现状并联系支持。支持代码：TBX-UNINSTALL-DATA';
  end
  else
  begin
    Result :=
      '卸载过程中维护权限已失效，无法证明服务和程序的卸载状态；' +
      '本机数据未被请求删除。请保留现状并重试。支持代码：TBX-UNINSTALL-FAILED';
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := False;
  ManagerMaintenanceOwnerRecord := '';
  LastPowerShellFailureMessage := '';
  UninstallDeleteDataSelected := False;
  UninstallDataChoiceResolved := False;
  LifecycleLockHolderProcessHandle := InvalidHandleValue;
  LifecycleLockHolderProcessId := 0;
  LifecycleLockRootValidatedPath := '';
  LifecycleLockHolderReadyPath := '';
  LifecycleLockHolderReleasePath := '';
  LifecycleLockHolderFailurePath := '';
  LifecycleLockReleaseNonce := '';
  LifecycleFinalizationAttemptId := '';
  LifecycleFinalizationAttemptSequence := 0;
  LifecycleInstallerStateDirectory := '';
  LifecycleLockBootstrapDirectory := '';
  LifecycleLockBootstrapFilesStaged := False;
  LifecycleLockHolderStarted := False;
  LifecycleLockHolderActive := False;
  if not PrepareUninstallLifecycleLockHolderScript() then
  begin
    Log('Uninstall lifecycle bootstrap failed; public code TBX-UNINSTALL-LOCK.');
    MsgBox(TicketboxUninstallLockPublicMessage(), mbError, MB_OK);
    exit;
  end;
  Result := AcquireLifecycleLock();
  if not Result then
  begin
    Log('Uninstall lifecycle lock acquisition failed; public code TBX-UNINSTALL-LOCK.');
    MsgBox(TicketboxUninstallLockPublicMessage(), mbError, MB_OK);
    ReleaseLifecycleLock();
    exit;
  end;
  if not StartManagerMaintenanceGate() then
  begin
    MsgBox(
      '无法建立小票夹管理器维护门，卸载尚未修改服务、程序或数据。' +
      '请关闭其他小票夹安装器或管理器后重试。支持代码：TBX-UNINSTALL-LOCK',
      mbError,
      MB_OK);
    CloseManagerMaintenanceGate();
    ReleaseLifecycleLock();
    exit;
  end;
  Result := True;
end;

procedure DeinitializeUninstall();
begin
  ReleaseLifecycleLock();
  CloseManagerMaintenanceGate();
end;

function IsSupportedPowerShell7Host(PowerShellPath: String): Boolean;
var
  ResultCode: Integer;
  CommandText: String;
begin
  if not FileExists(PowerShellPath) then
  begin
    Result := False;
    exit;
  end;
  CommandText :=
    'if (($PSVersionTable.PSEdition -ceq ''Core'') -and ' +
    '([int]$PSVersionTable.PSVersion.Major -ge 7) -and ' +
    '[Environment]::Is64BitProcess) { exit 0 } else { exit 1 }';
  if not Exec(
    PowerShellPath,
    '-NoLogo -NoProfile -NonInteractive -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function IsProtectedProgramFilesPath(Value: String): Boolean;
var
  CanonicalValue: String;
  ProgramFilesRoot: String;
  ProgramFilesX86Root: String;
begin
  CanonicalValue := Uppercase(ExpandFileName(Value));
  ProgramFilesRoot := Uppercase(AddBackslash(ExpandFileName(ExpandConstant('{commonpf64}'))));
  ProgramFilesX86Root := Uppercase(AddBackslash(ExpandFileName(ExpandConstant('{commonpf32}'))));
  Result :=
    (Copy(CanonicalValue, 1, Length(ProgramFilesRoot)) = ProgramFilesRoot) or
    (Copy(CanonicalValue, 1, Length(ProgramFilesX86Root)) = ProgramFilesX86Root);
end;

function HasValidMicrosoftSignature(PowerShellPath: String): Boolean;
var
  ResultCode: Integer;
  CommandText: String;
  EscapedPath: String;
begin
  EscapedPath := PowerShellPath;
  StringChangeEx(EscapedPath, '''', '''''', True);
  CommandText :=
    '$s=Get-AuthenticodeSignature -LiteralPath ''' + EscapedPath + '''; ' +
    'if ($s.Status -eq ''Valid'' -and $s.SignerCertificate.Subject -match ''Microsoft Corporation'') ' +
    '{ exit 0 } else { exit 1 }';
  if not Exec(
    WindowsPowerShellExecutable(),
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ' + Quote(CommandText),
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode) then
  begin
    Result := False;
    exit;
  end;
  Result := ResultCode = 0;
end;

function FindMachinePowerShell7(): String;
var
  VersionKeys: TArrayOfString;
  Index: Integer;
  InstallLocation: String;
  Candidate: String;
  VersionKey: String;
begin
  Result := '';
  if not RegGetSubkeyNames(
    HKLM64,
    'SOFTWARE\Microsoft\PowerShellCore\InstalledVersions',
    VersionKeys) then
  begin
    exit;
  end;
  for Index := 0 to GetArrayLength(VersionKeys) - 1 do
  begin
    VersionKey := 'SOFTWARE\Microsoft\PowerShellCore\InstalledVersions\' + VersionKeys[Index];
    if RegQueryStringValue(HKLM64, VersionKey, 'InstallLocation', InstallLocation) then
    begin
      Candidate := AddBackslash(InstallLocation) + 'pwsh.exe';
      if
        FileExists(Candidate) and
        IsProtectedProgramFilesPath(Candidate) and
        HasValidMicrosoftSignature(Candidate) and
        IsSupportedPowerShell7Host(Candidate) and
        ((Result = '') or (CompareText(ExpandFileName(Candidate), ExpandFileName(Result)) < 0)) then
      begin
        Result := Candidate;
      end;
    end;
  end;
end;

function PowerShellExecutable(): String;
var
  PowerShell7: String;
begin
  if SelectedPowerShellPath <> '' then
  begin
    Result := SelectedPowerShellPath;
    exit;
  end;
  PowerShell7 := FindMachinePowerShell7();
  if PowerShell7 <> '' then
  begin
    SelectedPowerShellPath := PowerShell7;
  end
  else
  begin
    SelectedPowerShellPath := WindowsPowerShellExecutable();
  end;
  Result := SelectedPowerShellPath;
end;

function PowerShellContextChinese(Context: String): String;
begin
  if CompareText(Context, 'Ticketbox pre-upgrade backup and service preparation') = 0 then
  begin
    Result := '升级前备份与服务检查';
  end
  else if CompareText(Context, 'Ticketbox service installation') = 0 then
  begin
    Result := '安装并验证小票夹服务';
  end
  else if CompareText(Context, 'Ticketbox program-files copy boundary') = 0 then
  begin
    Result := '持久化程序文件复制边界';
  end
  else if CompareText(Context, 'Ticketbox installer lifecycle commit') = 0 then
  begin
    Result := '提交安装生命周期';
  end
  else if CompareText(Context, 'Ticketbox failed-install recovery') = 0 then
  begin
    Result := '安装失败后的自动恢复';
  end
  else if CompareText(Context, 'Ticketbox service uninstall') = 0 then
  begin
    Result := '卸载并验证小票夹服务';
  end
  else if CompareText(Context, 'Ticketbox owner bootstrap handoff completion') = 0 then
  begin
    Result := '确认并清理首次绑定凭据';
  end
  else if CompareText(Context, 'Ticketbox DataRoot guard control recovery') = 0 then
  begin
    Result := '确认 DataRoot guard 启动失败已释放全部权威';
  end
  else
  begin
    Result := '安装子步骤（' + Context + '）';
  end;
end;

function IsC07FailureSummaryLowerToken(Value: String; MaximumLength: Integer): Boolean;
var
  Index: Integer;
begin
  Result := (Length(Value) >= 1) and (Length(Value) <= MaximumLength);
  if not Result then
  begin
    exit;
  end;
  for Index := 1 to Length(Value) do
  begin
    if not (((Value[Index] >= 'a') and (Value[Index] <= 'z')) or
            ((Value[Index] >= '0') and (Value[Index] <= '9')) or
            (Value[Index] = '_')) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function IsC07FailureSummaryOperationId(Value: String): Boolean;
var
  Index: Integer;
begin
  Result := Length(Value) = 36;
  if not Result then
  begin
    exit;
  end;
  for Index := 1 to Length(Value) do
  begin
    if (Index = 9) or (Index = 14) or (Index = 19) or (Index = 24) then
    begin
      if Value[Index] <> '-' then
      begin
        Result := False;
        exit;
      end;
    end
    else if not (((Value[Index] >= '0') and (Value[Index] <= '9')) or
                 ((Value[Index] >= 'a') and (Value[Index] <= 'f'))) then
    begin
      Result := False;
      exit;
    end;
  end;
  Result := Result and (Value <> '00000000-0000-0000-0000-000000000000');
end;

function ReadC07FailureSummaryField(
  Line: String;
  FieldName: String;
  var Value: String
): Boolean;
var
  Prefix: String;
begin
  Prefix := FieldName + '=';
  Result := Pos(Prefix, Line) = 1;
  if not Result then
  begin
    Value := '';
    exit;
  end;
  Value := Copy(Line, Length(Prefix) + 1, Length(Line));
  Result := (Value <> '') and (Pos('=', Value) = 0);
  if not Result then
  begin
    Value := '';
  end;
end;

function IsC07FailureSummaryOrderedStage(Stage: String): Boolean;
begin
  Result :=
    (Stage = 'captured') or
    (Stage = 'writers_frozen') or
    (Stage = 'recovery_generation_ready') or
    (Stage = 'isolated_restore_verified') or
    (Stage = 'ddl_started') or
    (Stage = 'target_committed') or
    (Stage = 'target_recovery_generation_ready') or
    (Stage = 'target_isolated_restore_verified') or
    (Stage = 'runtime_acl_verified') or
    (Stage = 'ready');
end;

function C07FailureSummaryStageFieldsValid(
  LastDurableStage: String;
  RevisionState: String;
  RecoveryPoint: String;
  NoReturnCrossed: String;
  DdlState: String;
  DataState: String;
  Blocked: Boolean
): Boolean;
var
  ExpectedRevisionState: String;
  ExpectedRecoveryPoint: String;
  ExpectedNoReturnCrossed: String;
  ExpectedDdlState: String;
  ExpectedDataState: String;
begin
  ExpectedRevisionState := '';
  ExpectedRecoveryPoint := '';
  ExpectedNoReturnCrossed := '';
  ExpectedDdlState := '';
  ExpectedDataState := '';
  if (LastDurableStage = 'captured') or
     (LastDurableStage = 'writers_frozen') then
  begin
    ExpectedRevisionState := 'source';
    ExpectedRecoveryPoint := 'none';
    ExpectedNoReturnCrossed := 'false';
    ExpectedDdlState := 'not_started';
    ExpectedDataState := 'source_unchanged_writer_stopped';
  end
  else if LastDurableStage = 'recovery_generation_ready' then
  begin
    ExpectedRevisionState := 'source';
    ExpectedRecoveryPoint := 'source_generation_unverified';
    ExpectedNoReturnCrossed := 'false';
    ExpectedDdlState := 'not_started';
    ExpectedDataState := 'source_unchanged_writer_stopped';
  end
  else if LastDurableStage = 'isolated_restore_verified' then
  begin
    ExpectedRevisionState := 'source';
    ExpectedRecoveryPoint := 'source_restore_verified';
    ExpectedNoReturnCrossed := 'false';
    ExpectedDdlState := 'not_started';
    ExpectedDataState := 'source_unchanged_writer_stopped';
  end
  else if LastDurableStage = 'ddl_started' then
  begin
    ExpectedRevisionState := 'unknown_source_or_target';
    ExpectedRecoveryPoint := 'source_restore_verified';
    ExpectedNoReturnCrossed := 'true';
    ExpectedDdlState := 'execution_started_commit_unknown';
    ExpectedDataState := 'revision_unknown_writer_stopped';
  end
  else if LastDurableStage = 'target_committed' then
  begin
    ExpectedRevisionState := 'target';
    ExpectedRecoveryPoint := 'source_restore_verified';
    ExpectedNoReturnCrossed := 'true';
    ExpectedDdlState := 'target_committed';
    ExpectedDataState := 'target_committed_writer_stopped';
  end
  else if LastDurableStage = 'target_recovery_generation_ready' then
  begin
    ExpectedRevisionState := 'target';
    ExpectedRecoveryPoint := 'target_generation_unverified';
    ExpectedNoReturnCrossed := 'true';
    ExpectedDdlState := 'target_committed';
    ExpectedDataState := 'target_committed_writer_stopped';
  end
  else if (LastDurableStage = 'target_isolated_restore_verified') or
          (LastDurableStage = 'runtime_acl_verified') or
          (LastDurableStage = 'ready') then
  begin
    ExpectedRevisionState := 'target';
    ExpectedRecoveryPoint := 'target_restore_verified';
    ExpectedNoReturnCrossed := 'true';
    ExpectedDdlState := 'target_committed';
    ExpectedDataState := 'target_committed_writer_stopped';
  end;
  Result :=
    (ExpectedRevisionState <> '') and
    (RevisionState = ExpectedRevisionState) and
    (RecoveryPoint = ExpectedRecoveryPoint) and
    (NoReturnCrossed = ExpectedNoReturnCrossed) and
    (DdlState = ExpectedDdlState);
  if not Result then
  begin
    exit;
  end;
  if Blocked then
  begin
    Result := DataState = 'authority_or_writer_state_unverified';
  end
  else
  begin
    Result := DataState = ExpectedDataState;
  end;
end;

function C07FailureSummaryReleaseAllowsRetry(
  ExpectedOwnerPid: String;
  ExpectedOwnerStartedHigh: String;
  ExpectedOwnerStartedLow: String;
  ExpectedOperationId: String;
  ExpectedFinalizationAttemptId: String
): Boolean;
var
  VetoPath: String;
  VetoSize: Integer;
  Lines: TArrayOfString;
  Schema: String;
  OwnerPid: String;
  OwnerStartedHigh: String;
  OwnerStartedLow: String;
  OperationId: String;
  FinalizationAttemptId: String;
  State: String;
begin
  Result := False;
  VetoPath := LifecycleInstallerStatePath(C07LifecycleExitVetoFileName);
  if (not FileSize(VetoPath, VetoSize)) or
     (VetoSize < 1) or
     (VetoSize > C07LifecycleExitVetoMaximumBytes) or
     (not LoadStringsFromFile(VetoPath, Lines)) or
     (GetArrayLength(Lines) <> 7) then
  begin
    exit;
  end;
  if (not ReadC07FailureSummaryField(Lines[0], 'SCHEMA', Schema)) or
     (not ReadC07FailureSummaryField(
       Lines[1],
       'INSTALLER_OWNER_PID',
       OwnerPid)) or
     (not ReadC07FailureSummaryField(
       Lines[2],
       'INSTALLER_OWNER_STARTED_FILETIME_HIGH',
       OwnerStartedHigh)) or
     (not ReadC07FailureSummaryField(
       Lines[3],
       'INSTALLER_OWNER_STARTED_FILETIME_LOW',
       OwnerStartedLow)) or
     (not ReadC07FailureSummaryField(
       Lines[4],
       'OPERATION_ID',
       OperationId)) or
     (not ReadC07FailureSummaryField(
       Lines[5],
       'FINALIZATION_ATTEMPT_ID',
       FinalizationAttemptId)) or
     (not ReadC07FailureSummaryField(Lines[6], 'STATE', State)) then
  begin
    exit;
  end;
  Result :=
    (Schema = C07LifecycleExitVetoSchema) and
    (OwnerPid = ExpectedOwnerPid) and
    (OwnerStartedHigh = ExpectedOwnerStartedHigh) and
    (OwnerStartedLow = ExpectedOwnerStartedLow) and
    (OperationId = ExpectedOperationId) and
    (FinalizationAttemptId = ExpectedFinalizationAttemptId) and
    IsC07FailureSummaryOperationId(OperationId) and
    IsC07FailureSummaryOperationId(FinalizationAttemptId) and
    (State = 'lock_release_completed');
end;

function TryLoadC07FailureSummary(var MessageText: String): Boolean;
var
  SummaryPath: String;
  SummarySize: Integer;
  Lines: TArrayOfString;
  Schema: String;
  OwnerPid: String;
  OwnerStartedHigh: String;
  OwnerStartedLow: String;
  OperationId: String;
  FinalizationAttemptId: String;
  SourceRevision: String;
  TargetRevision: String;
  LifecycleStage: String;
  LastDurableStage: String;
  FailureCode: String;
  RevisionState: String;
  RecoveryPoint: String;
  RetryPolicy: String;
  NoReturnCrossed: String;
  DdlState: String;
  DataState: String;
  NextAction: String;
  Blocked: Boolean;
  RevisionText: String;
  RecoveryText: String;
  DdlText: String;
  ActionText: String;
begin
  Result := False;
  MessageText := '';
  if LifecycleInstallerStateDirectory = '' then
  begin
    exit;
  end;
  SummaryPath := LifecycleInstallerStatePath(C07FailureSummaryFileName);
  if (not FileSize(SummaryPath, SummarySize)) or
     (SummarySize < 1) or
     (SummarySize > C07FailureSummaryMaximumBytes) or
     (not LoadStringsFromFile(SummaryPath, Lines)) or
     (GetArrayLength(Lines) <> 18) then
  begin
    exit;
  end;
  if (not ReadC07FailureSummaryField(Lines[0], 'SCHEMA', Schema)) or
     (not ReadC07FailureSummaryField(Lines[1], 'INSTALLER_OWNER_PID', OwnerPid)) or
     (not ReadC07FailureSummaryField(
       Lines[2],
       'INSTALLER_OWNER_STARTED_FILETIME_HIGH',
       OwnerStartedHigh)) or
     (not ReadC07FailureSummaryField(
       Lines[3],
       'INSTALLER_OWNER_STARTED_FILETIME_LOW',
       OwnerStartedLow)) or
     (not ReadC07FailureSummaryField(Lines[4], 'OPERATION_ID', OperationId)) or
     (not ReadC07FailureSummaryField(
       Lines[5],
       'FINALIZATION_ATTEMPT_ID',
       FinalizationAttemptId)) or
     (not ReadC07FailureSummaryField(Lines[6], 'SOURCE_REVISION', SourceRevision)) or
     (not ReadC07FailureSummaryField(Lines[7], 'TARGET_REVISION', TargetRevision)) or
     (not ReadC07FailureSummaryField(Lines[8], 'LIFECYCLE_STAGE', LifecycleStage)) or
     (not ReadC07FailureSummaryField(
       Lines[9],
       'LAST_DURABLE_STAGE',
       LastDurableStage)) or
     (not ReadC07FailureSummaryField(Lines[10], 'FAILURE_CODE', FailureCode)) or
     (not ReadC07FailureSummaryField(Lines[11], 'REVISION_STATE', RevisionState)) or
     (not ReadC07FailureSummaryField(Lines[12], 'RECOVERY_POINT', RecoveryPoint)) or
     (not ReadC07FailureSummaryField(Lines[13], 'RETRY_POLICY', RetryPolicy)) or
     (not ReadC07FailureSummaryField(
       Lines[14],
       'NO_RETURN_CROSSED',
       NoReturnCrossed)) or
     (not ReadC07FailureSummaryField(Lines[15], 'DDL_STATE', DdlState)) or
     (not ReadC07FailureSummaryField(Lines[16], 'DATA_STATE', DataState)) or
     (not ReadC07FailureSummaryField(Lines[17], 'NEXT_ACTION', NextAction)) then
  begin
    exit;
  end;
  if (Schema <> C07FailureSummarySchema) or
     (OwnerPid <> IntToStr(LifecycleLockOwnerProcessId)) or
     (OwnerStartedHigh <> LifecycleLockOwnerStartedFileTimeHigh) or
     (OwnerStartedLow <> LifecycleLockOwnerStartedFileTimeLow) or
     (not IsC07FailureSummaryOperationId(OperationId)) or
     (not IsC07FailureSummaryOperationId(FinalizationAttemptId)) or
     (FinalizationAttemptId <> LifecycleFinalizationAttemptId) or
     (SourceRevision <> '20260722_0001') or
     (TargetRevision <> '20260729_0001') or
     (not IsC07FailureSummaryLowerToken(FailureCode, 64)) or
     (not IsC07FailureSummaryOrderedStage(LastDurableStage)) or
     ((LifecycleStage <> 'refused_pre_ddl') and
      (LifecycleStage <> 'repair_required') and
      (not IsC07FailureSummaryOrderedStage(LifecycleStage))) then
  begin
    exit;
  end;
  if ((LifecycleStage = 'refused_pre_ddl') or
      (LifecycleStage = 'repair_required')) then
  begin
    if LastDurableStage = 'ready' then
    begin
      exit;
    end;
  end
  else if LifecycleStage <> LastDurableStage then
  begin
    exit;
  end;
  Blocked := RetryPolicy = 'blocked';
  if not C07FailureSummaryStageFieldsValid(
    LastDurableStage,
    RevisionState,
    RecoveryPoint,
    NoReturnCrossed,
    DdlState,
    DataState,
    Blocked) then
  begin
    exit;
  end;
  if Blocked then
  begin
    if NextAction <> 'keep_services_stopped_contact_support' then
    begin
      exit;
    end;
  end
  else if LifecycleStage = 'refused_pre_ddl' then
  begin
    if (RetryPolicy <> 'successor_pre_ddl') or
       (NextAction <> 'rerun_setup_successor') then
    begin
      exit;
    end;
  end
  else if LifecycleStage = 'repair_required' then
  begin
    if (RetryPolicy <> 'successor_forward_repair') or
       (NextAction <> 'install_compatible_repair_build') then
    begin
      exit;
    end;
  end
  else if (RetryPolicy <> 'resume_same_operation') or
          (NextAction <> 'rerun_setup_resume') then
  begin
    exit;
  end;

  { A retryable summary is never sufficient by itself.  Missing, malformed,
    tampered, pending, stale-owner, stale-operation, or stale-finalization
    veto state takes precedence and converts the owner message to fail-closed
    guidance. }
  if (not Blocked) and
     (not C07FailureSummaryReleaseAllowsRetry(
       OwnerPid,
       OwnerStartedHigh,
       OwnerStartedLow,
       OperationId,
       LifecycleFinalizationAttemptId)) then
  begin
    MessageText :=
      '小票夹数据库维护后的生命周期锁释放状态无法确认。' + #13#10 +
      '受保护的 release veto 仍为 pending、缺失或校验失败；安装器不会采用可能过期的重试摘要。' + #13#10 +
      '请保持服务停止，不修改数据库或安装标记；保存日志并联系支持。';
    Result := True;
    exit;
  end;

  if RevisionState = 'source' then
  begin
    RevisionText := '数据库仍为升级前 revision ' + SourceRevision + '。';
  end
  else if RevisionState = 'target' then
  begin
    RevisionText := '数据库已提交目标 revision ' + TargetRevision + '。';
  end
  else
  begin
    RevisionText := '数据库 revision 可能仍为源版本，也可能已提交目标版本；安装器不会猜测。';
  end;
  if RecoveryPoint = 'none' then
  begin
    RecoveryText := '尚未生成恢复点，数据库写入尚未开始。';
  end
  else if RecoveryPoint = 'source_generation_unverified' then
  begin
    RecoveryText := '源版本恢复材料已生成，但隔离恢复验证尚未完成。';
  end
  else if RecoveryPoint = 'source_restore_verified' then
  begin
    RecoveryText := '升级前恢复点已通过隔离恢复验证。';
  end
  else if RecoveryPoint = 'target_generation_unverified' then
  begin
    RecoveryText := '目标版本恢复材料已生成，但隔离恢复验证尚未完成。';
  end
  else
  begin
    RecoveryText := '目标版本恢复点已通过隔离恢复验证。';
  end;
  if DdlState = 'not_started' then
  begin
    DdlText := '本轮未开始 DDL。';
  end
  else if DdlState = 'execution_started_commit_unknown' then
  begin
    DdlText := 'DDL 已开始，但仅凭回执无法证明事务是否提交；按已越过 no-return 边界处理。';
  end
  else
  begin
    DdlText := '目标 DDL 已提交，已越过 no-return 边界。';
  end;
  if NextAction = 'rerun_setup_resume' then
  begin
    ActionText :=
      '唯一下一步：关闭本向导后，使用同一版本或更新版本安装包重新运行修复；安装器将续跑同一操作。';
  end
  else if NextAction = 'rerun_setup_successor' then
  begin
    ActionText :=
      '唯一下一步：使用同一版本或更新版本安装包重新运行修复；它会建立后继操作，旧失败终态不会被改写。';
  end
  else if NextAction = 'install_compatible_repair_build' then
  begin
    ActionText :=
      '唯一下一步：保持服务停止，使用同版或更新的兼容修复安装包前滚。不要安装旧版本，也不要只恢复旧 EXE。';
  end
  else
  begin
    ActionText :=
      '唯一下一步：保持服务停止，不修改数据库或安装标记；保存日志并联系支持。';
  end;
  MessageText :=
    '小票夹数据库维护未完成。' + #13#10 +
    RevisionText + #13#10 +
    DdlText + #13#10 +
    RecoveryText + #13#10 +
    '阶段：' + LifecycleStage + '（最后持久阶段：' + LastDurableStage + '）' + #13#10 +
    '故障代码：' + FailureCode + #13#10 +
    '操作 ID：' + OperationId + #13#10 +
    ActionText;
  Result := True;
end;

function TryLoadInstallPublicFailure(var MessageText: String): Boolean;
var
  ReceiptPath: String;
  ReceiptSize: Integer;
  Lines: TArrayOfString;
  Schema: String;
  OwnerPid: String;
  OwnerStartedHigh: String;
  OwnerStartedLow: String;
  FinalizationAttemptId: String;
  InstallationOperationId: String;
  InstallationIdState: String;
  InstallationId: String;
  LifecycleStage: String;
  Context: String;
  FailureCode: String;
  RetryClass: String;
  DatabaseMutationState: String;
  SupportCode: String;
  ProtectedLogPath: String;
  PublicReceiptPath: String;
  ExpectedLogDirectory: String;
  InstallationIdentityText: String;
begin
  Result := False;
  MessageText := '';
  if (LifecycleLockBootstrapDirectory = '') or
     (LifecycleFinalizationAttemptId = '') then
  begin
    exit;
  end;
  ReceiptPath := LifecycleBootstrapFilePath(InstallPublicFailureFileName);
  if (not FileSize(ReceiptPath, ReceiptSize)) or
     (ReceiptSize < 1) or
     (ReceiptSize > InstallPublicFailureMaximumBytes) or
     (not LoadStringsFromFile(ReceiptPath, Lines)) or
     (GetArrayLength(Lines) <> 16) then
  begin
    exit;
  end;
  if (not ReadC07FailureSummaryField(Lines[0], 'SCHEMA', Schema)) or
     (not ReadC07FailureSummaryField(
       Lines[1],
       'INSTALLER_OWNER_PID',
       OwnerPid)) or
     (not ReadC07FailureSummaryField(
       Lines[2],
       'INSTALLER_OWNER_STARTED_FILETIME_HIGH',
       OwnerStartedHigh)) or
     (not ReadC07FailureSummaryField(
       Lines[3],
       'INSTALLER_OWNER_STARTED_FILETIME_LOW',
       OwnerStartedLow)) or
     (not ReadC07FailureSummaryField(
       Lines[4],
       'FINALIZATION_ATTEMPT_ID',
       FinalizationAttemptId)) or
     (not ReadC07FailureSummaryField(
       Lines[5],
       'INSTALLATION_OPERATION_ID',
       InstallationOperationId)) or
     (not ReadC07FailureSummaryField(
       Lines[6],
       'INSTALLATION_ID_STATE',
       InstallationIdState)) or
     (not ReadC07FailureSummaryField(
       Lines[7],
       'INSTALLATION_ID',
       InstallationId)) or
     (not ReadC07FailureSummaryField(
       Lines[8],
       'LIFECYCLE_STAGE',
       LifecycleStage)) or
     (not ReadC07FailureSummaryField(Lines[9], 'CONTEXT', Context)) or
     (not ReadC07FailureSummaryField(Lines[10], 'FAILURE_CODE', FailureCode)) or
     (not ReadC07FailureSummaryField(
       Lines[11],
       'RETRY_CLASS',
       RetryClass)) or
     (not ReadC07FailureSummaryField(
       Lines[12],
       'DATABASE_MUTATION_STATE',
       DatabaseMutationState)) or
     (not ReadC07FailureSummaryField(Lines[13], 'SUPPORT_CODE', SupportCode)) or
     (not ReadC07FailureSummaryField(
       Lines[14],
       'PROTECTED_LOG_PATH',
       ProtectedLogPath)) or
     (not ReadC07FailureSummaryField(
       Lines[15],
       'PUBLIC_RECEIPT_PATH',
       PublicReceiptPath)) then
  begin
    exit;
  end;
  ExpectedLogDirectory := RemoveBackslashUnlessRoot(
    ExpandConstant('{commoncf64}\Ticketbox\installer-logs'));
  if (Schema <> InstallPublicFailureSchema) or
     (OwnerPid <> IntToStr(LifecycleLockOwnerProcessId)) or
     (OwnerStartedHigh <> LifecycleLockOwnerStartedFileTimeHigh) or
     (OwnerStartedLow <> LifecycleLockOwnerStartedFileTimeLow) or
     (FinalizationAttemptId <> LifecycleFinalizationAttemptId) or
     (not IsC07FailureSummaryOperationId(FinalizationAttemptId)) or
     (not IsC07FailureSummaryOperationId(InstallationOperationId)) or
     (((InstallationIdState <> 'not_assigned') and
       (InstallationIdState <> 'assigned'))) or
     ((InstallationIdState = 'not_assigned') and
      (InstallationId <> '')) or
     ((InstallationIdState = 'assigned') and
      (not IsC07FailureSummaryOperationId(InstallationId))) or
     (not IsC07FailureSummaryLowerToken(LifecycleStage, 64)) or
     (Context <> 'service_installation') or
     ((RetryClass <> 'replace_package_then_retry_no_cleanup') and
      (RetryClass <> 'retry_same_operation_no_cleanup') and
      (RetryClass <> 'retry_no_cleanup') and
      (RetryClass <> 'manual_review_preserve_state')) or
     ((DatabaseMutationState <> 'not_started') and
      (DatabaseMutationState <> 'started_or_possible')) or
     (CompareText(PublicReceiptPath, ReceiptPath) <> 0) or
     (CompareText(ExtractFileDir(ProtectedLogPath), ExpectedLogDirectory) <> 0) or
     (not FileExists(ProtectedLogPath)) then
  begin
    exit;
  end;
  if FailureCode = 'backend_payload_manifest_order_invalid' then
  begin
    if (InstallationIdState <> 'not_assigned') or
       (DatabaseMutationState <> 'not_started') or
       (RetryClass <> 'replace_package_then_retry_no_cleanup') or
       (SupportCode <> 'TBX-INSTALL-PROVENANCE-ORDER') then
    begin
      exit;
    end;
    MessageText :=
      '安装包自检未通过。' + #13#10 +
      '程序文件已复制，但安装包内部构建清单不一致；安装器已在数据库迁移开始前停止。' + #13#10 +
      '这不是账本数据损坏。请保留数据目录，获取修复版安装包后重新运行。' + #13#10 +
      '支持代码：' + SupportCode;
  end
  else if FailureCode = 'postgres_cluster_initialization_failed' then
  begin
    if (InstallationIdState <> 'assigned') or
       (DatabaseMutationState <> 'started_or_possible') or
       (RetryClass <> 'retry_no_cleanup') or
       (SupportCode <> 'TBX-INSTALL-INITDB') then
    begin
      exit;
    end;
    MessageText :=
      '本机 PostgreSQL 数据簇初始化未完成。' + #13#10 +
      '安装器已停止服务并保留受保护的恢复状态；请勿手动删除数据库或安装标记。' + #13#10 +
      '请确认安装目标卷可写、没有安全软件拦截后，使用同一可信安装包重新运行。' + #13#10 +
      '支持代码：' + SupportCode;
  end
  else if FailureCode = 'postgres_host_authority_validation_failed' then
  begin
    if (RetryClass <> 'retry_no_cleanup') or
       (SupportCode <> 'TBX-INSTALL-POSTGRES-HOST') then
    begin
      exit;
    end;
    MessageText :=
      '本机 PostgreSQL 服务宿主身份校验未通过。' + #13#10 +
      '安装器检测到 SCM 命令、运行目录绑定或 postmaster 进程凭据与受管安装合同不一致，因此已停止继续。' + #13#10 +
      '请勿手动删除数据库或安装标记；保存日志，并使用同版或更新的可信安装包安全重试。' + #13#10 +
      '支持代码：' + SupportCode;
  end
  else if FailureCode = 'installation_identity_recovery_failed' then
  begin
    if (InstallationIdState <> 'not_assigned') or
       (RetryClass <> 'retry_same_operation_no_cleanup') or
       (SupportCode <> 'TBX-INSTALL-IDENTITY') then
    begin
      exit;
    end;
    MessageText :=
      '上次中断留下的安装身份无法安全接续。' + #13#10 +
      '安装器未能同时证明身份文件、数据库前置状态和当前安装包完全匹配，因此已保持服务停止。' + #13#10 +
      '请保留数据目录和安装标记，使用同一可信安装包重新运行；若仍出现此代码，请保存日志并联系支持。' + #13#10 +
      '支持代码：' + SupportCode;
  end
  else if FailureCode = 'installation_owner_binding_failed' then
  begin
    if (InstallationIdState <> 'assigned') or
       (RetryClass <> 'retry_same_operation_no_cleanup') or
       (SupportCode <> 'TBX-INSTALL-OWNER-BINDING') then
    begin
      exit;
    end;
    MessageText :=
      '本机服务已启动，但首次用户绑定事务未能安全完成。' + #13#10 +
      '安装器已保留同一个 installation operation，并停止本轮交付；不会创建第二套用户身份或长期安装器凭据。' + #13#10 +
      '请保留安装状态和日志，重新运行同一版或更新的可信安装包。' + #13#10 +
      '支持代码：' + SupportCode;
  end
  else if FailureCode = 'unclassified_service_install_failure' then
  begin
    if (RetryClass <> 'manual_review_preserve_state') or
       (SupportCode <> 'TBX-INSTALL-UNKNOWN') then
    begin
      exit;
    end;
    if DatabaseMutationState = 'not_started' then
    begin
      MessageText :=
        '小票夹服务初始化前检查未通过，数据库迁移尚未开始。' + #13#10 +
        '请保留数据目录并使用修复版安装包重试；不要手动删除数据库或安装标记。' + #13#10 +
        '支持代码：' + SupportCode;
    end
    else
    begin
      MessageText :=
        '小票夹服务初始化未完成，公开回执无法单独证明数据库最终状态。' + #13#10 +
        '请保持服务停止，不要修改数据库或安装标记；保存日志并联系支持。' + #13#10 +
        '支持代码：' + SupportCode;
    end;
  end
  else
  begin
    exit;
  end;
  if InstallationIdState = 'assigned' then
  begin
    InstallationIdentityText := 'installation ID：' + InstallationId;
  end
  else
  begin
    InstallationIdentityText := 'installation ID：尚未分配';
  end;
  MessageText :=
    MessageText + #13#10 +
    '安装 operation：' + InstallationOperationId + #13#10 +
    InstallationIdentityText + #13#10 +
    '生命周期阶段：' + LifecycleStage + #13#10 +
    '重试分类：' + RetryClass + #13#10 +
    '受保护日志：' + ProtectedLogPath;
  Result := True;
end;

function C07ServiceInstallationFailureMessage(): String;
begin
  if TryLoadC07FailureSummary(Result) then
  begin
  end
  else if TryLoadInstallPublicFailure(Result) then
  begin
  end
  else
  begin
    Result :=
      '小票夹服务安装失败，且安全回执缺失、过期或校验失败。' + #13#10 +
      '安装器无法安全判断失败发生在数据库维护前还是维护中，因此不会猜测当前状态。' + #13#10 +
      '请保持服务停止，不要修改数据库或 recovery 标记；保存日志并联系支持。';
  end;
end;

function PrepareProtectedInstallerLog(Context: String; var LogPath: String): Boolean;
var
  LogDirectory: String;
  LogName: String;
  LogHeader: TArrayOfString;
begin
  Result := False;
  LogPath := '';
  if (LifecycleLockOwnerProcessId = 0) or
     (Context = '') or
     (Pos(#13, Context) <> 0) or
     (Pos(#10, Context) <> 0) then
  begin
    exit;
  end;
  LogDirectory := ExpandConstant('{commoncf64}\Ticketbox\installer-logs');
  if (not ForceDirectories(LogDirectory)) or
     (not HardenLifecycleLockPath(LogDirectory, True)) then
  begin
    exit;
  end;
  InstallerLogSequence := InstallerLogSequence + 1;
  LogName :=
    'installer-' + GetDateTimeString('yyyymmdd-hhnnss', #0, #0) + '-' +
    IntToStr(GetCurrentProcessId()) + '-' + IntToStr(InstallerLogSequence) + '.log';
  LogPath := AddBackslash(LogDirectory) + LogName;
  SetArrayLength(LogHeader, 4);
  LogHeader[0] := 'SCHEMA=ticketbox-installer-child-log-v1';
  LogHeader[1] := 'INSTALLER_OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId);
  LogHeader[2] := 'LOG_SEQUENCE=' + IntToStr(InstallerLogSequence);
  LogHeader[3] := 'CONTEXT=' + Context;
  if (not SaveStringsToUTF8File(LogPath, LogHeader, False)) or
     (not HardenLifecycleLockPath(LogPath, False)) then
  begin
    DeleteFile(LogPath);
    LogPath := '';
    exit;
  end;
  Result := True;
end;

function EnsureLoggedPowerShellRunner(
  var RunnerPath: String;
  var RunnerSha256: String
): Boolean;
var
  RunnerText: String;
begin
  Result := False;
  RunnerSha256 := '';
  if LifecycleLockBootstrapDirectory = '' then
  begin
    exit;
  end;
  RunnerPath :=
    AddBackslash(LifecycleLockBootstrapDirectory) +
    'ticketbox-run-installer-child-logged.ps1';
  RunnerText :=
    '#Requires -Version 5.1' + #13#10 +
    '[CmdletBinding()]' + #13#10 +
    'param(' + #13#10 +
    '    [Parameter(Mandatory=$true)][string]$TargetScript,' + #13#10 +
    '    [Parameter(Mandatory=$true)][string]$LogPath,' + #13#10 +
    '    [Parameter(ValueFromRemainingArguments=$true)][string[]]$TargetArguments' + #13#10 +
    ')' + #13#10 +
    '$ErrorActionPreference = "Stop"' + #13#10 +
    '$exitCode = 0' + #13#10 +
    '$transcriptStarted = $false' + #13#10 +
    'try {' + #13#10 +
    '    Start-Transcript -LiteralPath $LogPath -Append -Force | Out-Null' + #13#10 +
    '    $transcriptStarted = $true' + #13#10 +
    '    $command = Get-Command -Name $TargetScript -CommandType ExternalScript -ErrorAction Stop' + #13#10 +
    '    if ([IO.Path]::GetFullPath($command.Source) -ine [IO.Path]::GetFullPath($TargetScript)) { throw "Child script resolution mismatch." }' + #13#10 +
    '    $scriptName = [IO.Path]::GetFileName($command.Source)' + #13#10 +
    '    $allowedByScript = @{' + #13#10 +
    '        "install_windows_prerequisites.ps1" = @("VcRedistPath","RequiredVersion","RequiredSha256","DiagnosticLogPath","InstallerLockOwnerProcessId")' + #13#10 +
    '        "hold_data_root_mutation_guard.ps1" = @("InstallDir","DataRoot","InstallerLockOwnerProcessId","Hold","ConfirmStopped","DataRootGuardReadyPath","DataRootGuardReleasePath","ExpectedHolderProcessId","ExpectedHolderStartedFileTimeHigh","ExpectedHolderStartedFileTimeLow","ExpectedNonce")' + #13#10 +
    '        "prepare_bundled_upgrade.ps1" = @("InstallDir","DataRoot","PgPort","BackendPort","TargetPgMajor","TargetBackendVersion","ReleaseConfigPath","InstalledReleaseConfigPath","LifecycleReceiptPath","InstallerLockOwnerProcessId","CommitCompletedInstall","MarkProgramFilesInstalledBackupPending","RecoverPreparedInstall","FilesReplaced","PersistDatabaseGenerationIntentOnly","DatabaseGenerationProgramPath","DatabaseGenerationProgramSha256","DatabaseGenerationMigrationHelperSize","DatabaseGenerationMigrationHelperSha256","DatabaseGenerationPgDumpSize","DatabaseGenerationPgDumpSha256","DatabaseGenerationPgRestoreSize","DatabaseGenerationPgRestoreSha256")' + #13#10 +
    '        "install_bundled_services.ps1" = @("InstallDir","DataRoot","PgPort","BackendPort","TargetPgMajor","TargetBackendVersion","LifecycleReceiptPath","InstallerLockOwnerProcessId","LifecycleFinalizationAttemptId","PublicFailurePath","DiagnosticLogPath","CompleteOwnerHandoffOnly")' + #13#10 +
    '        "uninstall_bundled_services.ps1" = @("InstallDir","InstallerLockOwnerProcessId","DeleteData")' + #13#10 +
    '    }' + #13#10 +
    '    if (-not $allowedByScript.ContainsKey($scriptName)) { throw "Installer child script is not allowlisted: $scriptName" }' + #13#10 +
    '    $allowed = @{}' + #13#10 +
    '    foreach ($allowedName in $allowedByScript[$scriptName]) { $allowed[$allowedName] = $true }' + #13#10 +
    '    $bound = @{}' + #13#10 +
    '    for ($index = 0; $index -lt $TargetArguments.Count; $index++) {' + #13#10 +
    '        $token = $TargetArguments[$index]' + #13#10 +
    '        if (-not $token.StartsWith("-") -or $token.Length -lt 2) { throw "Unexpected child argument: $token" }' + #13#10 +
    '        $name = $token.Substring(1)' + #13#10 +
    '        if (-not $allowed.ContainsKey($name)) { throw "Child parameter is not allowlisted: $token" }' + #13#10 +
    '        if ($bound.ContainsKey($name)) { throw "Duplicate child parameter: $token" }' + #13#10 +
    '        if (-not $command.Parameters.ContainsKey($name)) { throw "Unknown child parameter: $token" }' + #13#10 +
    '        $metadata = $command.Parameters[$name]' + #13#10 +
    '        if ($metadata.ParameterType -eq [System.Management.Automation.SwitchParameter]) {' + #13#10 +
    '            $bound[$name] = $true' + #13#10 +
    '        } else {' + #13#10 +
    '            $index++' + #13#10 +
    '            if ($index -ge $TargetArguments.Count) { throw "Missing value for child parameter: $token" }' + #13#10 +
    '            $bound[$name] = $TargetArguments[$index]' + #13#10 +
    '        }' + #13#10 +
    '    }' + #13#10 +
    '    $global:LASTEXITCODE = 0' + #13#10 +
    '    & $TargetScript @bound' + #13#10 +
    '    if ($LASTEXITCODE -ne 0) { $exitCode = $LASTEXITCODE }' + #13#10 +
    '} catch {' + #13#10 +
    '    $exitCode = 1' + #13#10 +
    '    Write-Host ("ERROR: " + $_.Exception.Message)' + #13#10 +
    '    if ($_.ScriptStackTrace) { Write-Host $_.ScriptStackTrace }' + #13#10 +
    '} finally {' + #13#10 +
    '    if ($transcriptStarted) { try { Stop-Transcript | Out-Null } catch { } }' + #13#10 +
    '}' + #13#10 +
    'exit $exitCode' + #13#10;
  DeleteFile(RunnerPath);
  if (not SaveStringToFile(RunnerPath, RunnerText, False)) or
     (not HardenLifecycleLockPath(RunnerPath, False)) then
  begin
    DeleteFile(RunnerPath);
    exit;
  end;
  try
    RunnerSha256 := Lowercase(GetSHA256OfFile(RunnerPath));
  except
    RunnerSha256 := '';
  end;
  Result := RunnerSha256 <> '';
end;

function ValidateLoggedPowerShellRunner(
  RunnerPath: String;
  ExpectedSha256: String
): Boolean;
var
  ActualSha256: String;
begin
  Result := False;
  if (ExpectedSha256 = '') or (not FileExists(RunnerPath)) then
  begin
    exit;
  end;
  try
    ActualSha256 := Lowercase(GetSHA256OfFile(RunnerPath));
  except
    exit;
  end;
  Result := CompareText(ActualSha256, ExpectedSha256) = 0;
end;

function RunPowerShellChecked(ScriptPath: String; Arguments: String; Context: String): Boolean;
var
  ResultCode: Integer;
  Params: String;
  PowerShellPath: String;
  Started: Boolean;
  LogPath: String;
  RunnerPath: String;
  RunnerSha256: String;
  ChineseContext: String;
  PrerequisiteLogPath: String;
  IsPrerequisiteStep: Boolean;
  IsServiceInstallationStep: Boolean;
begin
  ChineseContext := PowerShellContextChinese(Context);
  LastPowerShellChildSucceeded := False;
  LastPowerShellFailureMessage := '';
  LastPowerShellRestartRequired := False;
  IsPrerequisiteStep :=
    CompareText(Context, 'Ticketbox Windows prerequisite installation') = 0;
  IsServiceInstallationStep :=
    CompareText(Context, 'Ticketbox service installation') = 0;
  PrerequisiteLogPath := '';
  if not PrepareProtectedInstallerLog(Context, LogPath) then
  begin
    LastPowerShellFailureMessage :=
      '无法建立受保护的安装诊断记录，子步骤未执行。支持代码：TBX-INSTALL-LOG';
    Result := False;
    exit;
  end;
  if IsPrerequisiteStep then
  begin
    PrerequisiteLogPath := LogPath + '.vc-redist.log';
    Arguments :=
      Arguments + ' -DiagnosticLogPath ' + Quote(PrerequisiteLogPath);
  end;
  if IsServiceInstallationStep then
  begin
    Arguments := Arguments + ' -DiagnosticLogPath ' + Quote(LogPath);
  end;
  if not EnsureLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
  begin
    LastPowerShellFailureMessage :=
      '无法建立受验证的安装执行器，子步骤未执行。支持代码：TBX-INSTALL-RUNNER';
    Result := False;
    exit;
  end;
  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + Quote(RunnerPath) +
    ' -TargetScript ' + Quote(ScriptPath) +
    ' -LogPath ' + Quote(LogPath) + ' ' + Arguments;
  PowerShellPath := PowerShellExecutable();
  if not ValidateLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
  begin
    LastPowerShellFailureMessage :=
      '安装执行器完整性复核失败，子步骤未执行。支持代码：TBX-INSTALL-RUNNER';
    Result := False;
    exit;
  end;
  Started := Exec(PowerShellPath, Params, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  if (not Started) and (CompareText(PowerShellPath, WindowsPowerShellExecutable()) <> 0) then
  begin
    if not ValidateLoggedPowerShellRunner(RunnerPath, RunnerSha256) then
    begin
      LastPowerShellFailureMessage :=
        '安装执行器兼容复核失败，子步骤未执行。支持代码：TBX-INSTALL-RUNNER';
      Result := False;
      exit;
    end;
    SelectedPowerShellPath := WindowsPowerShellExecutable();
    Log('Selected PowerShell 7 host could not start; pinned Windows PowerShell for the remaining transaction.');
    Started := Exec(
      SelectedPowerShellPath,
      Params,
      '',
      SW_HIDE,
      ewWaitUntilTerminated,
      ResultCode);
  end;
  DeleteFile(RunnerPath);
  if not Started then
  begin
    LastPowerShellFailureMessage :=
      'Windows 无法启动受验证的安装子步骤。支持代码：TBX-INSTALL-POWERSHELL';
    Result := False;
    exit;
  end;

  LastPowerShellChildSucceeded := ResultCode = 0;
  LastPowerShellRestartRequired :=
    IsPrerequisiteStep and ((ResultCode = 1641) or (ResultCode = 3010));

  if not HardenLifecycleLockPath(LogPath, False) then
  begin
    LastPowerShellFailureMessage :=
      '安装子步骤已结束，但诊断记录保护状态不可验证。支持代码：TBX-INSTALL-LOG-ACL';
    Result := False;
    exit;
  end;
  if IsPrerequisiteStep and FileExists(PrerequisiteLogPath) and
     (not HardenLifecycleLockPath(PrerequisiteLogPath, False)) then
  begin
    LastPowerShellFailureMessage :=
      'Windows 前置条件已执行，但 Microsoft 诊断日志保护状态不可验证。' +
      '支持代码：TBX-INSTALL-LOG-ACL';
    Result := False;
    exit;
  end;

  if ResultCode <> 0 then
  begin
    if IsPrerequisiteStep then
    begin
      if LastPowerShellRestartRequired then
      begin
        LastPowerShellFailureMessage :=
          'Microsoft Visual C++ 运行库已请求重新启动 Windows。' + #13#10 +
          '小票夹程序文件、服务、数据库和安装身份尚未变更。' + #13#10 +
          '请重新启动 Windows 后，再运行同一个可信安装包。' + #13#10 +
          '支持代码：TBX-INSTALL-PREREQ-RESTART';
      end
      else
      begin
        LastPowerShellFailureMessage :=
          'Microsoft Visual C++ 运行库前置条件未能建立。' + #13#10 +
          '小票夹程序文件、服务、数据库和安装身份尚未变更。' + #13#10 +
          '请保留受保护安装日志，修复 Windows 运行库后安全重试。' + #13#10 +
          '支持代码：TBX-INSTALL-PREREQ';
      end;
    end
    else if CompareText(Context, 'Ticketbox service installation') = 0 then
    begin
      LastPowerShellFailureMessage := C07ServiceInstallationFailureMessage();
    end
    else if CompareText(
      Context,
      'Ticketbox pre-upgrade backup and service preparation') = 0 then
    begin
      LastPowerShellFailureMessage :=
        '安装准备未完成，新程序文件尚未复制。为保护已有数据，安装器已停止。' +
        '请勿手工修改数据目录；关闭占用后重新运行同一可信安装包。' +
        '支持代码：TBX-PREP-FAILED';
    end
    else if CompareText(Context, 'Ticketbox program-files copy boundary') = 0 then
    begin
      LastPowerShellFailureMessage :=
        '程序文件复制边界未能安全持久化，安装交付已停止。支持代码：TBX-INSTALL-COPY';
    end
    else if CompareText(Context, 'Ticketbox installer lifecycle commit') = 0 then
    begin
      LastPowerShellFailureMessage :=
        '服务初始化已返回，但安装生命周期提交未通过验证。支持代码：TBX-INSTALL-COMMIT';
    end
    else if CompareText(Context, 'Ticketbox owner bootstrap handoff completion') = 0 then
    begin
      LastPowerShellFailureMessage :=
        '首次连接信息的安全清理未完成；一次性信息仍受保护。支持代码：TBX-INSTALL-HANDOFF';
    end
    else
    begin
      LastPowerShellFailureMessage :=
        '安装子步骤未完成。操作：' + ChineseContext +
        '。支持代码：TBX-INSTALL-CHILD';
    end;
    Result := False;
    exit;
  end;

  if CompareText(Context, 'Ticketbox service installation') = 0 then
  begin
    if not RegWriteStringValue(
      HKLM64,
      'Software\Ticketbox',
      'BackendVersion',
      '{#AppVersion}') then
    begin
      LastPowerShellFailureMessage :=
        '服务已初始化，但无法建立机器级防降级版本下限，安装交付已停止。' +
        '支持代码：TBX-INSTALL-VERSION-FLOOR';
      Result := False;
      exit;
    end;
  end;

  Result := True;
end;

procedure ResetDataRootMutationGuardState();
begin
  if (DataRootGuardProcessHandle <> 0) and
     (DataRootGuardProcessHandle <> InvalidHandleValue) then
  begin
    CloseHandle(DataRootGuardProcessHandle);
  end;
  DeleteFile(DataRootGuardReadyPath);
  DeleteFile(DataRootGuardReleasePath);
  DeleteFile(DataRootGuardReleasePath + '.tmp');
  DataRootGuardProcessHandle := InvalidHandleValue;
  DataRootGuardProcessId := 0;
  DataRootGuardProcessStartedFileTimeHigh := '';
  DataRootGuardProcessStartedFileTimeLow := '';
  DataRootGuardReleaseNonce := '';
  DataRootGuardScriptPath := '';
  DataRootGuardProcessStarted := False;
  DataRootGuardActive := False;
end;

function PersistDataRootGuardControl(ControlState: String): Boolean;
var
  ControlTempPath: String;
  ControlText: String;
begin
  Result := False;
  if (CompareText(ControlState, 'release') = 0) and
     (not IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce)) then
  begin
    exit;
  end;
  if (CompareText(ControlState, 'release') = 0) then
  begin
    ControlText :=
      'STATE=release' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'NONCE=' + DataRootGuardReleaseNonce + #13#10;
  end
  else if CompareText(ControlState, 'abort') = 0 then
  begin
    ControlText :=
      'STATE=abort' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  end
  else
  begin
    exit;
  end;
  ControlTempPath := DataRootGuardReleasePath + '.tmp';
  DeleteFile(ControlTempPath);
  if FileExists(DataRootGuardReleasePath) then
  begin
    exit;
  end;
  Result :=
    SaveStringToFile(ControlTempPath, ControlText, False) and
    HardenLifecycleLockPath(ControlTempPath, False) and
    RenameFile(ControlTempPath, DataRootGuardReleasePath);
  if not Result then
  begin
    DeleteFile(ControlTempPath);
  end;
end;

function DataRootGuardStoppedAcknowledged(): Boolean;
var
  AckText: AnsiString;
  ExpectedAck: String;
begin
  Result := False;
  if not FileExists(DataRootGuardReleasePath) then
  begin
    exit;
  end;
  if not LoadLifecycleCoordinationArtifact(
    DataRootGuardReleasePath,
    AckText) then
  begin
    exit;
  end;
  ExpectedAck :=
    'STATE=stopped' + #13#10 +
    'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10;
  Result := String(AckText) = ExpectedAck;
end;

function WaitForDataRootGuardStoppedAcknowledgement(): Boolean;
var
  Attempt: Integer;
begin
  Result := False;
  for Attempt := 1 to 100 do
  begin
    if DataRootGuardStoppedAcknowledged() then
    begin
      Result := True;
      exit;
    end;
    Sleep(100);
  end;
end;

function ConfirmDataRootGuardStoppedAfterControlFailure(): Boolean;
var
  Args: String;
begin
  Result := False;
  if (DataRootGuardScriptPath = '') or
     (DataRootGuardReadyPath = '') or
     (DataRootGuardReleasePath = '') then
  begin
    exit;
  end;
  if not ValidateLifecycleLockBootstrapFiles() then
  begin
    Log('DataRoot guard recovery refused a changed lifecycle bootstrap bundle.');
    exit;
  end;
  Args :=
    '-InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
    ' -ConfirmStopped' +
    ' -DataRootGuardReadyPath ' + Quote(DataRootGuardReadyPath) +
    ' -DataRootGuardReleasePath ' + Quote(DataRootGuardReleasePath);
  if (DataRootGuardProcessId > 0) and
     (DataRootGuardProcessStartedFileTimeHigh <> '') and
     (DataRootGuardProcessStartedFileTimeLow <> '') and
     IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce) then
  begin
    Args := Args +
      ' -ExpectedHolderProcessId ' + IntToStr(DataRootGuardProcessId) +
      ' -ExpectedHolderStartedFileTimeHigh ' + DataRootGuardProcessStartedFileTimeHigh +
      ' -ExpectedHolderStartedFileTimeLow ' + DataRootGuardProcessStartedFileTimeLow +
      ' -ExpectedNonce ' + DataRootGuardReleaseNonce;
  end;
  if not RunPowerShellChecked(
    DataRootGuardScriptPath,
    Args,
    'Ticketbox DataRoot guard control recovery') then
  begin
    exit;
  end;
  Result := DataRootGuardStoppedAcknowledged();
end;

function AbortDataRootMutationGuardStartup(): Boolean;
begin
  Result := False;
  if not DataRootGuardProcessStarted then
  begin
    Result := True;
    exit;
  end;
  if DataRootGuardStoppedAcknowledged() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  if not PersistDataRootGuardControl('abort') then
  begin
    if DataRootGuardStoppedAcknowledged() then
    begin
      ResetDataRootMutationGuardState();
      Result := True;
      exit;
    end;
    if ConfirmDataRootGuardStoppedAfterControlFailure() then
    begin
      ResetDataRootMutationGuardState();
      Result := True;
      exit;
    end;
    Log('Could not persist DataRoot guard startup abort; keeping local holder state fail closed.');
    exit;
  end;
  if WaitForDataRootGuardStoppedAcknowledgement() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  if ConfirmDataRootGuardStoppedAfterControlFailure() then
  begin
    ResetDataRootMutationGuardState();
    Result := True;
    exit;
  end;
  Log('DataRoot guard startup abort was not acknowledged and inactivity could not be proven; keeping local holder state fail closed.');
end;

function StartDataRootMutationGuard(
  ScriptPath: String;
  InstallDir: String;
  DataRoot: String
): Boolean;
var
  Params: String;
  PowerShellPath: String;
  ResultCode: Integer;
  Started: Boolean;
  Attempt: Integer;
  ReadyText: AnsiString;
  ReadyPrefix: String;
  ReadyRemainder: String;
  HolderIdentityRemainder: String;
  HolderStartedHighDelimiter: String;
  HolderStartedLowDelimiter: String;
  NonceDelimiter: String;
  HolderProcessIdText: String;
  HolderStartedFileTimeHighText: String;
  HolderStartedFileTimeLowText: String;
  HolderDelimiterPosition: Integer;
  NonceDelimiterPosition: Integer;
  ParsedHolderProcessId: Integer;
  ReadyValue: String;
  ExpectedReadyText: String;
begin
  Result := False;
  if DataRootGuardProcessStarted and
     (not AbortDataRootMutationGuardStartup()) then
  begin
    MsgBox('上一轮 DataRoot guard 尚未证明停止，拒绝在同一安装生命周期重复获取。', mbError, MB_OK);
    exit;
  end;
  DataRootGuardScriptPath := ScriptPath;
  DataRootGuardReadyPath :=
    ExpandConstant('{commoncf64}\Ticketbox\data-root-guard-') +
    IntToStr(LifecycleLockOwnerProcessId) + '.ready';
  DataRootGuardReleasePath :=
    ExpandConstant('{commoncf64}\Ticketbox\data-root-guard-') +
    IntToStr(LifecycleLockOwnerProcessId) + '.release';
  if FileExists(DataRootGuardReadyPath) or FileExists(DataRootGuardReleasePath) then
  begin
    MsgBox('检测到当前 PID 对应的过期 DataRoot guard artifact，已拒绝复用。', mbError, MB_OK);
    exit;
  end;

  Params :=
    '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + Quote(ScriptPath) +
    ' -InstallDir ' + Quote(InstallDir) +
    ' -DataRoot ' + Quote(DataRoot) +
    ' -InstallerLockOwnerProcessId ' + IntToStr(LifecycleLockOwnerProcessId) +
    ' -Hold' +
    ' -DataRootGuardReadyPath ' + Quote(DataRootGuardReadyPath) +
    ' -DataRootGuardReleasePath ' + Quote(DataRootGuardReleasePath);
  PowerShellPath := PowerShellExecutable();
  Started := Exec(PowerShellPath, Params, '', SW_HIDE, ewNoWait, ResultCode);
  if (not Started) and (CompareText(PowerShellPath, WindowsPowerShellExecutable()) <> 0) then
  begin
    SelectedPowerShellPath := WindowsPowerShellExecutable();
    Log('Selected PowerShell 7 host could not start the DataRoot guard; pinned Windows PowerShell for the remaining transaction.');
    Started := Exec(
      SelectedPowerShellPath,
      Params,
      '',
      SW_HIDE,
      ewNoWait,
      ResultCode);
  end;
  if not Started then
  begin
    MsgBox('无法启动持续 DataRoot guard 进程，安装尚未进入复制前阶段。', mbError, MB_OK);
    exit;
  end;

  DataRootGuardProcessStarted := True;
  try
    ReadyPrefix :=
      'STATE=holding' + #13#10 +
      'OWNER_PID=' + IntToStr(LifecycleLockOwnerProcessId) + #13#10 +
      'HOLDER_PID=';
    HolderStartedHighDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_HIGH=';
    HolderStartedLowDelimiter := #13#10 + 'HOLDER_STARTED_FILETIME_LOW=';
    NonceDelimiter := #13#10 + 'NONCE=';
    for Attempt := 1 to 300 do
    begin
      if FileExists(DataRootGuardReadyPath) then
      begin
        if not LoadLifecycleCoordinationArtifact(
          DataRootGuardReadyPath,
          ReadyText) then
        begin
          MsgBox('无法读取 DataRoot guard ready artifact。', mbError, MB_OK);
          exit;
        end;
        ReadyValue := String(ReadyText);
        if Copy(ReadyValue, 1, Length(ReadyPrefix)) <> ReadyPrefix then
        begin
          MsgBox('DataRoot guard ready artifact 与当前安装器身份不匹配。', mbError, MB_OK);
          exit;
        end;
        ReadyRemainder := Copy(
          ReadyValue,
          Length(ReadyPrefix) + 1,
          Length(ReadyValue));
        HolderDelimiterPosition := Pos(HolderStartedHighDelimiter, ReadyRemainder);
        if HolderDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder PID。', mbError, MB_OK);
          exit;
        end;
        HolderProcessIdText := Copy(
          ReadyRemainder,
          1,
          HolderDelimiterPosition - 1);
        ParsedHolderProcessId := StrToIntDef(HolderProcessIdText, 0);
        if (ParsedHolderProcessId <= 0) or
           (IntToStr(ParsedHolderProcessId) <> HolderProcessIdText) then
        begin
          MsgBox('DataRoot guard ready artifact 的 holder PID 无效。', mbError, MB_OK);
          exit;
        end;
        HolderIdentityRemainder := Copy(
          ReadyRemainder,
          HolderDelimiterPosition + Length(HolderStartedHighDelimiter),
          Length(ReadyRemainder));
        NonceDelimiterPosition := Pos(HolderStartedLowDelimiter, HolderIdentityRemainder);
        if NonceDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder 创建时间高位。', mbError, MB_OK);
          exit;
        end;
        HolderStartedFileTimeHighText := Copy(
          HolderIdentityRemainder,
          1,
          NonceDelimiterPosition - 1);
        HolderIdentityRemainder := Copy(
          HolderIdentityRemainder,
          NonceDelimiterPosition + Length(HolderStartedLowDelimiter),
          Length(HolderIdentityRemainder));
        NonceDelimiterPosition := Pos(NonceDelimiter, HolderIdentityRemainder);
        if NonceDelimiterPosition <= 1 then
        begin
          MsgBox('DataRoot guard ready artifact 缺少 holder 创建时间低位。', mbError, MB_OK);
          exit;
        end;
        HolderStartedFileTimeLowText := Copy(
          HolderIdentityRemainder,
          1,
          NonceDelimiterPosition - 1);
        DataRootGuardReleaseNonce := Copy(
          HolderIdentityRemainder,
          NonceDelimiterPosition + Length(NonceDelimiter),
          64);
        ExpectedReadyText :=
          ReadyPrefix + HolderProcessIdText + HolderStartedHighDelimiter +
          HolderStartedFileTimeHighText + HolderStartedLowDelimiter +
          HolderStartedFileTimeLowText + NonceDelimiter +
          DataRootGuardReleaseNonce + #13#10;
        if (ReadyValue <> ExpectedReadyText) or
           (not IsLowerHexLifecycleNonce(DataRootGuardReleaseNonce)) then
        begin
          DataRootGuardReleaseNonce := '';
          MsgBox('DataRoot guard ready artifact 的随机挑战无效。', mbError, MB_OK);
          exit;
        end;
        DataRootGuardProcessId := LongWord(ParsedHolderProcessId);
        DataRootGuardProcessStartedFileTimeHigh := HolderStartedFileTimeHighText;
        DataRootGuardProcessStartedFileTimeLow := HolderStartedFileTimeLowText;
        DataRootGuardProcessHandle := OpenVerifiedProcessIdentityHandle(
          DataRootGuardProcessId,
          HolderStartedFileTimeHighText,
          HolderStartedFileTimeLowText);
        if not IsProcessHandleRunning(DataRootGuardProcessHandle) then
        begin
          MsgBox(
            'DataRoot guard 的 PID/创建时间与 ready artifact 不匹配或进程已退出。',
            mbError,
            MB_OK);
          exit;
        end;
        DataRootGuardActive := True;
        Result := True;
        exit;
      end;
      Sleep(100);
    end;
    MsgBox('DataRoot guard 未在 30 秒内就绪，安装尚未进入复制前阶段。', mbError, MB_OK);
  finally
    if (not Result) and (not AbortDataRootMutationGuardStartup()) then
    begin
      Log('DataRoot guard startup could not be rolled back in-process; retry remains blocked until Setup exits.');
    end;
  end;
end;

procedure AssertDataRootMutationGuardActive();
begin
  if (not DataRootGuardActive) or
     (not IsProcessHandleRunning(DataRootGuardProcessHandle)) then
  begin
    RaiseException('DataRoot guard lease 未持续持有，拒绝继续安装生命周期 mutation。');
  end;
end;

procedure ReleaseDataRootMutationGuard();
begin
  if not DataRootGuardProcessStarted then
  begin
    exit;
  end;
  if not DataRootGuardActive then
  begin
    AbortDataRootMutationGuardStartup();
    exit;
  end;
  if DataRootGuardStoppedAcknowledged() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  if not PersistDataRootGuardControl('release') then
  begin
    if DataRootGuardStoppedAcknowledged() or
       ConfirmDataRootGuardStoppedAfterControlFailure() then
    begin
      ResetDataRootMutationGuardState();
      exit;
    end;
    Log('Could not persist the DataRoot guard release artifact; keeping local state fail closed.');
    exit;
  end;
  if WaitForDataRootGuardStoppedAcknowledgement() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  if ConfirmDataRootGuardStoppedAfterControlFailure() then
  begin
    ResetDataRootMutationGuardState();
    exit;
  end;
  Log('DataRoot guard release was not acknowledged and stopped authority could not be proven; keeping local state fail closed.');
end;
