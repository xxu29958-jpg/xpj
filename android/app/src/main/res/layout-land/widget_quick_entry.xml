<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_background" android:padding="4dp" android:clipToOutline="true">
    <TextView android:id="@+id/widget_manual" style="@style/WidgetAction"
        android:text="@string/shortcut_manual_short_label" android:drawableStart="@drawable/ic_lucide_receipt_text"
        android:background="@drawable/widget_primary_background" android:padding="4dp"
        android:textColor="@color/widget_on_primary" android:drawableTint="@color/widget_on_primary" />
    <TextView android:id="@+id/widget_upload" style="@style/WidgetAction" android:layout_marginStart="6dp" android:padding="4dp"
        android:text="@string/shortcut_upload_short_label" android:drawableStart="@drawable/ic_lucide_images" />
    <TextView android:id="@+id/widget_review" style="@style/WidgetAction" android:layout_marginStart="6dp" android:padding="4dp"
        android:text="@string/shortcut_review_short_label" android:drawableStart="@drawable/ic_lucide_inbox" />
</LinearLayout>
