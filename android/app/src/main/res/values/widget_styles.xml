<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:drawableTint">@color/widget_text</item>
        <item name="android:background">@drawable/widget_action_background</item>
        <item name="android:padding">6dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:tint">@color/widget_text</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
