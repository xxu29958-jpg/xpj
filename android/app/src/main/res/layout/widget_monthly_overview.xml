<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp" android:paddingBottom="10dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_ledger" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/widget_brand" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_refresh" style="@style/WidgetIconButton"
            android:src="@drawable/ic_lucide_refresh_cw" android:contentDescription="@string/widget_refresh" />
        <ImageButton android:id="@+id/widget_configure" style="@style/WidgetIconButton"
            android:src="@drawable/ic_lucide_sliders_horizontal" android:contentDescription="@string/widget_configure" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_overview_name" android:textSize="12sp" android:textColor="@color/widget_muted"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="40dp"
            android:text="@string/widget_amount_hidden" android:textColor="@color/widget_text"
            android:textSize="28sp" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="28sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_open_details" android:textSize="12sp" android:textColor="@color/widget_muted"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginVertical="4dp" android:text="@string/widget_configure_hint"
        android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
    <TextView android:id="@+id/widget_manual" style="@style/WidgetAction"
        android:text="@string/shortcut_manual_short_label" android:drawableTop="@drawable/ic_lucide_receipt_text"
        android:background="@drawable/widget_primary_background"
        android:textColor="@color/widget_on_primary" android:drawableTint="@color/widget_on_primary" />
    <TextView android:id="@+id/widget_upload" style="@style/WidgetAction" android:layout_marginStart="6dp"
        android:text="@string/shortcut_upload_short_label" android:drawableTop="@drawable/ic_lucide_images" />
    <TextView android:id="@+id/widget_review" style="@style/WidgetAction" android:layout_marginStart="6dp"
        android:text="@string/shortcut_review_short_label" android:drawableTop="@drawable/ic_lucide_inbox" />
</LinearLayout>
</LinearLayout>
