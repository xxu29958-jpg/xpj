<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:paddingHorizontal="14dp" android:paddingBottom="10dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_ledger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_sync_name" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_privacy" style="@style/WidgetIconButton" android:src="@drawable/ic_lucide_eye" android:contentDescription="@string/widget_reveal" />
        <ImageButton android:id="@+id/widget_refresh" style="@style/WidgetIconButton" android:src="@drawable/ic_lucide_refresh_cw" android:contentDescription="@string/widget_refresh" />
        <ImageButton android:id="@+id/widget_configure" style="@style/WidgetIconButton" android:src="@drawable/ic_lucide_sliders_horizontal" android:contentDescription="@string/widget_configure" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <LinearLayout android:id="@+id/widget_first" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_action_background" android:layout_marginHorizontal="2dp" android:padding="4dp">
            <TextView android:id="@+id/widget_first_count" android:layout_width="match_parent" android:layout_height="36dp" android:text="—" android:gravity="center" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="28sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" />
            <TextView android:id="@+id/widget_first_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_pending_upload" android:gravity="center" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_second" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_action_background" android:layout_marginHorizontal="2dp" android:padding="4dp">
            <TextView android:id="@+id/widget_second_count" android:layout_width="match_parent" android:layout_height="36dp" android:text="—" android:gravity="center" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="28sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" />
            <TextView android:id="@+id/widget_second_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_pending_record" android:gravity="center" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_third" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_action_background" android:layout_marginHorizontal="2dp" android:padding="4dp">
            <TextView android:id="@+id/widget_third_count" android:layout_width="match_parent" android:layout_height="36dp" android:text="—" android:gravity="center" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="28sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" />
            <TextView android:id="@+id/widget_third_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_failed" android:gravity="center" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_data_hidden" android:textColor="@color/widget_text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_configure_hint" android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
