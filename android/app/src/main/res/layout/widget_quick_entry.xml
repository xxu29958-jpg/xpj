<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="8dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <TextView android:id="@+id/widget_manual" style="@style/WidgetAction"
        android:text="@string/widget_manual_short" android:drawableTop="@drawable/ic_lucide_receipt_text"
        android:background="@drawable/widget_primary_background"
        android:textColor="@color/widget_on_primary" android:drawableTint="@color/widget_on_primary" />
    <TextView android:id="@+id/widget_upload" style="@style/WidgetAction" android:layout_marginStart="2dp"
        android:text="@string/widget_upload_short" android:drawableTop="@drawable/ic_lucide_images" />
    <TextView android:id="@+id/widget_review" style="@style/WidgetAction" android:layout_marginStart="2dp"
        android:text="@string/widget_review_short" android:drawableTop="@drawable/ic_lucide_inbox" />
    <TextView android:id="@+id/widget_camera" style="@style/WidgetAction" android:layout_marginStart="2dp" android:text="@string/widget_camera_short" android:drawableTop="@drawable/ic_lucide_camera" />
    <TextView android:id="@+id/widget_templates" style="@style/WidgetAction" android:layout_marginStart="2dp" android:text="@string/widget_templates_short" android:drawableTop="@drawable/ic_lucide_receipt_text" />
</LinearLayout>
</FrameLayout>
